'=====================================================================
' Script Library : BulkRegAgents            Version 4.0.1
' Purpose        : The code of the six BulkReg agents. Each agent in bulkreg.nsf
'                  only calls one Sub of this library:
'                    BulkReg\00 - Set Up Log Database            -> BR_RunSetupLog
'                    BulkReg\01 - Preflight Check                -> BR_RunPreflight
'                    BulkReg\02 - Build Batch                    -> BR_RunBuildBatch
'                    BulkReg\03 - Register Batch                 -> BR_RunRegisterBatch
'                    BulkReg\04 - Verify Registration and Vault  -> BR_RunVerify
'                    BulkReg\05 - Export to Registration Text File -> BR_RunExport
'                    BulkReg\06 - Install Welcome Page           -> BR_RunInstallWelcome (one time, design)
'                  So a new release only replaces the two libraries; the agents
'                  never have to be pasted again.
' Uses           : BulkRegCommon (create and save that library FIRST)
' Runs in        : HCL Domino Administrator client on WINDOWS only
'
' HOW TO INSTALL : Designer > Code > Script Libraries > New LotusScript Library,
'                  name it exactly "BulkRegAgents". Click in the editor, Ctrl+A, Delete,
'                  paste this WHOLE file, Ctrl+S. Designer puts (Options), (Declarations)
'                  and every Sub/Function in its place automatically.
'=====================================================================
'#####################################################################
' --- part 1: (Options) ---
'#####################################################################
Option Public
Option Declare
Use "BulkRegCommon"
'#####################################################################
' --- part 2: (Declarations) ---
'#####################################################################

' --- BR_RunRegisterBatch (gCertPwd, gPwFile, gMode, gSrvOK) and BR_RunVerify (gV... counters) ---
Dim gCertPwd As String
Dim gPwFile As String
Dim gMode As String
Dim gSrvOK List As String      ' home-server reachability cache
Dim gStopRun As String          ' set by BR_RegisterOne when the whole run must stop (e.g. wrong Notes name)
Dim gVNameBad As Long, gVTitleBad As Long, gVTitles List As String, gVAclBad As Long, gVAcls List As String
Dim gRtPlain As Boolean         ' welcome screens: True = plain fallback layout without tables
Dim gVUnreg As Long, gVInV As Long, gVNotV As Long, gVErr As Long, gVGone As Long, gVMailBad As Long, gVRepBad As Long

'#####################################################################
' --- part 3: Subs and Functions (Designer gives each its own entry) ---
'#####################################################################
'=====================================================================
' BR_RunPreflight  -  runs agent BulkReg\01 - Preflight Check
'   The agent itself only contains:  Call BR_RunPreflight()
'
' Checks environment + every DirSync candidate and writes
'   <AuditDir>\BulkReg_Preflight_<run>_audit.csv   (per-user status)
'   <AuditDir>\BulkReg_Preflight_<run>_debug.log
'   <AuditDir>\BulkReg_Preflight_<run>_mapping.txt      (users per mapping rule)
'   <AuditDir>\BulkReg_Preflight_<run>_mailfolders.txt  (folders to create, per server)
'=====================================================================
Sub BR_RunPreflight()
	On Error GoTo ErrH
	Dim db As NotesDatabase, col As NotesDocumentCollection, doc As NotesDocument
	Dim u As BRUser, issues As String, res As String
	Dim nOK As Long, nWarn As Long, nErr As Long, envErr As Long, envWarn As Long, nNoInet As Long
	Dim seenShort List As String, seenMail List As String
	Dim servers List As String, usersView As NotesView, dupCol As NotesDocumentCollection
	Dim t0 As Double, srvCount List As Long, hk As String, srvText As String
	Dim ruleCount List As Long, mapFile As String, ri As Integer, rk As String
	Dim rl As Variant, rj As Integer, repCount List As Long
	' batch segregation: Preflight plans ALL candidates but checks ONE batch in detail
	Dim batchSize As Long, chkBatch As Long, scopeAll As Boolean, srvFilter As String, openIds List As String
	Dim nElig As Long, nChecked As Long, nInOpen As Long, nOtherSrv As Long, nBatches As Long, bNo As Long, nNoCap As Long, nBuilt As Long
	Dim planBatch List As Long, loadBefore List As Long, planFile As String, homeIssue As String, planLine As String
	Dim mfNames List As String, mfCounts List As Long, mfScanned List As String

	If Not BR_Init("Preflight") Then Exit Sub
	batchSize = CfgL("BatchSize", 1000)
	If batchSize < 1 Then batchSize = 1000
	scopeAll = (UCase$(Trim$(CfgS("PreflightScope", "ALL"))) = "ALL")
	chkBatch = CfgL("PreflightBatchNo", 1)
	If chkBatch < 1 Then chkBatch = 1
	srvFilter = Trim$(CfgS("BatchServerFilter", ""))

	' ---------- 1. Environment checks ----------
	BR_Log LVL_INFO, "--- Environment checks ---"
	envErr = envErr + BR_Check(CfgS("RegistrationServer", "") <> "", "RegistrationServer configured")
	envErr = envErr + BR_Check(BR_ServerReachable(CfgS("RegistrationServer", "")), "Registration server reachable: " & CfgS("RegistrationServer", ""))
	envErr = envErr + BR_Check(BR_DirWritable(BR_CfgDir("IDFileDir", "ids")), "IDFileDir exists + writable: " & BR_CfgDir("IDFileDir", "ids"))
	If CfgB("WritePasswordFile", True) Then
		envErr = envErr + BR_Check(BR_DirWritable(BR_CfgDir("PasswordDir", "secure")), "PasswordDir exists + writable: " & BR_CfgDir("PasswordDir", "secure"))
	End If
	If CfgB("UseCA", True) Then
		envErr = envErr + BR_Check(CfgS("CertifierName", "") <> "", "CertifierName set (UseCA=1): " & CfgS("CertifierName", "") & "  -> passed to registration as " & BR_CertifierForReg())
		BR_Log LVL_INFO, "Users will be named  <First Last>" & BR_ExpectedSuffix(CfgS("DefaultOrgUnit", "")) & "   e.g. Neha Arora" & BR_ExpectedSuffix(CfgS("DefaultOrgUnit", "")) & "  (OrgUnit from the mapping is added before the organization)"
	Else
		envErr = envErr + BR_Check(Dir$(BR_CfgFile("CertifierIDFile", "cert" & gSep & "none.id")) <> "", "Certifier ID file exists: " & BR_CfgFile("CertifierIDFile", ""))
	End If
	If CfgS("VaultServer", "") <> "" Then
		envWarn = envWarn + BR_Check(BR_ServerReachable(CfgS("VaultServer", "")), "Vault server reachable: " & CfgS("VaultServer", ""))
	Else
		BR_Log LVL_WARN, "VaultServer not set - vault verification will be skipped"
		envWarn = envWarn + 1
	End If
	envErr = envErr + BR_Check(InStr(CfgS("DefaultOrgUnit", ""), "=") = 0 And InStr(CfgS("DefaultOrgUnit", ""), "/") = 0, "DefaultOrgUnit is empty or one plain OU name (not O=Demo / OU=Sales / Sales/Demo): '" & CfgS("DefaultOrgUnit", "") & "'")
	If CfgS("DefaultPolicy", "") = "" Then
		BR_Log LVL_WARN, "DefaultPolicy empty - make sure an explicit/organizational policy assigns the ID Vault"
		envWarn = envWarn + 1
	End If
	' mail cluster: every member must be reachable (replicas are created there by AdminP)
	If BR_SrvList(CfgS("MailClusterServers", ""), "") <> "" Then
		BR_Log LVL_INFO, "Mail cluster: " & BR_SrvList(CfgS("MailClusterServers", ""), "") & " | CreateClusterReplicas=" & CfgS("CreateClusterReplicas", "1")
		rl = Split(BR_SrvList(CfgS("MailClusterServers", ""), ""), ",")
		For rj = 0 To UBound(rl)
			envWarn = envWarn + BR_Check(BR_ServerReachable(CStr(rl(rj))), "Mail cluster member reachable: " & rl(rj))
		Next
		' AdminP "Check access": the requester (your admin ID) needs at least Reader access to each new mail file
		BR_Log LVL_INFO, "Mail file managers (Manager access in every new mail file, needed for the replica requests): " & BR_MailManagers()
		BR_Log LVL_INFO, "Mail file owner access: " & BR_LevelText(BR_OwnerLevel()) & " + Delete documents (MailOwnerAccess)"
	Else
		BR_Log LVL_INFO, "MailClusterServers empty - no mail cluster: mail files get no replicas unless a mapping rule lists ClusterReplicas"
	End If
	' home server pool: users are spread over these servers (AUTO in server_mapping.csv)
	If BR_HomePool() <> "" Then
		BR_Log LVL_INFO, "Home server pool: " & BR_HomePool() & " | max users per server " & CfgL("HomeServerMaxUsers", 0) & " | assignment " & UCase$(Trim$(CfgS("HomeServerAssignment", "BALANCED")))
		rl = Split(BR_HomePool(), ",")
		For rj = 0 To UBound(rl)
			envErr = envErr + BR_Check(BR_ServerReachable(CStr(rl(rj))), "Home server reachable: " & rl(rj))
		Next
	Else
		BR_Log LVL_INFO, "HomeServers not set - every user without a named server in the mapping goes to DefaultHomeServer " & CfgS("DefaultHomeServer", "") & " (all users on ONE server)"
		envWarn = envWarn + 1
	End If
	' platform (path form) of every server concerned: detected from the server, ServerOSMap, or ServerOS
	Dim osSrv As Variant, oj As Integer, osName As String, osSrc As String, osAll As String
	osAll = BR_SrvList(BR_HomePool() & "," & CfgS("MailClusterServers", "") & "," & BR_IIfStr(BR_HomePool() = "", CfgS("DefaultHomeServer", ""), ""), "")
	If osAll <> "" Then
		osSrv = Split(osAll, ",")
		For oj = 0 To UBound(osSrv)
			osName = BR_ServerOSEx(CStr(osSrv(oj)), osSrc)
			BR_Log LVL_INFO, "Server " & osSrv(oj) & ": " & osName & " (" & osSrc & ") - mail files are sent as " & BR_SrvPathFor(CStr(osSrv(oj)), "mail1\smith.nsf")
			If osSrc = "detected from the server" And osName <> UCase$(Trim$(CfgS("ServerOS", "LINUX"))) Then
				BR_Log LVL_WARN, "ServerOS=" & CfgS("ServerOS", "LINUX") & " in bulkreg.ini does not match " & osSrv(oj) & " - the detected " & osName & " is used for this server. Set ServerOS / ServerOSMap to match."
				envWarn = envWarn + 1
			End If
		Next
	End If
	' the mail template must exist on every home server (a wrong name stops the registration)
	If Trim$(CfgS("MailTemplate", "")) <> "" And osAll <> "" Then
		For oj = 0 To UBound(osSrv)
			envErr = envErr + BR_Check(BR_MailFileExists(CStr(osSrv(oj)), CfgS("MailTemplate", "")), "Mail template " & CfgS("MailTemplate", "") & " exists on " & osSrv(oj))
		Next
	End If
	BR_Log LVL_INFO, "Fallback platform ServerOS=" & UCase$(Trim$(CfgS("ServerOS", "LINUX"))) & " | ServerOSDetect=" & CfgS("ServerOSDetect", "1") & " | data directory " & CfgS("ServerDataDir", "/local/notesdata")
	BR_Log LVL_INFO, "Registration name: LastName = Person item " & CfgS("LastNameField", "LastName") & " + '" & CfgS("LastNameSeparator", "-") & "' + suffix from [" & CfgS("LastNameSuffixFields", "ShortName,sAMAccountName") & "] | uppercase=" & CfgS("LastNameUppercase", "1") & " | backup field=" & BR_IIfStr(Trim$(CfgS("LastNameBackupField", "Location")) = "", "(off)", CfgS("LastNameBackupField", "Location")) & " | FirstNameField=" & BR_IIfStr(Trim$(CfgS("FirstNameField", "")) = "", "(none)", CfgS("FirstNameField", "")) & " | MiddleNameField=" & BR_IIfStr(Trim$(CfgS("MiddleNameField", "")) = "", "(none)", CfgS("MiddleNameField", ""))
	If UCase$(Trim$(CfgS("HomeServerAssignment", "BALANCED"))) <> "BALANCED" And UCase$(Trim$(CfgS("HomeServerAssignment", "BALANCED"))) <> "FILL" And UCase$(Trim$(CfgS("HomeServerAssignment", "BALANCED"))) <> "FILLED" Then
		BR_Log LVL_WARN, "HomeServerAssignment=" & CfgS("HomeServerAssignment", "") & " is not BALANCED or FILL - BALANCED is used"
		envWarn = envWarn + 1
	End If
	BR_Log LVL_INFO, "Short name read from Person field(s): " & CfgS("ShortNameFields", "ShortName") & " | Internet address constructed as <shortname>@" & CfgS("InternetDomain", "(InternetDomain not set - addresses are NOT constructed)")
	If CfgB("ConstructInternetAddress", True) And Trim$(CfgS("InternetDomain", "")) = "" Then
		BR_Log LVL_WARN, "InternetDomain is empty - users without an Internet address in AD cannot get one constructed and will be " & BR_IIfStr(CfgB("SkipNoInternetAddress", True), "skipped", "registered without address")
		envWarn = envWarn + 1
	End If
	' tool database bulkreg.nsf: meant to be LOCAL on the admin workstation (guide B13)
	Dim toolDb As NotesDatabase
	Set toolDb = gSession.CurrentDatabase
	If Not (toolDb Is Nothing) Then
		If toolDb.Server = "" Then
			BR_Log LVL_INFO, "PASS  Tool database is local: " & toolDb.FilePath
		Else
			BR_Log LVL_WARN, "Tool database runs from server " & toolDb.Server & "!!" & toolDb.FilePath & " - BulkReg is designed for a LOCAL bulkreg.nsf (guide B13)"
			envWarn = envWarn + 1
		End If
	End If
	' central log database on the server: Author + Create documents; Editor/Delete weaken the audit trail (guide B15)
	Dim logDbObj As NotesDatabase, accLvl As Integer, accPriv As Long
	On Error Resume Next
	Set logDbObj = gSession.GetDatabase(CfgS("LogServer", ""), CfgS("LogDb", ""), False)
	If Not logDbObj.IsOpen Then Call logDbObj.Open("", "")     ' CurrentAccessLevel needs an open database
	accLvl = logDbObj.CurrentAccessLevel
	accPriv = logDbObj.QueryAccessPrivileges(gOperator)
	If Err <> 0 Then
		BR_Log LVL_WARN, "Could not read your access to the log database: " & Error$
		envWarn = envWarn + 1
		Err = 0
	Else
		BR_Log LVL_INFO, "Log database " & CfgS("LogServer", "") & "!!" & CfgS("LogDb", "") & ": your access level " & accLvl & " (3 = Author, 4 = Editor), privileges " & accPriv
		envErr = envErr + BR_Check(accLvl >= ACLLEVEL_AUTHOR And (accLvl > ACLLEVEL_AUTHOR Or (accPriv And DBACL_CREATE_DOCUMENTS) <> 0), "Log database: Author with Create documents (or higher)")
		If accLvl > ACLLEVEL_AUTHOR Or (accPriv And DBACL_DELETE_DOCUMENTS) <> 0 Then
			BR_Log LVL_WARN, "Log database: you have " & BR_IIf(accLvl > ACLLEVEL_AUTHOR, "Editor or higher", "Delete documents") & " access - for a tamper-resistant audit trail use Author, Create documents, without Delete documents (guide B15)"
			envWarn = envWarn + 1
		End If
	End If
	On Error GoTo ErrH
	' structured views of the log database (created by 00 - Set Up Log Database)
	If Not (gLogDb Is Nothing) Then
		If gLogDb.GetView("BulkReg\1. Runs - by date") Is Nothing Then
			BR_Log LVL_WARN, "The log database has no BulkReg views yet - ask its owner to run Actions > BulkReg > 00 - Set Up Log Database (guide B15)"
			envWarn = envWarn + 1
		Else
			BR_Log LVL_INFO, "PASS  Log database views present"
		End If
	End If
	If CfgB("DryRun", True) Then BR_Log LVL_INFO, "DryRun=1 (safe mode) is set"
	BR_Log LVL_INFO, "Client platform " & gPlatform & " | operator " & gOperator

	Set db = BR_OpenDirectory()
	Set usersView = db.GetView("($Users)")

	' ---------- 2. Candidate checks ----------
	' Every candidate is PLANNED (home server, batch number, mail folders), but only ONE batch is
	' checked in detail (reachability, duplicates, mail files): the batch Build Batch will create
	' next (PreflightBatchNo=1), or any other batch number, or ALL (PreflightScope=ALL).
	BR_Log LVL_INFO, "--- Candidate checks (objectGUID present, not yet registered) ---"
	BR_Log LVL_INFO, "BatchSize=" & batchSize & " | detailed check: " & BR_IIfStr(scopeAll, "ALL candidates (PreflightScope=ALL)", "batch no. " & chkBatch & " (users " & ((chkBatch - 1) * batchSize + 1) & " - " & (chkBatch * batchSize) & " of the candidate list)") & BR_IIfStr(srvFilter <> "", " | BatchServerFilter=" & srvFilter, "")
	Call BR_OpenBatchNoteIDs(openIds, mfNames, mfCounts)     ' users in OPEN batches are not candidates; they count towards server capacity
	Call BR_ScanDirectoryMail(db, mfNames)                   ' users already registered into the new mail folders count towards capacity
	ForAll ld In gSrvLoad
		loadBefore(ListTag(ld)) = ld
	End ForAll
	Set col = BR_GetCandidates(db, True)
	Set doc = col.GetFirstDocument()
	Do While Not (doc Is Nothing)
		t0 = Timer
		Call BR_ReadUser(doc, u)
		' ---- batch segregation (same order as 02 - Build Batch) ----
		If IsElement(openIds(u.NoteID)) Then
			nInOpen = nInOpen + 1                                 ' already in a pending batch
			GoTo NextCand
		End If
		If u.InternetAddress = "" And CfgB("SkipNoInternetAddress", True) Then
			nNoInet = nNoInet + 1                                 ' skipped by Build Batch: does not use a batch slot
			u.FullNameAfter = BR_ExpectedName(u)                      ' the Notes name the user will get (First Last/OU/Org)
			If scopeAll Or chkBatch = 1 Then Call BR_Audit(u, "PREFLIGHT", "CHECK", BR_RESULT_NO_INET, BR_Elapsed(t0), BR_SKIP_NO_INET)
			GoTo NextCand
		End If
		If u.InetSource = "CONSTRUCTED" Then nBuilt = nBuilt + 1
		homeIssue = BR_AssignHome(u)                              ' AUTO -> server of the pool (balanced, max HomeServerMaxUsers)
		If srvFilter <> "" And homeIssue = "" Then
			If Not BR_SameServer(u.HomeServer, srvFilter) Then
				nOtherSrv = nOtherSrv + 1                         ' belongs to another server wave
				GoTo NextCand
			End If
		End If
		nElig = nElig + 1
		If u.InternetAddress = "" Then nNoInet = nNoInet + 1      ' only when SkipNoInternetAddress=0 (registered without address)
		bNo = Int((nElig - 1) / batchSize) + 1                    ' batch number of this user
		hk = BR_IIfStr(u.HomeServer = "", "(none)", u.HomeServer)
		If IsElement(planBatch(CStr(bNo) & "|" & hk)) Then planBatch(CStr(bNo) & "|" & hk) = planBatch(CStr(bNo) & "|" & hk) + 1 Else planBatch(CStr(bNo) & "|" & hk) = 1
		If IsElement(srvCount(hk)) Then srvCount(hk) = srvCount(hk) + 1 Else srvCount(hk) = 1
		If IsElement(ruleCount(u.MapRule)) Then ruleCount(u.MapRule) = ruleCount(u.MapRule) + 1 Else ruleCount(u.MapRule) = 1
		If homeIssue <> "" Then nNoCap = nNoCap + 1
		hk = BR_IIf(u.HomeServer = "", "(none)", u.HomeServer) & " -> replicas: " & BR_IIf(u.ClusterReplicas = "", "none", u.ClusterReplicas)
		If IsElement(repCount(hk)) Then repCount(hk) = repCount(hk) + 1 Else repCount(hk) = 1
		If Not scopeAll And bNo <> chkBatch Then GoTo NextCand    ' planned only - no detailed check
		nChecked = nChecked + 1

		issues = homeIssue & BR_Validate(u)
		u.FullNameAfter = BR_ExpectedName(u)                          ' expected Notes name, e.g. Naman Kumar/Demo (CN built from the name fields in bulkreg.ini)

		' duplicates inside this batch
		If u.ShortName <> "" Then
			If IsElement(seenShort(LCase$(u.ShortName))) Then issues = issues & "ERROR:Duplicate ShortName in batch (" & seenShort(LCase$(u.ShortName)) & "); " Else seenShort(LCase$(u.ShortName)) = u.NoteID
		End If
		If u.InternetAddress <> "" Then
			If IsElement(seenMail(LCase$(u.InternetAddress))) Then issues = issues & "ERROR:Duplicate InternetAddress in batch; " Else seenMail(LCase$(u.InternetAddress)) = u.NoteID
			' duplicates against the whole directory
			If Not (usersView Is Nothing) Then
				Set dupCol = usersView.GetAllDocumentsByKey(u.InternetAddress, True)
				If dupCol.Count > 1 Then issues = issues & "WARN:InternetAddress used by " & dupCol.Count & " directory entries; "
			End If
		End If

		' home server reachability (checked once per server)
		If u.HomeServer <> "" Then
			If Not IsElement(servers(LCase$(u.HomeServer))) Then
				If BR_ServerReachable(u.HomeServer) Then servers(LCase$(u.HomeServer)) = "OK" Else servers(LCase$(u.HomeServer)) = "UNREACHABLE"
				BR_Log LVL_INFO, "Home server " & u.HomeServer & ": " & servers(LCase$(u.HomeServer))
			End If
			If servers(LCase$(u.HomeServer)) <> "OK" Then issues = issues & "ERROR:HomeServer unreachable; "
		End If
		' replica servers (other mail cluster members or the rule's list)
		If u.ClusterReplicas <> "" Then
			rl = Split(u.ClusterReplicas, ",")
			For rj = 0 To UBound(rl)
				If Not IsElement(servers(LCase$(CStr(rl(rj))))) Then
					If BR_ServerReachable(CStr(rl(rj))) Then servers(LCase$(CStr(rl(rj)))) = "OK" Else servers(LCase$(CStr(rl(rj)))) = "UNREACHABLE"
					BR_Log LVL_INFO, "Replica server " & rl(rj) & ": " & servers(LCase$(CStr(rl(rj))))
				End If
				If servers(LCase$(CStr(rl(rj)))) <> "OK" Then issues = issues & "WARN:Replica server " & rl(rj) & " unreachable; "
			Next
		End If
		If InStr(issues, "SKIP:") > 0 Then
			res = BR_RESULT_NO_INET              ' will be skipped by Build Batch (flagged, not an error)
		ElseIf InStr(issues, "ERROR:") > 0 Then
			res = "ERROR": nErr = nErr + 1
		ElseIf InStr(issues, "WARN:") > 0 Then
			res = "WARN": nWarn = nWarn + 1
		Else
			res = "OK": nOK = nOK + 1
		End If
		BR_Log LVL_DEBUG, res & " " & u.FullNameBefore & " => " & u.FullNameAfter & " -> " & u.HomeServer & " / OU=" & u.OrgUnit & " / " & u.Policy & " | " & issues
		Call BR_Audit(u, "PREFLIGHT", "CHECK", res, BR_Elapsed(t0), issues)
NextCand:
		Set doc = col.GetNextDocument(doc)
	Loop

	' ---------- mapping test: users per rule ----------
	mapFile = gRunDir & "BulkReg_Preflight_" & gRunID & "_mapping.txt"
	Call BR_AppendLine(mapFile, "BulkReg " & BR_VERSION & " - mapping test (which rule each candidate matched)")
	Call BR_AppendLine(mapFile, "Mapping file: " & BR_CfgFile("MappingFile", "config\server_mapping.csv"))
	Call BR_AppendLine(mapFile, "Rules are checked top-down; the first match wins. Per-user detail: MapRule column of " & gAuditFile)
	Call BR_AppendLine(mapFile, "")
	For ri = 0 To gMapCount - 1
		rk = "rule#" & (ri + 1) & " " & gMap(ri).MatchField & "=" & gMap(ri).MatchPattern
		If IsElement(ruleCount(rk)) Then
			Call BR_AppendLine(mapFile, "Rule " & (ri + 1) & " : " & ruleCount(rk) & " users  | IF " & gMap(ri).MatchField & " matches '" & gMap(ri).MatchPattern & "'")
		Else
			Call BR_AppendLine(mapFile, "Rule " & (ri + 1) & " : 0 users  | IF " & gMap(ri).MatchField & " matches '" & gMap(ri).MatchPattern & "'   <-- matched nobody: check field name and pattern")
		End If
		Call BR_AppendLine(mapFile, "          THEN HomeServer=" & BR_IIf(gMap(ri).HomeServer = "", "(default " & CfgS("DefaultHomeServer", "") & ")", gMap(ri).HomeServer) & _
		"  OrgUnit=" & BR_IIf(gMap(ri).OrgUnit = "", "(default)", gMap(ri).OrgUnit) & "  Policy=" & BR_IIf(gMap(ri).Policy = "", "(default)", gMap(ri).Policy) & _
		"  Groups=" & BR_IIf(gMap(ri).Groups = "", "(default)", gMap(ri).Groups) & "  VaultServer=" & BR_IIf(gMap(ri).VaultServer = "", "(default)", gMap(ri).VaultServer) & _
		"  ClusterReplicas=" & BR_IIf(gMap(ri).ClusterReplicas = "", "(auto: other mail cluster members)", BR_IIf(gMap(ri).ClusterReplicas = "-", "(none)", gMap(ri).ClusterReplicas)))
	Next
	If IsElement(ruleCount("defaults")) Then Call BR_AppendLine(mapFile, "No rule matched: " & ruleCount("defaults") & " users -> all defaults from bulkreg.ini")
	Call BR_AppendLine(mapFile, "")
	Call BR_AppendLine(mapFile, "Result per home server (users -> where the mail file replicas will be created):")
	ForAll rc In repCount
		Call BR_AppendLine(mapFile, "  " & ListTag(rc) & " : " & rc & " users")
	End ForAll

	' ---------- batch plan: how the candidates split into batches and home servers ----------
	nBatches = Int((nElig + batchSize - 1) / batchSize)
	planFile = gRunDir & "BulkReg_Preflight_" & gRunID & "_batchplan.txt"
	Call BR_AppendLine(planFile, "BulkReg " & BR_VERSION & " - batch plan (simulation: nothing has been built or registered)")
	Call BR_AppendLine(planFile, "Candidates (objectGUID, no Certificate)   : " & col.Count)
	Call BR_AppendLine(planFile, "  already in an OPEN batch (excluded)      : " & nInOpen)
	Call BR_AppendLine(planFile, "  no Internet address, skipped + flagged   : " & BR_IIfStr(CfgB("SkipNoInternetAddress", True), CStr(nNoInet), "0 (SkipNoInternetAddress=0)"))
	Call BR_AppendLine(planFile, "  other home server (BatchServerFilter)    : " & nOtherSrv)
	Call BR_AppendLine(planFile, "Users to register                         : " & nElig & "  ->  " & nBatches & " batch(es) of max " & batchSize)
	Call BR_AppendLine(planFile, "Internet address constructed (<shortname>@" & CfgS("InternetDomain", "?") & ") : " & nBuilt)
	Call BR_AppendLine(planFile, "Users without a free home server           : " & nNoCap & BR_IIfStr(nNoCap > 0, "   <-- raise HomeServerMaxUsers or add a server to HomeServers", ""))
	Call BR_AppendLine(planFile, "")
	Call BR_AppendLine(planFile, "Home servers (assignment " & UCase$(Trim$(CfgS("HomeServerAssignment", "BALANCED"))) & ", max " & CfgL("HomeServerMaxUsers", 0) & " users per server):")
	ForAll ps In srvCount
		If IsElement(loadBefore(LCase$(ListTag(ps)))) Then planLine = CStr(loadBefore(LCase$(ListTag(ps)))) Else planLine = "0"
		Call BR_AppendLine(planFile, "  " & ListTag(ps) & " : already " & planLine & " (registered into new mail folders + open batches)  + planned " & ps & "  = " & (CLng(planLine) + ps))
	End ForAll
	Call BR_AppendLine(planFile, "")
	Call BR_AppendLine(planFile, "Batches (Build Batch takes them in this order; users per home server):")
	For bNo = 1 To nBatches
		planLine = ""
		ForAll pb In srvCount
			If IsElement(planBatch(CStr(bNo) & "|" & ListTag(pb))) Then planLine = planLine & "   " & ListTag(pb) & " = " & planBatch(CStr(bNo) & "|" & ListTag(pb))
		End ForAll
		Call BR_AppendLine(planFile, "  Batch " & bNo & BR_IIfStr(Not scopeAll And bNo = chkBatch, " (checked in detail)", "") & " :" & planLine)
	Next
	Call BR_AppendLine(planFile, "")
	Call BR_AppendLine(planFile, "The split is a plan: the real batches are built by 02 - Build Batch from the then current directory.")
	BR_Log LVL_INFO, "Batch plan: " & nElig & " users in " & nBatches & " batch(es) of " & batchSize & " - detailed check of " & nChecked & " users - " & planFile

	' ---------- mail folders to pre-create (prerequisite B4) ----------
	' Members of the mail cluster share ONE set of folders (every member holds every
	' mail file: the primary on the home server, replicas on the others), so the
	' users of all home servers in the cluster are added up.
	Dim need As Integer, fldFile As String, prefix As String, fmax As Long
	Dim keyUsers List As Long, keyRep List As String, keyHomes List As String, mk As String, onSrv As String
	prefix = LCase$(CfgS("MailFolderPrefix", "mail"))
	fmax = CfgL("MailFolderMax", 0)
	fldFile = gRunDir & "BulkReg_Preflight_" & gRunID & "_mailfolders.txt"
	ForAll c In srvCount
		srvText = srvText & "   " & ListTag(c) & " : " & c & Chr$(10)
		BR_Log LVL_INFO, "Candidates for home server " & ListTag(c) & " : " & c
		If ListTag(c) <> "(none)" Then
			mk = BR_MailKey(ListTag(c))
			If IsElement(keyUsers(mk)) Then keyUsers(mk) = keyUsers(mk) + c Else keyUsers(mk) = c
			keyRep(mk) = ListTag(c)
			If IsElement(keyHomes(mk)) Then keyHomes(mk) = keyHomes(mk) & ", " & ListTag(c) & " (" & c & ")" Else keyHomes(mk) = ListTag(c) & " (" & c & ")"
		End If
	End ForAll
	If UCase$(CfgS("MailFolderMode", "NUMBERED")) = "NUMBERED" Then
		Call BR_AppendLine(fldFile, "BulkReg " & BR_VERSION & " - mail folders to create (" & CfgL("MailFilesPerFolder", 1000) & " mail files per folder)")
		Call BR_AppendLine(fldFile, "Create them directly under the Domino DATA directory of EVERY server listed, BEFORE the first batch (guide B4).")
		Call BR_AppendLine(fldFile, "")
		srvText = srvText & Chr$(10) & "Mail folders to create:" & Chr$(10)
		ForAll ku In keyUsers
			mk = ListTag(ku)
			need = BR_MailFoldersNeeded(keyRep(mk), CLng(ku), mfNames, mfCounts, mfScanned)
			If mk = "mail cluster" Then onSrv = BR_SrvList(CfgS("MailClusterServers", ""), "") Else onSrv = keyRep(mk)
			Call BR_AppendLine(fldFile, BR_IIf(mk = "mail cluster", "MAIL CLUSTER", "SERVER " & keyRep(mk)) & " : " & ku & " new users (home servers: " & keyHomes(mk) & ")")
			Call BR_AppendLine(fldFile, "  folders " & prefix & "1 .. " & prefix & need & "   on: " & onSrv)
			' commands for the platform(s) of the servers concerned (default ServerOS, ServerOSMap per server)
			Dim osList As Variant, oi As Integer, hasWin As Boolean, hasLin As Boolean
			hasWin = False: hasLin = False
			osList = Split(onSrv, ",")
			For oi = 0 To UBound(osList)
				If BR_ServerOS(CStr(osList(oi))) = "WINDOWS" Then hasWin = True Else hasLin = True
			Next
			If hasWin Then Call BR_AppendLine(fldFile, "  Windows server (PowerShell):  1.." & need & " | % { New-Item -ItemType Directory -Force """ & CfgS("ServerDataDirWindows", "<DataDir>") & "\" & prefix & "$_"" }")
			If hasLin Then Call BR_AppendLine(fldFile, "  Linux server (as root):       for i in $(seq 1 " & need & "); do mkdir -p " & CfgS("ServerDataDir", "/local/notesdata") & "/" & prefix & "$i; done; chown -R " & CfgS("ServerFileOwner", "<domino-user>:<domino-group>") & " " & CfgS("ServerDataDir", "/local/notesdata") & "/" & prefix & "*")
			Call BR_AppendLine(fldFile, "")
			srvText = srvText & "   " & prefix & "1.." & prefix & need & " on " & onSrv & Chr$(10)
			BR_Log LVL_INFO, "Mail folders needed: " & prefix & "1.." & prefix & need & " on " & onSrv & " (" & ku & " users)"
			If fmax > 0 And need > fmax Then
				BR_Log LVL_WARN, "MailFolderMax=" & fmax & " but " & need & " folders are needed on " & onSrv & " - create them and raise MailFolderMax"
				srvText = srvText & "   (MailFolderMax=" & fmax & " too low!)" & Chr$(10)
				envWarn = envWarn + 1
			End If
		End ForAll
	End If
	Dim summary As String
	summary = "Environment errors=" & envErr & " warnings=" & envWarn & _
	" | Candidates=" & col.Count & " (to register " & nElig & " in " & nBatches & " batch(es) of " & batchSize & ", detailed check of " & nChecked & ") OK=" & nOK & " WARN=" & nWarn & " ERROR=" & nErr & _
	" | without InternetAddress=" & nNoInet & BR_IIfStr(CfgB("SkipNoInternetAddress", True), " (SKIPPED - not registered until the address exists)", " (WARN - registered without address)") & _
	" | address constructed=" & nBuilt & " | no free home server=" & nNoCap
	BR_Close summary
	BR_Msg summary & Chr$(10) & Chr$(10) & "Planned users per home server:" & Chr$(10) & srvText & Chr$(10) & "Batch plan: " & planFile & Chr$(10) & "Mapping test: " & mapFile & Chr$(10) & BR_IIf(UCase$(CfgS("MailFolderMode", "NUMBERED")) = "NUMBERED", "Mail folders to create: " & fldFile & Chr$(10), "") & "Audit: " & gAuditFile & Chr$(10) & "Log: " & gDebugFile, _
	CInt(BR_IIf(envErr + nErr + nNoCap > 0, 48, 64))
	Exit Sub
ErrH:
	BR_Log LVL_ERROR, "Preflight aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	BR_Close "ABORTED"
	BR_Msg "Preflight aborted: " & Error$, 16
	Exit Sub
End Sub

' Logs PASS/FAIL, returns 1 on failure
Function BR_Check(ok As Boolean, what As String) As Integer
	If ok Then
		BR_Log LVL_INFO, "PASS  " & what
	Else
		BR_Log LVL_ERROR, "FAIL  " & what
		BR_Check = 1
	End If
End Function

Function BR_IIf(c As Boolean, a As Variant, b As Variant) As Variant
	If c Then BR_IIf = a Else BR_IIf = b
End Function

'=====================================================================
' BR_RunBuildBatch  -  runs agent BulkReg\02 - Build Batch
'   The agent itself only contains:  Call BR_RunBuildBatch()
'
' Selects ALL unregistered DirSync users and splits them into batch files of
' BatchSize rows (default 1000): BATCH-<run>-01.csv, -02.csv ... (BuildMaxBatches=n
' limits one run to n files, 0 = all). Resolves each user's home server / mail file / OU / policy / groups from
' server_mapping.csv, validates them and writes a batch file for review:
'
'   <BatchDir>\BATCH-<yyyymmdd-hhnnss>-NN.csv       one row per user, one file per BatchSize users
'   <BatchDir>\BATCH-<yyyymmdd-hhnnss>_summary.txt  all batches: totals per server / policy / mail folder
'
' Mail files: name = last name (MailFileNaming), unique per home server across
' all mail folders, files on the server, Person documents and open batches;
' a clash becomes smith2.nsf, smith3.nsf (MailFileCollision=SUFFIX) or an ERROR.
' Folders mail1, mail2 ... hold at most MailFilesPerFolder (1000) mail files.
' Mail cluster (MailClusterServers): names and folders are allocated once for
' ALL cluster members, and column ClusterReplicas lists the members that will
' get a replica of the mail file (all members except the home server).
'
' Review the CSV (Excel: save as "CSV UTF-8"). You may:
'   - set Include=N to leave a user out
'   - change HomeServer, MailFile, OrgUnit, Policy, Groups, VaultServer or
'     ClusterReplicas for a user (ClusterReplicas: comma separated, empty = none)
' Rows with Check=ERROR are written with Include=N.
' Agent 03 registers ONLY rows with Include=Y from the batch file you choose.
'
' Users already listed in another OPEN batch (no _results.csv yet) are not
' selected again, so one user is never in two pending batches.
'
' Config: BatchSize (rows per batch, default 1000), BatchServerFilter (only
'         users mapped to that home server), ExtraSelection, BatchDir.
'=====================================================================
Sub BR_RunBuildBatch()
	On Error GoTo ErrH
	Dim db As NotesDatabase, col As NotesDocumentCollection, doc As NotesDocument
	Dim usersView As NotesView, dupCol As NotesDocumentCollection
	Dim u As BRUser, issues As String, chk As String, inc As String, t0 As Double
	Dim batchMax As Long, srvFilter As String, bdir As String, bfile As String, sumFile As String
	Dim openIds List As String, srvCache List As String
	Dim seenShort List As String, seenMail List As String, seenMF List As String, checkMF As Boolean
	Dim srvInc List As Long, srvExcl List As Long, polInc List As Long
	Dim nRows As Long, nInc As Long, nWarn As Long, nErr As Long, nNoInet As Long, skipFile As String, skipNoInet As Boolean
	Dim nInOpen As Long, nOtherSrv As Long, nLeft As Long, r As String, hk As String, pk As String
	Dim mfNames List As String, mfCounts List As Long, mfScanned List As String, newInFolder List As Long, aIssue As String, fkey As String
	Dim repByHome List As String, rl As Variant, ri As Integer, foundOn As String
	Dim homeIssue As String, bOther As Boolean, nBuilt As Long
	Dim baseID As String, batchNo As Long, rowsIn As Long, maxBatches As Long, bi As Long, bl As String
	Dim batchFiles List As String, bRows List As Long, bInc List As Long, bErr List As Long, bSrv List As Long, bk As String

	If gEmbedded Then
		gEmbError = "": gBldFileCount = 0: gBldRows = 0: gBldInc = 0: gBldErr = 0: gBldWarn = 0: gBldNoInet = 0: gBldInOpen = 0: gBldLeft = 0
		Erase gBldFiles
	Else
		If Not BR_Init("BuildBatch") Then Exit Sub                  ' (embedded in AutoSync: BR_Init was done by BulkRegAuto)
	End If
	maxBatches = CfgL("BuildMaxBatches", 0)                         ' 0 = build ALL batches in this run
	batchMax = CfgL("BatchSize", 1000)
	If batchMax < 1 Then batchMax = 1000
	srvFilter = Trim$(CfgS("BatchServerFilter", ""))
	checkMF = CfgB("CheckMailFileExists", True)

	bdir = BR_BatchDir()
	If Not BR_DirWritable(bdir) Then Error 5001, "BatchDir missing or not writable: " & bdir
	' One run builds ALL batches: BATCH-<run>-01.csv, BATCH-<run>-02.csv ... (BatchSize rows each).
	' The files are created as they fill up; run-level reports use the base id BATCH-<run>.
	baseID = "BATCH-" & gRunID
	gBatchID = baseID
	sumFile = bdir & baseID & "_summary.txt"
	skipFile = bdir & baseID & "_skipped_no_internet_address.csv"
	skipNoInet = CfgB("SkipNoInternetAddress", True)

	Set db = BR_OpenDirectory()
	' mail file names already in use: open batches, Person documents, files on servers (scanned per server)
	Call BR_OpenBatchNoteIDs(openIds, mfNames, mfCounts)
	Call BR_ScanDirectoryMail(db, mfNames)
	Set usersView = db.GetView("($Users)")
	Set col = BR_GetCandidates(db, True)

	Set doc = col.GetFirstDocument()
	Do While Not (doc Is Nothing)
		t0 = Timer
		Call BR_ReadUser(doc, u)
		If IsElement(openIds(u.NoteID)) Then
			nInOpen = nInOpen + 1                                   ' already in a pending batch
		ElseIf skipNoInet And u.InternetAddress = "" Then
			' no Internet address: SKIPPED and flagged - not in the batch, offered again once DirSync has the address
			nNoInet = nNoInet + 1
			If nNoInet = 1 Then Call BR_AppendLine(skipFile, Uchr$(&HFEFF) & "BatchID,NoteID,UNID,objectGUID,FullName,FullNameAfter,FirstName,LastName,ShortName,HomeServer,Result,Reason")
			Call BR_AppendLine(skipFile, Q(gBatchID) & "," & Q(u.NoteID) & "," & Q(u.UNID) & "," & Q(u.GUID) & "," & Q(u.FullNameBefore) & "," & Q(BR_ExpectedName(u)) & "," & Q(u.FirstName) & "," & Q(u.LastName) & "," & Q(u.ShortName) & "," & Q(u.HomeServer) & "," & Q(BR_RESULT_NO_INET) & "," & Q(BR_SKIP_NO_INET))
			Call BR_Audit(u, "BUILD", "SELECT", BR_RESULT_NO_INET, BR_Elapsed(t0), BR_SKIP_NO_INET)
		Else
			' home server of the pool (AUTO): balanced over HomeServers, max HomeServerMaxUsers each
			homeIssue = BR_AssignHome(u)
			If srvFilter <> "" And homeIssue = "" Then
				If Not BR_SameServer(u.HomeServer, srvFilter) Then bOther = True
			End If
			If bOther Then
				nOtherSrv = nOtherSrv + 1                           ' belongs to another server wave
				bOther = False
			ElseIf rowsIn >= batchMax And maxBatches > 0 And batchNo >= maxBatches Then
				nLeft = nLeft + 1                                   ' BuildMaxBatches reached - left for the next run
			Else
			If batchNo = 0 Or rowsIn >= batchMax Then               ' start the next batch file
				batchNo = batchNo + 1
				rowsIn = 0
				gBatchID = baseID & "-" & Format$(batchNo, "00")
				bfile = bdir & gBatchID & ".csv"
				batchFiles(CStr(batchNo)) = bfile
				Call BR_AppendLine(bfile, Uchr$(&HFEFF) & BR_BATCH_COLS)
				BR_Log LVL_INFO, "Batch " & batchNo & ": " & bfile
			End If
			nRows = nRows + 1
			rowsIn = rowsIn + 1
			issues = homeIssue & BR_Validate(u)
			If u.ShortName <> "" Then
				If IsElement(seenShort(LCase$(u.ShortName))) Then issues = issues & "ERROR:Duplicate ShortName in batch; " Else seenShort(LCase$(u.ShortName)) = u.NoteID
			End If
			If u.InternetAddress <> "" Then
				If IsElement(seenMail(LCase$(u.InternetAddress))) Then issues = issues & "ERROR:Duplicate InternetAddress in batch; " Else seenMail(LCase$(u.InternetAddress)) = u.NoteID
				If Not (usersView Is Nothing) Then
					Set dupCol = usersView.GetAllDocumentsByKey(u.InternetAddress, True)
					If dupCol.Count > 1 Then issues = issues & "WARN:InternetAddress used by " & dupCol.Count & " directory entries; "
				End If
			End If
			If u.HomeServer <> "" Then
				If Not BR_HomeServerOK(u.HomeServer, srvCache) Then
					issues = issues & "ERROR:HomeServer unreachable; "
				ElseIf InStr(issues, "ERROR:") = 0 Then
					' unique mail file name + numbered folder (mail1, mail2 ...) on this home server
					Call BR_ScanServerMail(u.HomeServer, mfNames, mfCounts, mfScanned)
					aIssue = BR_AllocMailFile(u, mfNames, mfCounts)
					issues = issues & aIssue
					If aIssue = "" And checkMF Then
						foundOn = BR_MailFileExistsAny(u)
						If foundOn <> "" Then issues = issues & "ERROR:MailFile " & u.MailFile & " already exists on " & foundOn & "; "
					End If
					' replica servers: unreachable now = AdminP will wait for them (warning only)
					If u.ClusterReplicas <> "" Then
						rl = Split(u.ClusterReplicas, ",")
						For ri = 0 To UBound(rl)
							If Not BR_HomeServerOK(CStr(rl(ri)), srvCache) Then issues = issues & "WARN:Replica server " & rl(ri) & " unreachable; "
						Next
					End If
					If InStr(u.MailFileNote, "already used") > 0 Then issues = issues & "WARN:mail file renamed - " & StrLeft(u.MailFileNote, ";") & "; "
				End If
			End If

			If u.InternetAddress = "" Then nNoInet = nNoInet + 1     ' only when SkipNoInternetAddress=0 (WARN)
			If u.InetSource = "CONSTRUCTED" Then nBuilt = nBuilt + 1
			If InStr(issues, "ERROR:") > 0 Then
				chk = "ERROR": inc = "N": nErr = nErr + 1
			ElseIf InStr(issues, "WARN:") > 0 Then
				chk = "WARN": inc = "Y": nWarn = nWarn + 1
			Else
				chk = "OK": inc = "Y"
			End If
			hk = BR_IIfStr(u.HomeServer = "", "(none)", u.HomeServer)
			pk = BR_IIfStr(u.Policy = "", "(none)", u.Policy)
			bk = CStr(batchNo)
			bRows(bk) = rowsIn
			If inc = "Y" Then
				If IsElement(bInc(bk)) Then bInc(bk) = bInc(bk) + 1 Else bInc(bk) = 1
				If IsElement(bSrv(bk & "|" & hk)) Then bSrv(bk & "|" & hk) = bSrv(bk & "|" & hk) + 1 Else bSrv(bk & "|" & hk) = 1
			Else
				If IsElement(bErr(bk)) Then bErr(bk) = bErr(bk) + 1 Else bErr(bk) = 1
			End If
			If inc = "Y" Then
				nInc = nInc + 1
				If IsElement(srvInc(hk)) Then srvInc(hk) = srvInc(hk) + 1 Else srvInc(hk) = 1
				repByHome(hk) = BR_IIfStr(u.ClusterReplicas = "", "(no replicas)", u.ClusterReplicas)
				If IsElement(polInc(pk)) Then polInc(pk) = polInc(pk) + 1 Else polInc(pk) = 1
				If InStr(u.MailFile, "\") > 0 Then fkey = BR_IIfStr(BR_InMailCluster(u.HomeServer), "mail cluster", hk) & " : " & StrLeftBack(u.MailFile, "\") Else fkey = hk & " : (data directory)"
				If IsElement(newInFolder(fkey)) Then newInFolder(fkey) = newInFolder(fkey) + 1 Else newInFolder(fkey) = 1
			Else
				If IsElement(srvExcl(hk)) Then srvExcl(hk) = srvExcl(hk) + 1 Else srvExcl(hk) = 1
			End If

			r = Q(inc) & "," & Q(gBatchID) & "," & Q(CStr(rowsIn)) & "," & Q(u.NoteID) & "," & Q(u.UNID) & "," & Q(u.GUID) & "," & _
			Q(u.FullNameBefore) & "," & Q(BR_ExpectedName(u)) & "," & Q(BR_ExpectedName(u)) & "," & Q(u.FirstName) & "," & Q(u.LastName) & "," & Q(u.ShortName) & "," & Q(u.InternetAddress) & "," & _
			Q(u.HomeServer) & "," & Q(BR_SrvPathFor(u.HomeServer, u.MailFile)) & "," & Q(u.MailFileNote) & "," & Q(u.OrgUnit) & "," & Q(u.Policy) & "," & Q(u.Groups) & "," & Q(u.VaultServer) & "," & Q(u.ClusterReplicas) & "," & Q(u.MapRule) & "," & Q(chk) & "," & Q(issues) & "," & Q(u.InetSource)
			Call BR_AppendLine(bfile, r)
			u.FullNameAfter = BR_ExpectedName(u)                         ' expected Notes name
			Call BR_Audit(u, "BUILD", "SELECT", chk, BR_Elapsed(t0), "Include=" & inc & " " & issues)
			End If
		End If
		Set doc = col.GetNextDocument(doc)
	Loop

	' ---------- summary file ----------
	Call BR_AppendLine(sumFile, "BulkReg " & BR_VERSION & " - batch summary")
	Call BR_AppendLine(sumFile, "Run / base ID   : " & baseID & "   (" & batchNo & " batch file(s), max " & batchMax & " rows each)")
	Call BR_AppendLine(sumFile, "Built by / at   : " & gOperator & " / " & Format$(Now, "yyyy-mm-dd hh:nn:ss"))
	For bi = 1 To batchNo
		bk = CStr(bi)
		bl = ""
		ForAll bs In srvInc
			If IsElement(bSrv(bk & "|" & ListTag(bs))) Then bl = bl & "  " & ListTag(bs) & "=" & bSrv(bk & "|" & ListTag(bs))
		End ForAll
		Call BR_AppendLine(sumFile, "Batch " & Format$(bi, "00") & "        : " & batchFiles(bk) & "  rows " & bRows(bk) & ", Include=Y " & BR_ListLongText(bInc, bk) & ", ERROR " & BR_ListLongText(bErr, bk) & " |" & bl)
	Next
	Call BR_AppendLine(sumFile, "Selection       : " & BR_SelectionFormula(True))
	Call BR_AppendLine(sumFile, "Server filter   : " & BR_IIfStr(srvFilter = "", "(none - all home servers)", srvFilter))
	Call BR_AppendLine(sumFile, "Batch size limit: " & batchMax)
	If BR_HomePool() <> "" Then
		Call BR_AppendLine(sumFile, "Home servers    : " & BR_HomePool() & "  (" & UCase$(Trim$(CfgS("HomeServerAssignment", "BALANCED"))) & ", max " & CfgL("HomeServerMaxUsers", 0) & " users per server)")
		ForAll ld In gSrvLoad
			Call BR_AppendLine(sumFile, "                  " & ListTag(ld) & " : " & ld & " users counted (registered in new mail folders + open batches + assigned in this run)")
		End ForAll
	End If
	Call BR_AppendLine(sumFile, "Internet address: " & nBuilt & " constructed as <shortname>@" & CfgS("InternetDomain", "(InternetDomain not set)") & " (not present in AD)")
	Call BR_AppendLine(sumFile, "")
	Call BR_AppendLine(sumFile, "Rows (all batches): " & nRows & "   Include=Y: " & nInc & "   (WARN: " & nWarn & ")   Include=N (ERROR): " & nErr)
	If skipNoInet Then
		Call BR_AppendLine(sumFile, "No Internet addr: " & nNoInet & "   SKIPPED and flagged - not in this batch. List: " & BR_IIfStr(nNoInet > 0, skipFile, "(none)"))
		Call BR_AppendLine(sumFile, "                  Add the address in AD; after DirSync the next Build Batch offers the user again.")
	Else
		Call BR_AppendLine(sumFile, "No Internet addr: " & nNoInet & "   (WARN - included and registered without an address; SkipNoInternetAddress=0)")
	End If
	Call BR_AppendLine(sumFile, "Not selected    : already in an open batch: " & nInOpen & " | other home server: " & nOtherSrv & " | left for the next run (BuildMaxBatches): " & nLeft)
	Call BR_AppendLine(sumFile, "")
	Call BR_AppendLine(sumFile, "Included users per home server:")
	ForAll fa1 In srvInc
		Call BR_AppendLine(sumFile, "  " & ListTag(fa1) & " : " & fa1)
	End ForAll
	Call BR_AppendLine(sumFile, "Cluster replicas of the mail files (requested by 03 via AdminP" & BR_IIfStr(CfgB("CreateClusterReplicas", True), "", " - OFF: CreateClusterReplicas=0") & "):")
	ForAll fa6 In repByHome
		Call BR_AppendLine(sumFile, "  home " & ListTag(fa6) & " -> replicas on " & fa6)
	End ForAll
	If CfgS("MailClusterServers", "") <> "" Then Call BR_AppendLine(sumFile, "Mail cluster (names + folders allocated once for all members): " & BR_SrvList(CfgS("MailClusterServers", ""), ""))
	Call BR_AppendLine(sumFile, "Excluded (ERROR) per home server:")
	ForAll fa2 In srvExcl
		Call BR_AppendLine(sumFile, "  " & ListTag(fa2) & " : " & fa2)
	End ForAll
	Call BR_AppendLine(sumFile, "Mail files: naming " & UCase$(CfgS("MailFileNaming", "LASTNAME")) & ", collisions " & UCase$(CfgS("MailFileCollision", "SUFFIX")) & _
	", folders " & UCase$(CfgS("MailFolderMode", "NUMBERED")) & BR_IIfStr(UCase$(CfgS("MailFolderMode", "NUMBERED")) = "NUMBERED", " (" & CfgS("MailFolderPrefix", "mail") & "1, " & CfgS("MailFolderPrefix", "mail") & "2 ... max " & CfgL("MailFilesPerFolder", 1000) & " per folder)", ""))
	Call BR_AppendLine(sumFile, "New mail files per home server (or mail cluster) and folder (Include=Y):")
	ForAll fa3 In newInFolder
		Call BR_AppendLine(sumFile, "  " & ListTag(fa3) & " : " & fa3)
	End ForAll
	Call BR_AppendLine(sumFile, "Folder fill after this batch (existing + open batches + this batch):")
	ForAll fa4 In mfCounts
		If LCase$(StrRight(ListTag(fa4), "!!")) Like LCase$(CfgS("MailFolderPrefix", "mail")) & "#*" Then Call BR_AppendLine(sumFile, "  " & Replace(ListTag(fa4), "!!", " : ") & " : " & fa4)
	End ForAll
	Call BR_AppendLine(sumFile, "Included users per explicit policy:")
	ForAll fa5 In polInc
		Call BR_AppendLine(sumFile, "  " & ListTag(fa5) & " : " & fa5)
	End ForAll
	Call BR_AppendLine(sumFile, "")
	Call BR_AppendLine(sumFile, "Next: review each " & baseID & "-NN.csv (Include / HomeServer / MailFile / ClusterReplicas / Policy),")
	Call BR_AppendLine(sumFile, "      then run Actions > BulkReg > 03 - Register Batch once per batch file, starting with -01.")

	If gEmbedded Then
		' AutoSync step: hand the result to BulkRegAuto (it closes the run and reports)
		gBldFileCount = batchNo: gBldRows = nRows: gBldInc = nInc: gBldErr = nErr: gBldWarn = nWarn
		gBldNoInet = nNoInet: gBldInOpen = nInOpen: gBldLeft = nLeft
		ForAll bfx In batchFiles
			gBldFiles(ListTag(bfx)) = CStr(bfx)
		End ForAll
		BR_Log LVL_INFO, "Build (AutoSync): batches=" & batchNo & " rows=" & nRows & " include=" & nInc & " error=" & nErr & " warn=" & nWarn & " left=" & nLeft & " in_open_batch=" & nInOpen & " no_inet=" & nNoInet
		Exit Sub
	End If
	BR_Close "batches=" & batchNo & " (" & baseID & "-01.." & Format$(batchNo, "00") & ") rows=" & nRows & " include=" & nInc & " error=" & nErr & " left=" & nLeft & " skipped_no_inet=" & BR_IIfStr(skipNoInet, CStr(nNoInet), "0")
	BR_Msg batchNo & " batch file(s) created: " & baseID & "-01 .. -" & Format$(batchNo, "00") & Chr$(10) & Chr$(10) & _
	"Rows: " & nRows & "   Include=Y: " & nInc & "   WARN: " & nWarn & "   ERROR (Include=N): " & nErr & Chr$(10) & _
	BR_IIfStr(skipNoInet, "Skipped - no InternetAddress: " & nNoInet & BR_IIfStr(nNoInet > 0, "  (list: " & skipFile & ")", ""), "Without InternetAddress (WARN, included): " & nNoInet) & Chr$(10) & _
	"Not selected - in open batch: " & nInOpen & ", other server: " & nOtherSrv & ", left for the next run: " & nLeft & Chr$(10) & Chr$(10) & _
	"Review:  " & bdir & baseID & "-NN.csv" & Chr$(10) & "Summary: " & sumFile & Chr$(10) & Chr$(10) & _
	"Nothing has been registered. Run Actions > BulkReg > 03 - Register Batch after review.", BR_IIfInt(nErr > 0, 48, 64)
	Exit Sub
ErrH:
	BR_Log LVL_ERROR, "Build Batch aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	If gEmbedded Then gEmbError = "Build aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	BR_Close "ABORTED"
	BR_Msg "Build Batch aborted: " & Error$, 16
	Exit Sub
End Sub

Function BR_IIfInt(c As Boolean, a As Integer, b As Integer) As Integer
	If c Then BR_IIfInt = a Else BR_IIfInt = b
End Function

'=====================================================================
' BR_RunRegisterBatch  -  runs agent BulkReg\03 - Register Batch
'   The agent itself only contains:  Call BR_RunRegisterBatch()
'
' Mail       : creates a Domino mail file for every user on the batch row's
'              HomeServer at the batch row's MailFile (e.g. mail1\smith.nsf).
' Replicas   : when the row's ClusterReplicas column lists servers (other members
'              of the mail cluster) and CreateClusterReplicas=1, an AdminP
'              "Create Replica" request is posted for each of them right after
'              the mail file is created (same path, ACL copied). AdminP on the
'              destination servers creates the replicas; Agent 04 verifies them.
'
' Input      : ONE reviewed batch file  <BatchDir>\BATCH-<id>.csv  built by
'              Agent 02. Only rows with Include=Y are processed - nothing is
'              selected from names.nsf at run time, so you always know exactly
'              who will be registered. HomeServer / MailFile / OrgUnit / Policy / Groups
'              are taken from the batch file (your reviewed values).
'
' Method     : NotesRegistration.ContactNoteID  (HCL Domino Designer 14.5)
'              "Used to register users who have existing Person documents
'               created by syncing Active Directory users into the Domino
'               directory." Doc must have item objectGUID and NO Certificate.
'
' ID Vault   : deposited by the explicit policy (PolicyName) whose Security
'              Settings assign the ID Vault; verified with IsIDInVault.
'
' Safety     : DryRun (default ON); Yes/No summary per home server; LIVE needs
'              the batch ID typed exactly; objectGUID in the file must match
'              the Person doc; Certificate re-checked (idempotent);
'              MaxConsecutiveErrors circuit-breaker; per-user error isolation.
'
' Output     : LIVE   <BatchDir>\BATCH-<id>_results.csv  (closes the batch)
'              DRYRUN <BatchDir>\BATCH-<id>_dryrun_<run>.csv (batch stays open)
'              plus the usual audit CSV and debug log in AuditDir.
'=====================================================================
Sub BR_RunRegisterBatch()
	On Error GoTo ErrH
	' library variables keep their value between runs in the same client session - reset them
	gCertPwd = "": gPwFile = "": gMode = "": gStopRun = ""
	Erase gSrvOK
	Dim ws As NotesUIWorkspace, ans As Variant
	Dim db As NotesDatabase, u As BRUser
	Dim bfile As String, bname As String, bdir As String, fh As Integer, txt As String
	Dim cols List As Integer, delim As String, parts As Variant, isFirst As Boolean
	Dim nid() As String, gid() As String, hs() As String, ou() As String, po() As String, gr() As String, vs() As String, un() As String, mf() As String, mn() As String, cr() As String
	Dim repText As String, repSeen List As String
	Dim n As Long, i As Long, seen List As String, srvCount List As Long, srvText As String, hk As String
	Dim nExcluded As Long, maxRows As Long, pauseMs As Long, maxConsec As Long
	Dim nOK As Long, nFail As Long, nSkip As Long, nConsec As Long, res As String, stopReason As String
	Dim j As Long, summary As String

	If gEmbedded Then
		' AutoSync step: BR_Init was done by BulkRegAuto; batch file and mode are given, nothing is asked
		gEmbError = "": gRegOK = 0: gRegFail = 0: gRegSkip = 0: gRegStop = "": gRegRows = 0
		If gEmbDryRun Then gMode = "DRYRUN" Else gMode = "LIVE"
	Else
		If Not BR_Init("Register") Then Exit Sub
		If CfgB("DryRun", True) Then gMode = "DRYRUN" Else gMode = "LIVE"
	End If
	maxRows = CfgL("MaxBatchRows", 1000)
	pauseMs = CfgL("PauseMs", 500)
	maxConsec = CfgL("MaxConsecutiveErrors", 5)
	bdir = BR_BatchDir()

	' ---------- choose the batch file ----------
	If gEmbedded Then
		bfile = gEmbBatchFile
	Else
		Set ws = New NotesUIWorkspace
		bfile = BR_NewestOpenBatch()
		If bfile = "" Then
			BR_Close "No open batch"
			BR_Msg "There is no open batch file in " & bdir & Chr$(10) & "Run Actions > BulkReg > 02 - Build Batch first.", 48
			Exit Sub
		End If
		ans = ws.Prompt(PROMPT_OKCANCELEDIT, "BulkReg - Register batch (" & gMode & ")", "Batch file to register (reviewed):", bfile)
		If IsEmpty(ans) Then
			BR_Close "Cancelled"
			Exit Sub
		End If
		bfile = BR_LocalPath(Trim$(CStr(ans)))
	End If
	If Dir$(bfile) = "" Then Error 6001, "Batch file not found: " & bfile
	bname = StrRightBack(bfile, gSep)
	If LCase$(Right$(bname, 4)) <> ".csv" Or Left$(bname, 6) <> "BATCH-" Or InStr(bname, "_") > 0 Then Error 6002, "Not a batch file (expected BATCH-<id>.csv): " & bname
	gBatchID = Left$(bname, Len(bname) - 4)
	If Dir$(bdir & gBatchID & "_results.csv") <> "" Then Error 6003, gBatchID & " is already DONE (" & gBatchID & "_results.csv exists). Build a new batch."

	' ---------- load the approved rows ----------
	fh = FreeFile()
	Open bfile For Input As #fh Charset = "UTF-8"
	isFirst = True
	Do Until EOF(fh)
		Line Input #fh, txt
		If isFirst Then
			Call BR_CsvHeader(txt, delim, cols)
			If Not IsElement(cols("include")) Or Not IsElement(cols("noteid")) Or Not IsElement(cols("objectguid")) Or Not IsElement(cols("homeserver")) Then
				Close #fh
				Error 6004, "Batch file header is missing Include/NoteID/objectGUID/HomeServer columns"
			End If
			isFirst = False
		ElseIf Trim$(txt) <> "" Then
			parts = BR_CsvSplit(txt, delim)
			If UCase$(BR_CsvGet(parts, cols, "Include")) = "Y" Then
				If IsElement(seen(BR_CsvGet(parts, cols, "NoteID"))) Then
					Close #fh
					Error 6005, "NoteID " & BR_CsvGet(parts, cols, "NoteID") & " is listed twice in the batch file"
				End If
				seen(BR_CsvGet(parts, cols, "NoteID")) = "1"
				ReDim Preserve nid(n) As String, gid(n) As String, hs(n) As String, ou(n) As String, po(n) As String, gr(n) As String, vs(n) As String, un(n) As String, mf(n) As String, mn(n) As String, cr(n) As String
				nid(n) = BR_CsvGet(parts, cols, "NoteID")
				gid(n) = BR_CsvGet(parts, cols, "objectGUID")
				un(n) = BR_CsvGet(parts, cols, "UNID")
				mf(n) = BR_CsvGet(parts, cols, "MailFile")
				mn(n) = BR_CsvGet(parts, cols, "MailFileNote")
				hs(n) = BR_CsvGet(parts, cols, "HomeServer")
				ou(n) = BR_CsvGet(parts, cols, "OrgUnit")
				po(n) = BR_CsvGet(parts, cols, "Policy")
				gr(n) = BR_CsvGet(parts, cols, "Groups")
				vs(n) = BR_CsvGet(parts, cols, "VaultServer")
				If vs(n) = "" Then vs(n) = CfgS("VaultServer", "")
				hs(n) = BR_SrvAbbr(hs(n))          ' accept CN=Srv/O=Org or Srv/Org
				' reviewed replica list; a batch built before 3.2.0 has no such column -> from the mapping
				If IsElement(cols("clusterreplicas")) Then cr(n) = BR_SrvList(BR_CsvGet(parts, cols, "ClusterReplicas"), hs(n)) Else cr(n) = "*auto"
				If Not IsElement(repSeen(LCase$(hs(n)))) Then
					repSeen(LCase$(hs(n))) = "1"
					repText = repText & "   " & BR_IIfStr(hs(n) = "", "(none)", hs(n)) & " -> " & BR_IIfStr(cr(n) = "", "no replicas", BR_IIfStr(cr(n) = "*auto", "from mapping", cr(n))) & Chr$(10)
				End If
				hk = BR_IIfStr(hs(n) = "", "(none)", hs(n))
				If IsElement(srvCount(hk)) Then srvCount(hk) = srvCount(hk) + 1 Else srvCount(hk) = 1
				n = n + 1
			Else
				nExcluded = nExcluded + 1
			End If
		End If
	Loop
	Close #fh
	BR_Log LVL_INFO, "Batch " & gBatchID & " loaded: Include=Y " & n & ", Include=N " & nExcluded & _
	" | file " & bfile & " | size " & FileLen(bfile) & " bytes | modified " & FileDateTime(bfile)
	gRegRows = n
	If n = 0 Then
		If gEmbedded Then Exit Sub                       ' AutoSync: nothing to register (gRegRows = 0)
		BR_Close "Batch has no Include=Y rows"
		BR_Msg gBatchID & " has no rows with Include=Y. Nothing to do.", 48
		Exit Sub
	End If
	If n > maxRows Then Error 6006, "Batch has " & n & " rows; MaxBatchRows is " & maxRows

	ForAll c In srvCount
		srvText = srvText & "   " & ListTag(c) & " : " & c & Chr$(10)
		BR_Log LVL_INFO, "  home server " & ListTag(c) & " : " & c
	End ForAll

	' ---------- confirmation ----------
	' AutoSync has no operator: its approval is the set of safety gates in BulkRegAuto (see docs/AUTOSYNC.md)
	If gEmbedded Then
		BR_Log LVL_INFO, "Batch " & gBatchID & " approved for " & gMode & " by AutoSync gates (operator " & gOperator & ")"
	Else
		If Not BR_ConfirmRun(n, nExcluded, srvText, repText) Then Exit Sub
		BR_Log LVL_INFO, "Batch " & gBatchID & " approved for " & gMode & " by " & gOperator
	End If

	' ---------- results file ----------
	If gMode = "LIVE" Then
		gResultsFile = bdir & gBatchID & "_results.csv"
	Else
		gResultsFile = bdir & gBatchID & "_dryrun_" & gRunID & ".csv"
	End If
	Call BR_AppendLine(gResultsFile, Uchr$(&HFEFF) & BR_AuditHeader())
	If gMode = "LIVE" And CfgB("WritePasswordFile", True) Then
		gPwFile = BR_CfgDir("PasswordDir", "secure") & "BulkReg_InitialPasswords_" & gBatchID & "_" & gRunID & ".csv"
		Call BR_AppendLine(gPwFile, Uchr$(&HFEFF) & "BatchID,FullName,InternetAddress,IDFile,InitialPassword")
		BR_Log LVL_INFO, "Initial passwords will be written to the restricted file: " & gPwFile
	End If

	' ---------- register the approved rows ----------
	Set db = BR_OpenDirectory()
	For i = 0 To n - 1
		res = BR_RegisterOne(db, nid(i), un(i), gid(i), hs(i), mf(i), mn(i), ou(i), po(i), gr(i), vs(i), cr(i))
		Select Case Left$(res, 2)
		Case "OK"
			nOK = nOK + 1: nConsec = 0
		Case "SK"
			nSkip = nSkip + 1
		Case Else
			nFail = nFail + 1: nConsec = nConsec + 1
		End Select
		If Not gAuto Then Print "BulkReg " & gMode & " " & gBatchID & ": " & (i + 1) & "/" & n & "  ok=" & nOK & " fail=" & nFail & " skip=" & nSkip
		If gStopRun <> "" Then
			stopReason = gStopRun
			BR_Log LVL_ERROR, "Run stopped: " & stopReason
			Exit For
		End If
		If nConsec >= maxConsec Then
			stopReason = "Circuit breaker: " & nConsec & " consecutive failures"
			BR_Log LVL_ERROR, stopReason
			Exit For
		End If
		' AutoSync run-time budget (the Agent Manager would kill the agent at its own limit): stop cleanly between users
		If gEmbedded And gEmbDeadline > 0 Then
			If CDbl(Now) > gEmbDeadline And i < n - 1 Then
				stopReason = "Run-time budget reached (AutoMaxRuntimeMin) - remaining users are offered again by the next run"
				BR_Log LVL_WARN, stopReason
				Exit For
			End If
		End If
		If pauseMs > 0 Then Sleep pauseMs / 1000
	Next
	' rows not reached (circuit breaker) are recorded so the results file is complete
	If i < n - 1 Then
		For j = i + 1 To n - 1
			Call BR_ClearUser(u)
			u.NoteID = nid(j): u.GUID = gid(j): u.HomeServer = hs(j): u.OrgUnit = ou(j): u.Policy = po(j)
			u.MailFile = mf(j): u.ClusterReplicas = BR_IIfStr(cr(j) = "*auto", "", cr(j))
			Call BR_Audit(u, gMode, "REGISTER", "NOT_PROCESSED", 0, stopReason & " - will be offered again by the next 02 - Build Batch")
		Next
	End If
	If stopReason = "" Then stopReason = "All batch rows processed"

	gCertPwd = ""
	summary = gMode & " | " & gBatchID & " | rows=" & n & " ok=" & nOK & " failed=" & nFail & " skipped=" & nSkip & " | " & stopReason
	If gEmbedded Then
		' AutoSync step: hand the result to BulkRegAuto (it closes the run and reports)
		gRegOK = nOK: gRegFail = nFail: gRegSkip = nSkip
		If stopReason <> "All batch rows processed" Then gRegStop = stopReason
		BR_Log LVL_INFO, "Register (AutoSync): " & summary
		Exit Sub
	End If
	BR_Close summary
	BR_Msg summary & Chr$(10) & Chr$(10) & "Results: " & gResultsFile & Chr$(10) & "Log: " & gDebugFile & _
	BR_IIfS(gPwFile <> "", Chr$(10) & "Passwords (restricted): " & gPwFile, "") & Chr$(10) & Chr$(10) & _
	BR_IIfS(gMode = "LIVE", "Batch is now DONE. Cluster replicas are created by AdminP over the next minutes/hours." & Chr$(10) & "Run Actions > BulkReg > 04 - Verify Registration and Vault next (and again later until all replicas are OK).", "Dry run only - the batch is still OPEN. Set DryRun=0 to register it."), _
	CInt(BR_IIfS(nFail > 0, 48, 64))
	Exit Sub
ErrH:
	gCertPwd = ""
	BR_Log LVL_ERROR, "Run aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	If gEmbedded Then gEmbError = "Register aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	BR_Close "ABORTED"
	BR_Msg "Run aborted: " & Error$ & Chr$(10) & "See " & gDebugFile, 16
	Exit Sub
End Sub

'---------------------------------------------------------------------
' Operator confirmation: summary per home server (Yes/No); for LIVE the
' batch ID must be typed exactly; certifier password if UseCA=0.
'---------------------------------------------------------------------
Function BR_ConfirmRun(n As Long, nExcluded As Long, srvText As String, repText As String) As Boolean
	Dim ws As NotesUIWorkspace, ans As Variant
	Set ws = New NotesUIWorkspace
	ans = ws.Prompt(PROMPT_YESNO, "BulkReg - " & gMode & " - " & gBatchID, _
	"Mode: " & BR_IIfStr(gMode = "LIVE", "LIVE - users WILL be registered (Notes ID, mail file, ID Vault)", "DRY RUN (DryRun=1) - simulation only, NOTHING will be changed") & Chr$(10) & _
	"Batch: " & gBatchID & Chr$(10) & _
	"Users to register (Include=Y): " & n & "    excluded (Include=N): " & nExcluded & Chr$(10) & _
	"Per home server:" & Chr$(10) & srvText & _
	"Cluster replicas of the mail files (" & BR_IIfStr(CfgB("CreateClusterReplicas", True), "requested via AdminP", "NOT requested: CreateClusterReplicas=0") & "):" & Chr$(10) & repText & _
	"Registration server: " & CfgS("RegistrationServer", "") & Chr$(10) & _
	"Certification: " & BR_CertText() & Chr$(10) & _
	"Vault check: per batch row (default " & CfgS("VaultServer", "") & ")" & Chr$(10) & Chr$(10) & "Continue?")
	If ans <> 1 Then
		BR_Close "Cancelled by operator"
		Exit Function
	End If
	If gMode = "LIVE" Then
		ans = ws.Prompt(PROMPT_OKCANCELEDIT, "BulkReg - LIVE confirmation", _
		"LIVE mode will create Notes IDs and mail files for " & n & " users" & BR_IIfStr(CfgB("CreateClusterReplicas", True), " and request their cluster replicas.", ".") & Chr$(10) & _
		"Type the batch ID to approve:  " & gBatchID, "")
		If IsEmpty(ans) Then ans = ""
		If CStr(ans) <> gBatchID Then
			BR_Log LVL_WARN, "LIVE run not approved (batch ID not typed correctly) - aborted"
			BR_Close "Not approved"
			Exit Function
		End If
		If Not CfgB("UseCA", True) Then
			ans = ws.Prompt(PROMPT_PASSWORD, "BulkReg", "Certifier ID password for " & BR_CfgFile("CertifierIDFile", "") & ":")
			If IsEmpty(ans) Then ans = ""
			gCertPwd = CStr(ans)
			If gCertPwd = "" Then
				BR_Close "No certifier password"
				Exit Function
			End If
		End If
	End If
	BR_ConfirmRun = True
End Function

'---------------------------------------------------------------------
' Registers ONE user. Returns "OK...", "SKIP..." or "FAIL...".
' Values come from the reviewed batch file. Every outcome writes an audit
' row (and a results row). Errors never stop the batch.
'---------------------------------------------------------------------
Function BR_RegisterOne(db As NotesDatabase, noteID As String, unid As String, bGuid As String, bHome As String, bMailFile As String, bMailNote As String, bOU As String, bPolicy As String, bGroups As String, bVault As String, bReplicas As String) As String
	Dim doc As NotesDocument, reg As NotesRegistration, u As BRUser
	Dim t0 As Double, issues As String, userPwd As String, mailFile As String
	Dim stage As String, emsg As String, homeCanon As String, nn As NotesName
	Dim foundOn As String, rl As Variant, ri As Integer, repOK As Boolean, nameProb As String, titleRes As String, aclRes As String, bkRes As String
	Dim paramDump As String
	t0 = Timer
	On Error GoTo ErrH

	stage = "load"
	' NoteID first; UNID as fallback (Excel can mangle hex NoteIDs such as 1E2)
	On Error Resume Next
	Set doc = db.GetDocumentByID(noteID)
	If doc Is Nothing And unid <> "" Then Set doc = db.GetDocumentByUNID(unid)
	Err = 0
	On Error GoTo ErrH
	If doc Is Nothing Then
		u.NoteID = noteID
		Call BR_Audit(u, gMode, "REGISTER", "SKIPPED", BR_Elapsed(t0), "Document no longer exists")
		BR_RegisterOne = "SKIP:gone"
		Exit Function
	End If
	Call BR_ReadUser(doc, u)

	' the batch row must still describe this AD user
	If u.GUID <> bGuid Then
		Call BR_Audit(u, gMode, "REGISTER", "SKIPPED", BR_Elapsed(t0), "objectGUID in batch (" & bGuid & ") does not match Person doc - rebuild the batch")
		BR_Log LVL_WARN, "SKIP objectGUID mismatch: " & u.FullNameBefore
		BR_RegisterOne = "SKIP:guid"
		Exit Function
	End If
	' reviewed values from the batch file are authoritative
	If (u.AutoHome = "" And bHome <> u.HomeServer) Or bOU <> u.OrgUnit Or bPolicy <> u.Policy Or bGroups <> u.Groups Then
		BR_Log LVL_INFO, "Batch override for " & u.FullNameBefore & ": home=" & bHome & " ou=" & bOU & " policy=" & bPolicy & " groups=" & bGroups
	End If
	u.HomeServer = bHome: u.AutoHome = "": u.OrgUnit = bOU: u.Policy = bPolicy: u.Groups = bGroups: u.VaultServer = bVault   ' the reviewed home server of the batch file is final
	If bMailFile <> "" Then u.MailFile = BR_Path(bMailFile)
	u.MailFileNote = bMailNote
	If bReplicas <> "*auto" Then
		u.ClusterReplicas = bReplicas                              ' reviewed list from the batch file
	Else
		u.ClusterReplicas = BR_ReplicaServers(u.HomeServer, u.ReplicaSpec)
	End If
	u.MapRule = "batch " & gBatchID

	' no Internet address: SKIPPED and flagged (SkipNoInternetAddress=1), never registered by mistake
	If u.InternetAddress = "" And CfgB("SkipNoInternetAddress", True) Then
		Call BR_Audit(u, gMode, "REGISTER", BR_RESULT_NO_INET, BR_Elapsed(t0), BR_SKIP_NO_INET)
		BR_Log LVL_WARN, "SKIP no InternetAddress: " & u.FullNameBefore
		BR_RegisterOne = "SKIP:noinet"
		Exit Function
	End If

	' idempotency: fresh re-check (someone may have registered it meanwhile)
	If BR_IsRegistered(doc) Then
		Call BR_Audit(u, gMode, "REGISTER", "SKIPPED", BR_Elapsed(t0), "Already has Certificate (registered)")
		BR_Log LVL_INFO, "SKIP already registered: " & u.FullNameBefore
		BR_RegisterOne = "SKIP:registered"
		Exit Function
	End If

	stage = "validate"
	issues = BR_Validate(u)
	If InStr(issues, "ERROR:") = 0 Then
		If Not BR_HomeServerOK(u.HomeServer, gSrvOK) Then
			issues = issues & "ERROR:HomeServer " & u.HomeServer & " unreachable; "
		Else
			foundOn = BR_MailFileExistsAny(u)        ' home server and every replica server
			If foundOn <> "" Then issues = issues & "ERROR:MailFile " & u.MailFile & " already exists on " & foundOn & "; "
		End If
		If u.ClusterReplicas <> "" Then
			rl = Split(u.ClusterReplicas, ",")
			For ri = 0 To UBound(rl)
				If Not BR_HomeServerOK(CStr(rl(ri)), gSrvOK) Then issues = issues & "WARN:Replica server " & rl(ri) & " unreachable now - AdminP will create the replica when it is back; "
			Next
		End If
	End If
	If InStr(issues, "ERROR:") > 0 Then
		Call BR_Audit(u, gMode, "REGISTER", "FAILED_VALIDATION", BR_Elapsed(t0), issues)
		BR_Log LVL_ERROR, "VALIDATION " & u.FullNameBefore & " : " & issues
		BR_RegisterOne = "FAIL:validation"
		Exit Function
	End If

	BR_Log LVL_DEBUG, "Prepared " & u.FullNameBefore & " noteid=" & u.NoteID & " guid=" & u.GUID & _
	" home=" & u.HomeServer & " ou=" & u.OrgUnit & " policy=" & u.Policy & " groups=" & u.Groups & _
	" map=" & u.MapRule & " mailfile=" & u.MailFile & " mailsys=" & u.MailSystemBefore & " idfile=" & u.IDFile

	' ---- checks a dry run CAN do without changing anything (the registration itself is not run) ----
	' the ID file folder must exist on THIS workstation (the ID file is written locally)
	If Not BR_DirWritable(StrLeftBack(u.IDFile, gSep) & gSep) Then issues = issues & "ERROR:ID file folder is missing or not writable: " & StrLeftBack(u.IDFile, gSep) & gSep & " (IDFileDir); "
	' a configured mail template must exist on the home server
	If CfgS("MailTemplate", "") <> "" Then
		If Not BR_MailFileExists(u.HomeServer, CfgS("MailTemplate", "")) Then issues = issues & "ERROR:Mail template " & CfgS("MailTemplate", "") & " not found on " & u.HomeServer & "; "
	End If
	If (Not CfgB("RegisterCreateMailDb", True) Or BR_MailDeferred()) And CfgS("MailTemplate", "") = "" Then issues = issues & "ERROR:RegisterCreateMailDb=0 / MailFileDeferred=1 needs MailTemplate (e.g. mail14.ntf) in bulkreg.ini; "
	If InStr(issues, "ERROR:") > 0 Then
		Call BR_Audit(u, gMode, "REGISTER", "FAILED_VALIDATION", BR_Elapsed(t0), issues)
		BR_Log LVL_ERROR, "VALIDATION " & u.FullNameBefore & " : " & issues
		BR_RegisterOne = "FAIL:validation"
		Exit Function
	End If

	If gMode = "DRYRUN" Then
		If u.ClusterReplicas = "" Then
			u.ReplicaStatus = "NONE"
		ElseIf CfgB("CreateClusterReplicas", True) Then
			u.ReplicaStatus = "WOULD_REQUEST " & BR_ListCount(u.ClusterReplicas) & " (" & u.ClusterReplicas & ")"
		Else
			u.ReplicaStatus = "OFF (CreateClusterReplicas=0)"
		End If
		u.FullNameAfter = BR_ExpectedName(u)               ' the name the user WOULD get, e.g. Neha Arora/Demo
		Call BR_Audit(u, gMode, "REGISTER", "WOULD_REGISTER", BR_Elapsed(t0), "Notes name: " & u.FullNameAfter & " | mail file title: " & BR_MailTitle(u) & BR_IIfStr(BR_MailDeferred(), " | mail file creation DEFERRED (agent 07)", "") & " " & issues)
		BR_Log LVL_INFO, "DRYRUN would register " & u.FullNameBefore & " as " & u.FullNameAfter & " -> " & u.HomeServer & " (" & u.Policy & ")"
		BR_RegisterOne = "OK:dryrun"
		Exit Function
	End If

	' ---------- build registration ----------
	stage = "configure"
	Set reg = New NotesRegistration
	reg.ContactNoteID = u.NoteID                       ' register the existing DirSync Person doc
	reg.RegistrationServer = CfgS("RegistrationServer", "")
	If CfgB("UseCA", True) Then
		reg.UseCertificateAuthority = True
		reg.CertifierName = BR_CertifierForReg()            ' "/Demo" or "/Sales/Demo" (see BR_CertifierForReg)
	Else
		reg.CertifierIDFile = BR_CfgFile("CertifierIDFile", "")
	End If
	' ---- Domino mail file: always created on the user's home server ----
	' 0 = BulkReg creates the mail file itself after the registration (needs MailTemplate)
	' MailFileDeferred=1 = no mail file now at all (fast registration); agent 07 creates it later
	reg.CreateMailDb = CfgB("RegisterCreateMailDb", True) And Not BR_MailDeferred()
	reg.MailSystem = REG_MAILSYSTEM_NOTES                ' HCL default, set explicitly: DirSync users had Other Internet Mail
	If CfgS("MailTemplate", "") <> "" Then reg.MailTemplateName = CfgS("MailTemplate", "")
	reg.MailACLManager = Trim$(StrLeft(BR_MailManagers() & ",", ","))   ' first manager; all of them are enforced after registration
	reg.MailOwnerAccess = BR_OwnerRegConst()                          ' owner = Editor by default (MailOwnerAccess); enforced after registration
	reg.MailCreateFTIndex = CfgB("MailCreateFTIndex", False)
	If CfgL("MailQuotaSizeLimit", 0) > 0 Then reg.MailQuotaSizeLimit = CfgL("MailQuotaSizeLimit", 0)
	If CfgL("MailQuotaWarningThreshold", 0) > 0 Then reg.MailQuotaWarningThreshold = CfgL("MailQuotaWarningThreshold", 0)
	reg.Expiration = Today + CfgL("ExpirationDays", 730)
	reg.IDType = ID_HIERARCHICAL
	reg.MinPasswordLength = CInt(CfgL("MinPasswordLength", 8))
	reg.IsNorthAmerican = CfgB("IsNorthAmerican", True)
	reg.OrgUnit = u.OrgUnit
	reg.RegistrationLog = CfgS("RegistrationLog", "certlog.nsf")   ' HCL: non-empty -> CERTLOG.NSF on the registration server
	reg.UpdateAddressBook = True
	reg.StoreIDInAddressBook = CfgB("StoreIDInAddressBook", False)
	reg.EnforceUniqueShortName = CfgB("EnforceUniqueShortName", True)
	reg.SynchInternetPassword = CfgB("SyncInternetPassword", False)
	If u.Policy <> "" Then reg.PolicyName = u.Policy
	If u.ShortName <> "" Then reg.ShortName = u.ShortName
	If u.InternetAddress <> "" Then reg.MailInternetAddress = u.InternetAddress
	If u.Groups <> "" Then reg.GroupList = Split(u.Groups, ",")

	' never overwrite an ID file left by an earlier (failed) attempt
	If Dir$(u.IDFile) <> "" Then
		BR_Log LVL_WARN, "ID file exists from a previous attempt, using new name: " & u.IDFile
		u.IDFile = Left$(u.IDFile, Len(u.IDFile) - 3) & "_" & gRunID & ".id"
	End If

	mailFile = BR_SrvPathFor(u.HomeServer, u.MailFile)    ' relative to the data directory (/local/notesdata on Linux), e.g. mail1/jsmith.nsf
	userPwd = BR_GenPassword(CInt(CfgL("InitialPasswordLength", 16)))

	' RegisterNewUser expects the CANONICAL server name (CN=DominoADMail/O=Demo)
	Set nn = New NotesName(u.HomeServer)
	homeCanon = nn.Canonical

	' ---------- register ----------
	' everything the registration receives - written to the debug log and, on failure, repeated in the error
	paramDump = "last='" & u.LastName & "' first='" & u.FirstName & "' mi='" & u.MiddleInitial & "' short='" & u.ShortName & "' inet='" & u.InternetAddress & "'" & _
	" | idfile=" & u.IDFile & " | server=" & homeCanon & " | mailfile=" & mailFile & " | ou='" & u.OrgUnit & "' certifier=" & BR_IIfStr(CfgB("UseCA", True), BR_CertifierForReg() & " (CA)", BR_CfgFile("CertifierIDFile", "")) & _
	" | policy='" & u.Policy & "' template='" & CfgS("MailTemplate", "") & "' regserver=" & CfgS("RegistrationServer", "") & " log=" & CfgS("RegistrationLog", "") & " serverOS=" & BR_ServerOS(u.HomeServer)
	BR_Log LVL_INFO, "REGISTER " & u.FullNameBefore & " -> " & u.HomeServer
	BR_Log LVL_INFO, "Registration parameters: " & paramDump
	stage = "RegisterNewUser"
	Call reg.RegisterNewUser(u.LastName, u.IDFile, homeCanon, u.FirstName, u.MiddleInitial, _
	gCertPwd, "", "BulkReg " & gRunID & " objectGUID=" & u.GUID, mailFile, "", userPwd, NOTES_DESKTOP_CLIENT)

	' ---------- verify ----------
	stage = "verify"
	Delete doc
	Set doc = db.GetDocumentByID(u.NoteID)
	If doc Is Nothing Then Error 4001, "Person document not found after registration"
	u.FullNameAfter = BR_Item(doc, "FullName")
	u.MailSystemAfter = BR_Item(doc, "MailSystem")
	If Not BR_IsRegistered(doc) Then Error 4002, "RegisterNewUser returned but Person doc has no Certificate"
	' the Notes name must be the generated CN + OU/Org (organization once) - stop the whole run at the first wrong name
	nameProb = BR_CnProblem(u.FullNameAfter, u)
	If nameProb = "" Then nameProb = BR_NameProblem(u.FullNameAfter, u)
	If nameProb <> "" Then
		gStopRun = "Wrong Notes name created - run stopped so no further users get it: " & nameProb & ". Check CertifierName and OrgUnit (guide D6)."
		Call BR_Audit(u, gMode, "REGISTER", "REGISTERED_WRONG_NAME", BR_Elapsed(t0), nameProb)
		BR_Log LVL_ERROR, "WRONG NAME " & nameProb
		BR_RegisterOne = "FAIL:name"
		Exit Function
	End If

	' ---------- backup copy of the generated last name (LastNameBackupField, default Location) ----------
	' only after the name is verified, so a wrongly named user gets no backup
	stage = "lastname backup"
	bkRes = BR_StoreLastNameBackup(doc, u)
	If bkRes <> "" Then
		u.MailFileNote = u.MailFileNote & BR_IIfStr(u.MailFileNote <> "", "; ", "") & bkRes
		BR_Log BR_IIfInt2(Left$(bkRes, 9) = "BACKUP_OK", LVL_INFO, LVL_WARN), bkRes
	End If

	' ---------- RegisterCreateMailDb=0: BulkReg creates the mail file itself ----------
	If Not CfgB("RegisterCreateMailDb", True) Or BR_MailDeferred() Then
		If BR_MailDeferred() Then
			' MailFileDeferred=1: the Person document gets the mail file pointer now, the file itself is created later by 07
			u.MailFileNote = u.MailFileNote & BR_IIfStr(u.MailFileNote <> "", "; ", "") & "MAIL_DEFERRED (create with 07 - Create Mail Files)"
			BR_Log LVL_INFO, "Mail file " & u.HomeServer & "!!" & u.MailFile & " : creation deferred"
		Else
			stage = "createmail"
			titleRes = BR_CreateMailFile(u.HomeServer, u.MailFile, CfgS("MailTemplate", ""), BR_MailTitle(u))
			u.MailFileNote = u.MailFileNote & BR_IIfStr(u.MailFileNote <> "", "; ", "") & titleRes
			BR_Log BR_IIfInt2(Left$(titleRes, 12) = "MAIL_CREATED", LVL_INFO, LVL_ERROR), "Mail file " & u.HomeServer & "!!" & u.MailFile & " : " & titleRes
		End If
		' the Person document must point at the mail file
		If BR_Item(doc, "MailFile") = "" Then
			Call doc.ReplaceItemValue("MailFile", BR_SrvPathFor(u.HomeServer, u.MailFile))
			Call doc.ReplaceItemValue("MailServer", homeCanon)
			Call doc.ReplaceItemValue("MailSystem", "1")
			Call doc.Save(True, False)
		End If
	End If

	' ---------- mail file ----------
	stage = "mailfile"
	BR_Log LVL_INFO, "Mail: system '" & u.MailSystemBefore & "' -> '" & u.MailSystemAfter & "', MailFile in Person doc: " & BR_Item(doc, "MailFile")
	If BR_MailDeferred() Then
		u.MailFileStatus = "MAILFILE_DEFERRED"     ' by design: 07 - Create Mail Files creates it (title, ACL, replicas)
	ElseIf BR_MailFileExists(u.HomeServer, u.MailFile) Then
		u.MailFileStatus = "MAILFILE_OK"
		' database title of the mail file (e.g. "Neha Arora") - set BEFORE the replicas are requested
		titleRes = BR_MailTitleFix(u.HomeServer, u.MailFile, BR_MailTitle(u), True, CfgB("MailFileTitleOverwrite", False))
		u.MailFileNote = u.MailFileNote & BR_IIfStr(u.MailFileNote <> "", "; ", "") & titleRes & " '" & BR_MailTitle(u) & "'"
		If Left$(titleRes, 11) = "TITLE_ERROR" Then BR_Log LVL_WARN, "Mail file title not set for " & u.MailFile & ": " & titleRes
		' Manager access for the admin ID / MailACLManager - BEFORE the replicas (they copy the ACL)
		aclRes = BR_MailAclFix(u.HomeServer, u.MailFile, u.FullNameAfter, True)
		u.MailFileNote = u.MailFileNote & "; " & aclRes
		If Left$(aclRes, 9) = "ACL_ERROR" Then BR_Log LVL_WARN, "Mail file managers not set for " & u.MailFile & ": " & aclRes Else BR_Log LVL_INFO, "Mail file managers " & u.MailFile & ": " & aclRes
	Else
		u.MailFileStatus = "MAILFILE_PENDING"       ' may still be created in the background - re-check with Agent 04
	End If

	' ---------- cluster replicas (AdminP "Create Replica" per replica server) ----------
	stage = "replicas"
	If u.ClusterReplicas = "" Then
		u.ReplicaStatus = "NONE"
	ElseIf Not CfgB("CreateClusterReplicas", True) Then
		u.ReplicaStatus = "NOT_REQUESTED (CreateClusterReplicas=0)"
	ElseIf u.MailFileStatus = "MAILFILE_DEFERRED" Then
		u.ReplicaStatus = "DEFERRED (requested by 07 - Create Mail Files)"
	ElseIf u.MailFileStatus <> "MAILFILE_OK" Then
		u.ReplicaStatus = "NOT_REQUESTED (mail file not yet on home server - create the replicas manually, guide C7)"
	Else
		u.ReplicaStatus = BR_RequestReplicas(u)
	End If

	stage = "vault"
	If CfgB("VaultCheckAfterReg", True) Then u.VaultStatus = BR_VaultStatus(u.FullNameAfter, u.VaultServer) Else u.VaultStatus = "NOT_CHECKED"

	If gPwFile <> "" Then
		Call BR_AppendLine(gPwFile, Q(gBatchID) & "," & Q(u.FullNameAfter) & "," & Q(u.InternetAddress) & "," & Q(u.IDFile) & "," & Q(userPwd))
	End If
	userPwd = ""

	' replicas are fine when none are needed, switched off, or all requests were posted
	If u.ReplicaStatus = "NONE" Or InStr(u.ReplicaStatus, "CreateClusterReplicas=0") > 0 Or Left$(u.ReplicaStatus, 8) = "DEFERRED" Then
		repOK = True
	ElseIf Left$(u.ReplicaStatus, 10) = "REQUESTED " And InStr(u.ReplicaStatus, "FAILED") = 0 Then
		repOK = True
	End If
	If (u.VaultStatus = "IN_VAULT" Or u.VaultStatus = "NOT_CHECKED") And (u.MailFileStatus = "MAILFILE_OK" Or u.MailFileStatus = "MAILFILE_DEFERRED") And repOK Then
		Call BR_Audit(u, gMode, "REGISTER", "REGISTERED", BR_Elapsed(t0), issues & BR_IIfStr(u.MailFileStatus = "MAILFILE_DEFERRED", " Mail file NOT created yet - run 07 - Create Mail Files.", ""))
		BR_Log LVL_INFO, "OK " & u.FullNameAfter & " vault=" & u.VaultStatus & " (" & Format$(BR_Elapsed(t0), "0.0") & "s)"
	Else
		Call BR_Audit(u, gMode, "REGISTER", "REGISTERED_PENDING", BR_Elapsed(t0), issues & " Vault: " & u.VaultStatus & " Mail file: " & u.MailFileStatus & " Replicas: " & u.ReplicaStatus & " - re-check with Agent 04")
		BR_Log LVL_WARN, "REGISTERED but vault=" & u.VaultStatus & " mailfile=" & u.MailFileStatus & " replicas=" & u.ReplicaStatus & " : " & u.FullNameAfter & " (re-run Agent 04)"
	End If
	BR_RegisterOne = "OK"
	Exit Function

ErrH:
	userPwd = ""
	emsg = "stage=" & stage & " err=" & Err & " " & Error$ & " (line " & Erl & ")"
	If stage = "RegisterNewUser" Then emsg = emsg & " | parameters: " & paramDump
	BR_Log LVL_ERROR, "FAIL " & u.FullNameBefore & " : " & emsg
	Call BR_Audit(u, gMode, "REGISTER", "FAILED", BR_Elapsed(t0), emsg)
	BR_RegisterOne = "FAIL:" & stage
	Exit Function
End Function

' Creates the mail file from the mail template on the home server (RegisterCreateMailDb=0).
' Returns MAIL_CREATED or MAIL_CREATE_ERROR(...)
Function BR_CreateMailFile(server As String, path As String, tmplName As String, title As String) As String
	On Error GoTo ErrH
	Dim tmpl As NotesDatabase, mdb As NotesDatabase
	If BR_MailFileExists(server, path) Then
		BR_CreateMailFile = "MAIL_CREATED (already existed)"
		Exit Function
	End If
	Set tmpl = gSession.GetDatabase(server, tmplName, False)
	If Not tmpl.IsOpen Then Call tmpl.Open("", "")
	If Not tmpl.IsOpen Then
		BR_CreateMailFile = "MAIL_CREATE_ERROR(template " & tmplName & " not found on " & server & ")"
		Exit Function
	End If
	Set mdb = tmpl.CreateFromTemplate(server, BR_SrvPathFor(server, path), True)
	If title <> "" Then mdb.Title = title
	BR_CreateMailFile = "MAIL_CREATED"
	Exit Function
ErrH:
	BR_CreateMailFile = "MAIL_CREATE_ERROR(" & Error$ & " err " & Err & ")"
	Exit Function
End Function

Function BR_CertText() As String
	If CfgB("UseCA", True) Then
		BR_CertText = "Domino CA - " & CfgS("CertifierName", "")
	Else
		BR_CertText = "Certifier ID - " & CfgS("CertifierIDFile", "")
	End If
End Function

Function BR_IIfS(c As Boolean, a As Variant, b As Variant) As Variant
	If c Then BR_IIfS = a Else BR_IIfS = b
End Function

'=====================================================================
' BR_RunVerify  -  runs agent BulkReg\04 - Verify Registration and Vault
'   The agent itself only contains:  Call BR_RunVerify()
'
' Scope (asked at start):
'   a batch file  -> verifies only the Include=Y users of BATCH-<id>.csv and
'                    writes <BatchDir>\BATCH-<id>_verify_<run>.csv
'   blank         -> verifies every DirSync user (objectGUID present)
' Status per user: UNREGISTERED | REGISTERED + IN_VAULT | REGISTERED + NOT_IN_VAULT
'                  + MailFileStatus MAILFILE_OK | MAILFILE_MISSING | NO_MAILFILE_IN_PERSON_DOC
'                  | CHECK_ERROR | NOT_FOUND
'                  + ReplicaStatus REPLICAS_OK n/n | REPLICAS_MISSING k/n (missing: ...) | NONE
'                    (a replica = same replica ID on the other mail cluster member)
' Run it after each batch and before deleting local ID files.
'=====================================================================
Sub BR_RunVerify()
	On Error GoTo ErrH
	' library variables keep their value between runs in the same client session - reset them
	gVUnreg = 0: gVInV = 0: gVNotV = 0: gVErr = 0: gVGone = 0: gVMailBad = 0: gVRepBad = 0
	gVNameBad = 0: gVTitleBad = 0: gVAclBad = 0
	Erase gVTitles
	Erase gVAcls
	Dim ws As NotesUIWorkspace, ans As Variant
	Dim db As NotesDatabase, col As NotesDocumentCollection, doc As NotesDocument
	Dim scopeFile As String, bname As String, fh As Integer, txt As String
	Dim cols List As Integer, delim As String, parts As Variant, isFirst As Boolean, nid As String, rep As String
	Dim summary As String, total As Long, nSet As Long, tr As String, nAcl As Long

	If Not BR_Init("Verify") Then Exit Sub
	Set ws = New NotesUIWorkspace
	ans = ws.Prompt(PROMPT_OKCANCELEDIT, "BulkReg - Verify", _
	"Verify one batch: enter the batch file path." & Chr$(10) & _
	"Verify all DirSync users: leave empty.", BR_LatestBatch())
	If IsEmpty(ans) Then
		BR_Close "Cancelled"
		Exit Sub
	End If
	scopeFile = BR_Path(Trim$(CStr(ans)))
	Set db = BR_OpenDirectory()

	If scopeFile <> "" Then
		' ---------- one batch ----------
		If Dir$(scopeFile) = "" Then Error 7001, "Batch file not found: " & scopeFile
		bname = StrRightBack(scopeFile, "\")
		If Left$(bname, 6) <> "BATCH-" Or InStr(bname, "_") > 0 Then Error 7002, "Choose the batch file itself (BATCH-<id>.csv): " & bname
		gBatchID = Left$(bname, Len(bname) - 4)
		gResultsFile = BR_BatchDir() & gBatchID & "_verify_" & gRunID & ".csv"
		Call BR_AppendLine(gResultsFile, Uchr$(&HFEFF) & BR_AuditHeader())
		fh = FreeFile()
		Open scopeFile For Input As #fh Charset = "UTF-8"
		isFirst = True
		Do Until EOF(fh)
			Line Input #fh, txt
			If isFirst Then
				Call BR_CsvHeader(txt, delim, cols)
				isFirst = False
			ElseIf Trim$(txt) <> "" Then
				parts = BR_CsvSplit(txt, delim)
				If UCase$(BR_CsvGet(parts, cols, "Include")) = "Y" Then
					nid = BR_CsvGet(parts, cols, "NoteID")
					If IsElement(cols("clusterreplicas")) Then rep = BR_CsvGet(parts, cols, "ClusterReplicas") Else rep = "*auto"
					total = total + 1
					Set doc = Nothing
					On Error Resume Next
					Set doc = db.GetDocumentByID(nid)
					On Error GoTo ErrH
					Call BR_VerifyDoc(doc, nid, rep)
				End If
			End If
		Loop
		Close #fh
	Else
		' ---------- all DirSync users ----------
		Set col = BR_GetCandidates(db, False)
		Set doc = col.GetFirstDocument()
		Do While Not (doc Is Nothing)
			total = total + 1
			Call BR_VerifyDoc(doc, CStr(doc.NoteID), "*auto")
			Set doc = col.GetNextDocument(doc)
		Loop
	End If

	summary = BR_IIfStr(gBatchID = "", "All DirSync users", gBatchID) & ": checked=" & total & " | registered+in vault=" & gVInV & _
	" | registered NOT in vault=" & gVNotV & " | unregistered=" & gVUnreg & " | check errors=" & gVErr & " | not found=" & gVGone & " | mail file missing=" & gVMailBad & " | replicas missing=" & gVRepBad & _
	" | wrong Notes name=" & gVNameBad & " | mail file title empty=" & gVTitleBad & " | mail file ACL not standard=" & gVAclBad

	' optional fix: set the missing mail file titles (asks first; only the title is changed)
	If gVTitleBad > 0 Then
		ans = ws.Prompt(PROMPT_YESNO, "BulkReg - Verify", gVTitleBad & " mail file(s) have no database title." & Chr$(10) & Chr$(10) & _
		"Set the title now (" & CfgS("MailFileTitle", "{CN}") & ", e.g. 'Neha Arora')?" & Chr$(10) & "Nothing else is changed.")
		If ans = 1 Then
			ForAll tt In gVTitles
				tr = BR_MailTitleFix(StrLeft(ListTag(tt), "!!"), StrRight(ListTag(tt), "!!"), CStr(tt), True, False)
				If tr = "TITLE_SET" Then nSet = nSet + 1
				BR_Log BR_IIfInt2(tr = "TITLE_SET", LVL_INFO, LVL_WARN), "Mail file title " & ListTag(tt) & " -> '" & tt & "': " & tr
			End ForAll
			summary = summary & " | titles set now=" & nSet
		End If
	End If
	' optional fix: add the missing mail file managers (asks first; only the ACL entries are added)
	If gVAclBad > 0 Then
		ans = ws.Prompt(PROMPT_YESNO, "BulkReg - Verify", gVAclBad & " mail file(s) have an ACL that differs from the BulkReg standard:" & Chr$(10) & _
		"  managers (Manager + Delete documents): " & BR_MailManagers() & Chr$(10) & _
		"  owner (the user): " & BR_LevelText(BR_OwnerLevel()) & " + Delete documents" & Chr$(10) & Chr$(10) & _
		"Correct these ACL entries now?" & Chr$(10) & "Nothing else is changed.")
		If ans = 1 Then
			ForAll ta In gVAcls
				tr = BR_MailAclFix(StrLeft(ListTag(ta), "!!"), StrRight(ListTag(ta), "!!"), CStr(ta), True)
				If Left$(tr, 7) = "ACL_SET" Then nAcl = nAcl + 1
				BR_Log BR_IIfInt2(Left$(tr, 7) = "ACL_SET", LVL_INFO, LVL_WARN), "Mail file managers " & ListTag(ta) & ": " & tr
			End ForAll
			summary = summary & " | ACLs corrected now=" & nAcl
		End If
	End If
	BR_Close summary
	BR_Msg summary & Chr$(10) & Chr$(10) & "Report: " & BR_IIfStr(gResultsFile <> "", gResultsFile, gAuditFile), _
	CInt(BR_IIfStr(gVNotV + gVErr + gVGone + gVMailBad + gVRepBad + gVNameBad > 0, "48", "64"))
	Exit Sub
ErrH:
	BR_Log LVL_ERROR, "Verify aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	BR_Close "ABORTED"
	BR_Msg "Verify aborted: " & Error$, 16
	Exit Sub
End Sub

' rep = replica servers from the batch file, or "*auto" = other members of the
'       mail cluster of the user's mail server (MailClusterServers)
Sub BR_VerifyDoc(doc As NotesDocument, nid As String, rep As String)
	Dim u As BRUser, t0 As Double, res As String, nmProb As String, tRes As String, aRes As String
	t0 = Timer
	If doc Is Nothing Then
		u.NoteID = nid
		gVGone = gVGone + 1
		Call BR_Audit(u, "VERIFY", "STATUS", "NOT_FOUND", BR_Elapsed(t0), "Person document no longer exists")
		Exit Sub
	End If
	Call BR_ReadUser(doc, u)
	u.FullNameAfter = u.FullNameBefore
	u.MailSystemAfter = u.MailSystemBefore
	If Not BR_IsRegistered(doc) Then
		res = "UNREGISTERED": gVUnreg = gVUnreg + 1
		u.VaultStatus = "N/A"
	Else
		u.VaultStatus = BR_VaultStatus(u.FullNameBefore, u.VaultServer)
		' mail file named in the Person document must exist on the user's mail server
		u.MailFile = BR_Item(doc, "MailFile")
		If u.MailFile = "" Then
			u.MailFileStatus = "NO_MAILFILE_IN_PERSON_DOC"
		ElseIf BR_MailFileExists(BR_Item(doc, "MailServer"), u.MailFile) Then
			u.MailFileStatus = "MAILFILE_OK"
		Else
			u.MailFileStatus = "MAILFILE_MISSING"
		End If
		If u.MailFileStatus <> "MAILFILE_OK" Then gVMailBad = gVMailBad + 1
		' Notes name hierarchy and mail file title
		nmProb = BR_NameProblem(u.FullNameBefore, u)
		If nmProb <> "" Then gVNameBad = gVNameBad + 1
		If u.MailFileStatus = "MAILFILE_OK" Then
			tRes = BR_MailTitleFix(BR_Item(doc, "MailServer"), u.MailFile, BR_MailTitle(u), False, False)
			If tRes = "TITLE_EMPTY" Then
				gVTitleBad = gVTitleBad + 1
				gVTitles(BR_Item(doc, "MailServer") & "!!" & u.MailFile) = BR_MailTitle(u)
			End If
			aRes = BR_MailAclFix(BR_Item(doc, "MailServer"), u.MailFile, u.FullNameBefore, False)
			If Left$(aRes, 11) = "ACL_MISSING" Then
				gVAclBad = gVAclBad + 1
				gVAcls(BR_Item(doc, "MailServer") & "!!" & u.MailFile) = u.FullNameBefore      ' owner, used by the fix below
			End If
		End If
		' cluster replicas of the mail file
		u.HomeServer = BR_SrvAbbr(BR_Item(doc, "MailServer"))
		If rep = "*auto" Then u.ClusterReplicas = BR_ReplicaServers(u.HomeServer, "") Else u.ClusterReplicas = BR_SrvList(rep, u.HomeServer)
		If u.MailFileStatus = "MAILFILE_OK" Then
			u.ReplicaStatus = BR_CheckReplicas(u.HomeServer, u.MailFile, u.ClusterReplicas)
		ElseIf u.ClusterReplicas <> "" Then
			u.ReplicaStatus = "NOT_CHECKED (no mail file on home server)"
		Else
			u.ReplicaStatus = "NONE"
		End If
		If u.ReplicaStatus <> "NONE" And Left$(u.ReplicaStatus, 11) <> "REPLICAS_OK" Then gVRepBad = gVRepBad + 1
		Select Case Left$(u.VaultStatus, 5)
		Case "IN_VA": res = "REGISTERED": gVInV = gVInV + 1
		Case "NOT_I": res = "REGISTERED": gVNotV = gVNotV + 1
		Case Else: res = "CHECK_ERROR": gVErr = gVErr + 1
		End Select
	End If
	Call BR_Audit(u, "VERIFY", "STATUS", res, BR_Elapsed(t0), BR_IIfStr(res = "UNREGISTERED" And u.InternetAddress = "", "no InternetAddress - " & BR_IIfStr(CfgB("SkipNoInternetAddress", True), "skipped until the address exists in AD", "will be registered without address"), "") & _
	BR_IIfStr(nmProb <> "", " WRONG NAME: " & nmProb, "") & BR_IIfStr(tRes <> "", " mail file " & tRes, "") & BR_IIfStr(aRes <> "", " " & aRes, "") & _
	BR_IIfStr(u.MailFileStatus <> "" And u.MailFileStatus <> "MAILFILE_OK", " MAIL FILE NOT FOUND: Person doc MailServer='" & BR_Item(doc, "MailServer") & "' MailFile='" & u.MailFile & "' (tried as '" & BR_SrvPathFor(BR_Item(doc, "MailServer"), u.MailFile) & "'). " & BR_IIfStr(BR_MailDeferred(), "MailFileDeferred=1: run 07 - Create Mail Files, then re-run Verify.", "The mail file is created by AdminP on the mail server after registration: check admin4.nsf / the server console for 'Create Mail File' errors, then re-run Verify."), ""))
	BR_Log LVL_DEBUG, res & " " & u.FullNameBefore & " vault=" & u.VaultStatus & " mail=" & u.MailFileStatus & " replicas=" & u.ReplicaStatus
End Sub

' Newest batch file (open or done) as the default scope
Function BR_LatestBatch() As String
	Dim d As String, f As String, best As String
	d = BR_BatchDir()
	f = Dir$(d & "BATCH-*.csv")
	Do While f <> ""
		If InStr(f, "_") = 0 And f > best Then best = f
		f = Dir$()
	Loop
	If best <> "" Then BR_LatestBatch = d & best
End Function

'=====================================================================
' BR_RunCreateMailFiles  -  runs agent BulkReg\07 - Create Mail Files
'   The agent itself only contains:  Call BR_RunCreateMailFiles()
'
' Second phase of the fast registration (MailFileDeferred=1): 03 - Register Batch registers the user and
' points the Person document at the mail file but does NOT create it. This agent creates the missing mail
' files from MailTemplate on each user's mail server, then sets the title, the ACL (MailACLManager + owner)
' and requests the cluster replicas - the same steps 03 does when the mail file is created inline.
'
' Scope (asked at start): a batch file (only its Include=Y users) or blank = every registered DirSync user.
' Only users whose Person document names a mail file that does NOT exist yet are touched; existing mail
' files are never changed (idempotent - run it as often as needed). Honors DryRun (1 = report only).
' Run it right after each 03 - Register Batch: until the mail file exists, mail for that user cannot be
' delivered. It can run in a second Notes client while the next batch is being registered.
'=====================================================================
Sub BR_RunCreateMailFiles()
	On Error GoTo ErrH
	gMode = "": gStopRun = ""
	Dim ws As NotesUIWorkspace, ans As Variant
	Dim db As NotesDatabase, col As NotesDocumentCollection, doc As NotesDocument
	Dim scopeFile As String, bname As String, fh As Integer, txt As String
	Dim cols List As Integer, delim As String, parts As Variant, isFirst As Boolean, nid As String, rep As String
	Dim total As Long, nMade As Long, nExist As Long, nFail As Long, nSkip As Long, nConsec As Long
	Dim maxConsec As Long, pauseMs As Long, maxPer As Long, res As String, summary As String, stopReason As String

	If Not BR_Init("CreateMail") Then Exit Sub
	If CfgB("DryRun", True) Then gMode = "DRYRUN" Else gMode = "LIVE"
	maxConsec = CfgL("MaxConsecutiveErrors", 5)
	pauseMs = CfgL("PauseMs", 500)
	maxPer = CfgL("MailCreateMaxPerRun", 0)            ' 0 = no limit
	If Trim$(CfgS("MailTemplate", "")) = "" Then
		BR_Close "MailTemplate missing"
		BR_Msg "MailTemplate (e.g. mail145.ntf) is required in bulkreg.ini to create mail files.", 16
		Exit Sub
	End If

	Set ws = New NotesUIWorkspace
	ans = ws.Prompt(PROMPT_OKCANCELEDIT, "BulkReg - Create mail files (" & gMode & ")", _
	"Create the missing mail files of ONE batch: enter the batch file path." & Chr$(10) & _
	"All registered DirSync users: leave empty.", BR_LatestBatch())
	If IsEmpty(ans) Then
		BR_Close "Cancelled"
		Exit Sub
	End If
	scopeFile = BR_LocalPath(Trim$(CStr(ans)))
	If CInt(ws.Prompt(PROMPT_YESNO, "BulkReg - " & gMode, "Mode: " & BR_IIfStr(gMode = "LIVE", "LIVE - mail files WILL be created (template " & CfgS("MailTemplate", "") & ")", "DRY RUN (DryRun=1) - report only, NOTHING is created") & Chr$(10) & _
	"Scope: " & BR_IIfStr(scopeFile = "", "all registered DirSync users", scopeFile) & Chr$(10) & _
	"Limit per run: " & BR_IIfStr(maxPer > 0, CStr(maxPer), "none") & Chr$(10) & Chr$(10) & "Continue?")) <> 1 Then
		BR_Close "Cancelled by operator"
		Exit Sub
	End If
	gResultsFile = BR_BatchDir() & BR_IIfStr(scopeFile = "", "ALL", Left$(StrRightBack(scopeFile, gSep), Len(StrRightBack(scopeFile, gSep)) - 4)) & "_mailcreate_" & gMode & "_" & gRunID & ".csv"
	Call BR_AppendLine(gResultsFile, Uchr$(&HFEFF) & BR_AuditHeader())
	Set db = BR_OpenDirectory()

	If scopeFile <> "" Then
		If Dir$(scopeFile) = "" Then Error 8001, "Batch file not found: " & scopeFile
		bname = StrRightBack(scopeFile, gSep)
		If Left$(bname, 6) <> "BATCH-" Or InStr(bname, "_") > 0 Then Error 8002, "Choose the batch file itself (BATCH-<id>.csv): " & bname
		gBatchID = Left$(bname, Len(bname) - 4)
		fh = FreeFile()
		Open scopeFile For Input As #fh Charset = "UTF-8"
		isFirst = True
		Do Until EOF(fh)
			Line Input #fh, txt
			If isFirst Then
				Call BR_CsvHeader(txt, delim, cols)
				isFirst = False
			ElseIf Trim$(txt) <> "" Then
				parts = BR_CsvSplit(txt, delim)
				If UCase$(BR_CsvGet(parts, cols, "Include")) = "Y" Then
					nid = BR_CsvGet(parts, cols, "NoteID")
					If IsElement(cols("clusterreplicas")) Then rep = BR_CsvGet(parts, cols, "ClusterReplicas") Else rep = "*auto"
					total = total + 1
					Set doc = Nothing
					On Error Resume Next
					Set doc = db.GetDocumentByID(nid)
					Err = 0
					On Error GoTo ErrH
					res = BR_CreateMailOne(doc, nid, rep)
					stopReason = BR_MailTally(res, nMade, nExist, nSkip, nFail, nConsec, maxConsec, maxPer, pauseMs)
					If stopReason <> "" Then Exit Do
				End If
			End If
		Loop
		Close #fh
	Else
		Set col = BR_GetCandidates(db, False)
		Set doc = col.GetFirstDocument()
		Do While Not (doc Is Nothing)
			total = total + 1
			res = BR_CreateMailOne(doc, CStr(doc.NoteID), "*auto")
			stopReason = BR_MailTally(res, nMade, nExist, nSkip, nFail, nConsec, maxConsec, maxPer, pauseMs)
			If stopReason <> "" Then Exit Do
			Set doc = col.GetNextDocument(doc)
		Loop
	End If
	If stopReason = "" Then stopReason = "All users in scope processed"
	summary = gMode & " | " & BR_IIfStr(gBatchID = "", "All DirSync users", gBatchID) & " | checked=" & total & " created/would create=" & nMade & " already existed=" & nExist & " failed=" & nFail & " skipped=" & nSkip & " | " & stopReason
	BR_Close summary
	BR_Msg summary & Chr$(10) & Chr$(10) & "Report: " & gResultsFile & Chr$(10) & "Log: " & gDebugFile & Chr$(10) & Chr$(10) & _
	BR_IIfStr(gMode = "LIVE", "Cluster replicas are created by AdminP over the next minutes/hours. Run 04 - Verify Registration and Vault next.", "Dry run only. Set DryRun=0 to create the mail files."), _
	CInt(BR_IIfStr(nFail > 0, "48", "64"))
	Exit Sub

ErrH:
	BR_Log LVL_ERROR, "Create mail files aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	BR_Close "ABORTED"
	BR_Msg "Create mail files aborted: " & Error$ & Chr$(10) & "See " & gDebugFile, 16
	Exit Sub
End Sub

' Counts one result of BR_CreateMailOne (counters are passed by reference) and returns a stop reason,
' or "" to continue. Pauses between created mail files.
Function BR_MailTally(res As String, nMade As Long, nExist As Long, nSkip As Long, nFail As Long, nConsec As Long, maxConsec As Long, maxPer As Long, pauseMs As Long) As String
	Select Case Left$(res, 2)
	Case "OK": nMade = nMade + 1: nConsec = 0
	Case "EX": nExist = nExist + 1: nConsec = 0
	Case "SK": nSkip = nSkip + 1
	Case Else: nFail = nFail + 1: nConsec = nConsec + 1
	End Select
	If nConsec >= maxConsec Then
		BR_MailTally = "Circuit breaker: " & nConsec & " consecutive failures"
		BR_Log LVL_ERROR, BR_MailTally
	ElseIf maxPer > 0 And nMade >= maxPer Then
		BR_MailTally = "MailCreateMaxPerRun (" & maxPer & ") reached - run again for the rest"
		BR_Log LVL_INFO, BR_MailTally
	ElseIf pauseMs > 0 And Left$(res, 2) = "OK" Then
		Sleep pauseMs / 1000
	End If
End Function

' One user. Returns OK... (created / would create), EXISTS, SKIP... or FAIL...
Function BR_CreateMailOne(doc As NotesDocument, nid As String, rep As String) As String
	Dim u As BRUser, t0 As Double, srv As String, cr As String, tRes As String, aRes As String, note As String
	t0 = Timer
	On Error GoTo ErrH
	If doc Is Nothing Then
		u.NoteID = nid
		Call BR_Audit(u, gMode, "CREATE_MAIL", "NOT_FOUND", BR_Elapsed(t0), "Person document no longer exists")
		BR_CreateMailOne = "SKIP:gone"
		Exit Function
	End If
	Call BR_ReadUser(doc, u)
	u.FullNameAfter = u.FullNameBefore
	If Not BR_IsRegistered(doc) Then
		Call BR_Audit(u, gMode, "CREATE_MAIL", "SKIPPED", BR_Elapsed(t0), "Not registered yet")
		BR_CreateMailOne = "SKIP:unregistered"
		Exit Function
	End If
	' the Person document is authoritative: 03 wrote MailServer + MailFile there
	u.MailFile = BR_Path(BR_Item(doc, "MailFile"))
	srv = BR_SrvAbbr(BR_Item(doc, "MailServer"))
	u.HomeServer = srv
	If u.MailFile = "" Or srv = "" Then
		u.MailFileStatus = "NO_MAILFILE_IN_PERSON_DOC"
		Call BR_Audit(u, gMode, "CREATE_MAIL", "SKIPPED", BR_Elapsed(t0), "Person document has no MailServer/MailFile")
		BR_CreateMailOne = "SKIP:nomail"
		Exit Function
	End If
	If BR_MailFileExists(srv, u.MailFile) Then
		u.MailFileStatus = "MAILFILE_OK"
		Call BR_Audit(u, gMode, "CREATE_MAIL", "MAIL_EXISTS", BR_Elapsed(t0), "Mail file already exists - not touched")
		BR_CreateMailOne = "EXISTS"
		Exit Function
	End If
	If rep = "*auto" Then cr = BR_ReplicaServers(srv, u.ReplicaSpec) Else cr = BR_SrvList(rep, srv)
	u.ClusterReplicas = cr
	u.MailFileStatus = "MAILFILE_MISSING"
	If gMode = "DRYRUN" Then
		u.ReplicaStatus = BR_IIfStr(cr = "", "NONE", "WOULD_REQUEST " & BR_ListCount(cr) & " (" & cr & ")")
		Call BR_Audit(u, gMode, "CREATE_MAIL", "WOULD_CREATE", BR_Elapsed(t0), "Would create " & srv & "!!" & u.MailFile & " from " & CfgS("MailTemplate", "") & ", title '" & BR_MailTitle(u) & "'")
		BR_CreateMailOne = "OK:dryrun"
		Exit Function
	End If

	' ---- LIVE ----
	tRes = BR_CreateMailFile(srv, u.MailFile, CfgS("MailTemplate", ""), BR_MailTitle(u))
	If Left$(tRes, 12) <> "MAIL_CREATED" Then
		u.ReplicaStatus = "NOT_REQUESTED (mail file not created)"
		Call BR_Audit(u, gMode, "CREATE_MAIL", "FAILED", BR_Elapsed(t0), tRes)
		BR_Log LVL_ERROR, "Mail file " & srv & "!!" & u.MailFile & " : " & tRes
		BR_CreateMailOne = "FAIL:create"
		Exit Function
	End If
	u.MailFileStatus = "MAILFILE_OK"
	note = tRes
	tRes = BR_MailTitleFix(srv, u.MailFile, BR_MailTitle(u), True, CfgB("MailFileTitleOverwrite", False))
	note = note & "; " & tRes
	' managers + owner BEFORE the replicas (they copy the ACL)
	aRes = BR_MailAclFix(srv, u.MailFile, u.FullNameAfter, True)
	note = note & "; " & aRes
	If Left$(aRes, 9) = "ACL_ERROR" Then BR_Log LVL_WARN, "Mail file managers not set for " & u.MailFile & ": " & aRes
	If cr = "" Then
		u.ReplicaStatus = "NONE"
	ElseIf Not CfgB("CreateClusterReplicas", True) Then
		u.ReplicaStatus = "NOT_REQUESTED (CreateClusterReplicas=0)"
	Else
		u.ReplicaStatus = BR_RequestReplicas(u)
	End If
	u.MailFileNote = note
	If Left$(aRes, 9) = "ACL_ERROR" Or Left$(tRes, 11) = "TITLE_ERROR" Or InStr(u.ReplicaStatus, "FAILED") > 0 Then
		Call BR_Audit(u, gMode, "CREATE_MAIL", "CREATED_PENDING", BR_Elapsed(t0), note & " | replicas: " & u.ReplicaStatus & " - fix with 04 - Verify")
		BR_Log LVL_WARN, "Mail file created with follow-up needed: " & u.MailFile & " : " & note & " | " & u.ReplicaStatus
	Else
		Call BR_Audit(u, gMode, "CREATE_MAIL", "MAIL_CREATED", BR_Elapsed(t0), note & " (" & Format$(BR_Elapsed(t0), "0.0") & "s)")
		BR_Log LVL_INFO, "Mail file created " & srv & "!!" & u.MailFile & " (" & Format$(BR_Elapsed(t0), "0.0") & "s)"
	End If
	BR_CreateMailOne = "OK"
	Exit Function
ErrH:
	Call BR_Audit(u, gMode, "CREATE_MAIL", "FAILED", BR_Elapsed(t0), "err=" & Err & " " & Error$ & " (line " & Erl & ")")
	BR_Log LVL_ERROR, "Create mail FAILED " & u.FullNameBefore & " : " & Error$ & " (line " & Erl & ")"
	BR_CreateMailOne = "FAIL:error"
	Exit Function
End Function

'=====================================================================
' BR_RunExport  -  runs agent BulkReg\05 - Export to Registration Text File
'   The agent itself only contains:  Call BR_RunExport()
'              (READ-ONLY on names.nsf)
'
' Produces the 20-field ';' separated, UTF-8 BOM file documented in
' "Registering users from a text file" (Domino 14.5.1) for use with
'   People > Register > Import Text File   (Domino Administrator, Windows)
' plus a review CSV (no passwords) in AuditDir.
' The file uses CRLF line ends (Windows).
'
' Field order (HCL doc, Table 1):
'  1 Last  2 First  3 MI  4 OrgUnit  5 Password  6 IDFileDir  7 IDFileName
'  8 MailServer  9 MailFileDir  10 MailFileName  11 Location  12 Comment
' 13 ForwardingAddress  14 Profile  15 LocalAdmin  16 InternetAddress
' 17 ShortName  18 AltName  19 AltOrgUnit  20 MailTemplate
'
' Column 6 (ID file directory) is IDFileDir.
'
' !! The output file contains INITIAL PASSWORDS. It is written to
'    PasswordDir (restricted folder). Delete it after registration.
'=====================================================================
Sub BR_RunExport()
	On Error GoTo ErrH
	Dim ws As NotesUIWorkspace
	Dim db As NotesDatabase, col As NotesDocumentCollection, doc As NotesDocument
	Dim u As BRUser, st As NotesStream, outFile As String, ln As String, secDir As String
	Dim nOut As Long, nSkip As Long, issues As String, pw As String, idDirForImport As String
	Dim genPw As Boolean, ans As Variant, t0 As Double

	If Not BR_Init("ExportBatchReg") Then Exit Sub

	' --- password option ---
	Set ws = New NotesUIWorkspace
	ans = ws.Prompt(PROMPT_YESNO, "BulkReg - Export", _
	"Generate a random initial password per user?" & Chr$(10) & Chr$(10) & _
	"YES = random password per user (recommended)" & Chr$(10) & _
	"NO  = leave column 5 empty (you must fill it in before importing; it is required)")
	genPw = (ans = 1)
	BR_Log LVL_INFO, "Generate initial passwords: " & BR_IIfStr(genPw, "yes", "no")

	secDir = BR_CfgDir("PasswordDir", "secure")
	If Not BR_DirWritable(secDir) Then Error 3001, "PasswordDir not writable: " & secDir
	outFile = secDir & "BatchReg_DirSync_" & gRunID & ".txt"

	idDirForImport = BR_CfgDir("IDFileDir", "ids")

	Set st = gSession.CreateStream()
	If Not st.Open(outFile, "UTF-8") Then Error 3002, "Cannot create " & outFile
	Call st.Truncate()
	' U+FEFF written as UTF-8 = EF BB BF  -> the "UTF-8 BOM" the import requires
	Call st.WriteText(Uchr$(&HFEFF), EOL_NONE)

	Set db = BR_OpenDirectory()
	Set col = BR_GetCandidates(db, True)
	Set doc = col.GetFirstDocument()
	Do While Not (doc Is Nothing)
		t0 = Timer
		Call BR_ReadUser(doc, u)
		issues = BR_AssignHome(u) & BR_Validate(u)      ' AUTO home server from the HomeServers pool
		If InStr(issues, "ERROR:") > 0 Or InStr(issues, "SKIP:") > 0 Then
			nSkip = nSkip + 1
			BR_Log LVL_WARN, "SKIP " & u.FullNameBefore & " : " & issues
			Call BR_Audit(u, "EXPORT", "EXPORT", BR_IIfStr(InStr(issues, "SKIP:") > 0 And InStr(issues, "ERROR:") = 0, BR_RESULT_NO_INET, "SKIPPED"), BR_Elapsed(t0), issues)
		Else
			If genPw Then pw = BR_GenPassword(CInt(CfgL("InitialPasswordLength", 16))) Else pw = ""
			ln = u.LastName & ";" & u.FirstName & ";" & u.MiddleInitial & ";" & u.OrgUnit & ";" & _
			pw & ";" & idDirForImport & ";" & BR_SafeFile(u) & ".id" & ";" & _
			u.HomeServer & ";" & BR_Path(CfgS("MailFileDir", "mail")) & ";" & BR_MailBase(u) & ".nsf" & ";" & _
			"" & ";" & "DirSync objectGUID " & u.GUID & ";" & "" & ";" & _
			"" & ";" & "" & ";" & u.InternetAddress & ";" & u.ShortName & ";" & _
			"" & ";" & "" & ";" & CfgS("MailTemplate", "")
			Call st.WriteText(ln, EOL_CRLF)
			pw = ""
			nOut = nOut + 1
			Call BR_Audit(u, "EXPORT", "EXPORT", "EXPORTED", BR_Elapsed(t0), issues)
		End If
		Set doc = col.GetNextDocument(doc)
	Loop
	Call st.Close()

	Dim summary As String
	summary = "Exported=" & nOut & " Skipped=" & nSkip
	BR_Log LVL_INFO, "Registration text file: " & outFile
	BR_Log LVL_WARN, "File contains initial passwords - restrict access and delete after use."
	BR_Close summary
	BR_Msg summary & Chr$(10) & Chr$(10) & _
	"Text file (contains passwords!):" & Chr$(10) & outFile & Chr$(10) & Chr$(10) & _
	"Review CSV (no passwords): " & gAuditFile & Chr$(10) & Chr$(10) & _
	"Next (Windows Domino Administrator): People & Groups > People > Register >" & Chr$(10) & _
	"select the ID-Vault explicit policy > Import Text File > Register All." & Chr$(10) & _
	"Test with 1-2 users first (see guide Appendix A).", 64
	Exit Sub
ErrH:
	BR_Log LVL_ERROR, "Export aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	On Error Resume Next
	If Not (st Is Nothing) Then Call st.Close()
	BR_Close "ABORTED"
	BR_Msg "Export aborted: " & Error$, 16
	Exit Sub
End Sub
'=====================================================================
' BR_RunSetupLog  -  runs agent BulkReg\00 - Set Up Log Database
'   The agent itself only contains:  Call BR_RunSetupLog()
'
' Creates (or re-creates) in the central log database (LogServer!!LogDb):
'   - the form "BRLogEntry" (to open any log document), via DXL import
'   - the welcome screen = About This Database document, plus its launch option (DXL import)
'   - 8 categorized views under "BulkReg\" (runs, batches, users, results,
'     home servers, problems, skipped users, full log).
' Run it ONCE after creating the log database (guide B15) and again after a
' release that changes the views. Needs Designer (or Manager) access to the
' log database - normally the database owner, not the BulkReg operator.
' Documents are never changed or deleted by this agent.
'=====================================================================
Sub BR_RunSetupLog()
	On Error GoTo ErrH
	Dim ws As NotesUIWorkspace, ans As Variant, res As String, report As String, nBad As Integer
	Dim i As Integer, defs As Variant, parts As Variant, logName As String

	If Not BR_Init("SetupLog") Then Exit Sub
	' remember the name now: BR_Close releases gLogDb, and the messages below come after it
	logName = gLogDb.Server & "!!" & gLogDb.FilePath
	If gLogDb.CurrentAccessLevel < ACLLEVEL_DESIGNER Then
		BR_Close "No Designer access to the log database"
		BR_Msg "Setting up the views needs Designer or Manager access to the log database" & Chr$(10) & _
		logName & Chr$(10) & Chr$(10) & _
		"Ask the database owner (guide B15) to run Actions > BulkReg > 00 - Set Up Log Database.", 48
		Exit Sub
	End If
	Set ws = New NotesUIWorkspace
	ans = ws.Prompt(PROMPT_YESNO, "BulkReg - Set up log database", _
	"Create or replace the BulkReg form, the welcome screen (About document) and the 8 views ""BulkReg\..."" in" & Chr$(10) & _
	logName & " ?" & Chr$(10) & Chr$(10) & _
	"Existing log documents are not changed. Other views in the database are not touched.")
	If ans <> 1 Then
		BR_Close "Cancelled by operator"
		Exit Sub
	End If

	res = BR_LogImportForm(gLogDb)
	report = "Form BRLogEntry: " & res & Chr$(10)
	BR_Log BR_IIfInt2(res = "OK", LVL_INFO, LVL_ERROR), "Form BRLogEntry: " & res
	If res <> "OK" Then nBad = nBad + 1

	res = BR_InstallAbout(gLogDb, 2)
	report = report & "Welcome screen (About document):" & Chr$(10) & res & Chr$(10)
	BR_Log BR_IIfInt2(InStr(res, "ERROR") = 0, LVL_INFO, LVL_ERROR), "Welcome screen: " & Replace(res, Chr$(10), " / ")
	If InStr(res, "ERROR") > 0 Then nBad = nBad + 1

	defs = BR_LogViewDefs()
	For i = 0 To UBound(defs)
		parts = Split(CStr(defs(i)), "||")
		res = BR_MakeView(gLogDb, CStr(parts(0)), CStr(parts(1)), CStr(parts(2)))
		report = report & CStr(parts(0)) & ": " & res & Chr$(10)
		BR_Log BR_IIfInt2(res = "OK", LVL_INFO, LVL_ERROR), "View " & CStr(parts(0)) & ": " & res
		If res <> "OK" Then nBad = nBad + 1
	Next

	BR_Close "Log database set up: " & (UBound(defs) + 1) & " views, problems=" & nBad
	BR_Msg "Log database " & logName & Chr$(10) & Chr$(10) & report & Chr$(10) & _
	"Open the database and expand the view folder ""BulkReg"" in the navigator." & Chr$(10) & Chr$(10) & _
	"Close and re-open the database: the welcome screen (About document) opens first." & Chr$(10) & _
	"If not: Database Properties > Launch tab > Show 'About Application' document > Always open first.", CInt(BR_IIfStr(nBad > 0, "48", "64"))
	Exit Sub
ErrH:
	BR_Log LVL_ERROR, "Set up log database aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	BR_Close "ABORTED"
	BR_Msg "Set up log database aborted: " & Error$, 16
	Exit Sub
End Sub

' View definitions:  name || selection formula || columns
'   columns separated by ~ ; each column  Title^Formula^Flags^Width
'   Flags: C = categorized, S = sorted, D = descending
Function BR_LogViewDefs() As Variant
	Dim d(7) As String
	d(0) = {BulkReg\1. Runs - by date||SELECT DocType = "Run"||} & _
	{Date^Day^CD^12~Start^TimeText^SD^9~Tool^Tool^^14~Mode^@If(RunMode != ""; RunMode; DryRun = "0"; "LIVE"; "DryRun=1")^^16~Batch^BatchID^^22~Operator^@Name([Abbreviate]; Operator)^^20~Status^Status^^11~Summary^Summary^^60~Version^Version^^8}
	d(1) = {BulkReg\2. Batches - by batch, tool, result||SELECT DocType = "Audit" & BatchID != ""||} & _
	{Batch^BatchID^CD^22~Tool^Tool^C^14~Result^Result^C^20~User^@Name([Abbreviate]; FullName)^S^28~Internet address^InternetAddress^^28~Home server^@Name([Abbreviate]; HomeServer)^^20~Mail file^MailFile^^22~Vault^VaultStatus^^14~Replicas^ReplicaStatus^^22~When^Day + " " + TimeText^^18~Message^Message^^60}
	d(2) = {BulkReg\3. Users - by name||SELECT DocType = "Audit"||} & _
	{User^@Name([Abbreviate]; FullName)^C^30~When^Day + " " + TimeText^S^18~Tool^Tool^^14~Mode^Mode^^9~Result^Result^^20~Batch^BatchID^^22~Home server^@Name([Abbreviate]; HomeServer)^^20~Mail file^MailFile^^22~Vault^VaultStatus^^14~Replicas^ReplicaStatus^^22~Message^Message^^60}
	d(3) = {BulkReg\4. Results - by result, batch||SELECT DocType = "Audit"||} & _
	{Result^Result^C^24~Batch^BatchID^CD^22~User^@Name([Abbreviate]; FullName)^S^28~Tool^Tool^^14~When^Day + " " + TimeText^^18~Message^Message^^60}
	d(4) = {BulkReg\5. Home servers - by server, batch||SELECT DocType = "Audit" & HomeServer != ""||} & _
	{Home server^@Name([Abbreviate]; HomeServer)^C^24~Batch^BatchID^CD^22~User^@Name([Abbreviate]; FullName)^S^28~Tool^Tool^^14~Result^Result^^20~Mail file^MailFile^^22~Replicas^ReplicaStatus^^22~Vault^VaultStatus^^14}
	d(5) = {BulkReg\6. Problems - errors, failures, skipped||SELECT (DocType = "Entry" & (Level = "ERROR" | Level = "WARN")) | (DocType = "Audit" & (@Contains(Result; "FAIL" : "SKIP" : "PENDING" : "NOT_" : "ERROR" : "UNREGISTERED") | @Contains(ReplicaStatus; "MISSING" : "FAILED"))) | (DocType = "Run" & Status != "FINISHED")||} & _
	{Date^Day^CD^12~Tool^Tool^C^14~Time^TimeText^SD^9~Level^Level^^7~Result / status^@If(DocType = "Run"; Status; Result)^^20~User^@Name([Abbreviate]; FullName)^^28~Batch^BatchID^^22~Message^@If(DocType = "Run"; Summary; Message)^^80}
	d(6) = {BulkReg\7. Skipped - no Internet address||SELECT DocType = "Audit" & Result = "SKIPPED_NO_INET"||} & _
	{User^@Name([Abbreviate]; FullName)^C^30~When^Day + " " + TimeText^SD^18~Tool^Tool^^14~Batch^BatchID^^22~Person NoteID^NoteIDPerson^^10~objectGUID^objectGUID^^36~Message^Message^^60}
	d(7) = {BulkReg\8. Full log - by run||SELECT DocType = "Entry" | DocType = "Run"||} & _
	{Run^RunTitle^CD^50~Time^TimeText^S^9~Level^@If(DocType = "Run"; "RUN"; Level)^^7~Message^@If(DocType = "Run"; Status + "  " + Summary; Message)^^120}
	BR_LogViewDefs = d
End Function

' Creates or replaces one view with the given selection and columns. Returns "OK" or an error.
Function BR_MakeView(db As NotesDatabase, vname As String, sel As String, spec As String) As String
	On Error GoTo ErrH
	Dim v As NotesView, c As NotesViewColumn, cols As Variant, p As Variant, i As Integer, n0 As Integer, flags As String
	Set v = db.GetView(vname)
	If Not (v Is Nothing) Then Call v.Remove
	Set v = db.CreateView(vname, sel)
	n0 = v.ColumnCount                       ' default column(s) of a new view - removed below
	cols = Split(spec, "~")
	For i = 0 To UBound(cols)
		p = Split(CStr(cols(i)), "^")
		Set c = v.CreateColumn(n0 + i + 1, CStr(p(0)), CStr(p(1)))
		flags = UCase$(CStr(p(2)))
		If InStr(flags, "S") > 0 Or InStr(flags, "C") > 0 Then c.IsSorted = True
		If InStr(flags, "C") > 0 Then
			c.IsCategory = True
			c.IsShowTwistie = True            ' twistie so the group can be expanded / collapsed
		End If
		If InStr(flags, "D") > 0 Then c.IsSortDescending = True
		c.Width = CInt(p(3))
	Next
	For i = 1 To n0
		Call v.RemoveColumn(1)
	Next
	' first BulkReg view = the view that opens with the database
	If InStr(vname, "\1. ") > 0 Then
		On Error Resume Next
		v.IsDefaultView = True
		Err = 0
		On Error GoTo ErrH
	End If
	BR_MakeView = "OK"
	Exit Function
ErrH:
	BR_MakeView = "ERROR " & Error$ & " (err " & Err & ")"
	Exit Function
End Function

' Imports the form BRLogEntry (shows every field of a log document). Returns "OK" or an error.
Function BR_LogImportForm(db As NotesDatabase) As String
	On Error GoTo ErrH
	Dim dxlImp As NotesDXLImporter, dxl As String, flds As Variant, i As Integer
	flds = Split("DocType,RunTitle,RunID,Tool,Operator,DryRun,Mode,BatchID,Day,TimeText,Level,Status,Summary,Action,Result,FullName,InternetAddress,ShortName,HomeServer,OrgUnit,Policy,MapRule,MailFile,MailFileStatus,MailFileNote,VaultStatus,ClusterReplicas,ReplicaStatus,NoteIDPerson,UNIDPerson,objectGUID,DurationSec,Message,Config,Platform,Version,LogWriteErrors", ",")
	dxl = "<?xml version='1.0' encoding='utf-8'?>" & _
	"<database xmlns='http://www.lotus.com/dxl'>" & _
	"<form name='BRLogEntry' default='true'><body><richtext>" & _
	"<par><run><font size='12pt' style='bold'/>BulkReg log entry</run></par>"
	For i = 0 To UBound(flds)
		dxl = dxl & "<par>" & CStr(flds(i)) & ": <field type='text' kind='editable' name='" & CStr(flds(i)) & "'/></par>"
	Next
	dxl = dxl & "</richtext></body></form></database>"
	Set dxlImp = gSession.CreateDXLImporter()
	dxlImp.DesignImportOption = DXLIMPORTOPTION_REPLACE_ELSE_CREATE
	dxlImp.ReplaceDBProperties = False
	dxlImp.ReplicaRequiredForReplaceOrUpdate = False
	Call dxlImp.Import(dxl, db)
	BR_LogImportForm = "OK"
	Exit Function
ErrH:
	BR_LogImportForm = "ERROR " & Error$ & " (err " & Err & ") - the views still work; documents open without a form"
	Exit Function
End Function

Function BR_IIfInt2(c As Boolean, a As Integer, b As Integer) As Integer
	If c Then BR_IIfInt2 = a Else BR_IIfInt2 = b
End Function

'=====================================================================
' BR_RunInstallWelcome  -  runs agent BulkReg\06 - Install Welcome Page
'   The agent itself only contains:  Call BR_RunInstallWelcome()
'
' Creates (or replaces) the "About This Database" document of the CURRENT
' database (bulkreg.nsf): a branded welcome screen with a short SOP of the
' agent sequence (native Notes rich text: tables, fonts, colours), and
' sets the launch option "Show About Application document" so the Notes client
' opens it first. (A Notes client cannot launch a designated PAGE - that option
' exists for the web only; the About document is the Notes client mechanism.)
' Changes no documents and no other design element. Needs Designer access.
'=====================================================================
Sub BR_RunInstallWelcome()
	On Error GoTo ErrH
	Dim sess As New NotesSession, db As NotesDatabase, res As String

	Set db = sess.CurrentDatabase
	If db Is Nothing Then
		MessageBox "Open bulkreg.nsf first, then run this agent from its Actions menu.", 48, "BulkReg - Welcome screen"
		Exit Sub
	End If
	If db.CurrentAccessLevel < ACLLEVEL_DESIGNER Then
		MessageBox "Installing the welcome screen needs Designer or Manager access to " & db.FilePath & ".", 48, "BulkReg - Welcome screen"
		Exit Sub
	End If
	res = BR_InstallAbout(db, 1)
	MessageBox "Welcome screen for " & db.FilePath & ":" & Chr$(10) & Chr$(10) & res & Chr$(10) & Chr$(10) & _
	"Close the database and open it again: the About document should open first." & Chr$(10) & _
	"If it does not: Database Properties > Launch tab > 'Show About Application document' = Always open first (or If modified)." & Chr$(10) & _
	"To view it any time: Help > About This Application.", 64, "BulkReg - Welcome screen"
	Exit Sub
ErrH:
	MessageBox "Installing the welcome screen failed: " & Error$ & " (err " & Err & ", line " & Erl & ")", 16, "BulkReg - Welcome screen"
	Exit Sub
End Sub

' Imports one DXL string into db. Returns "OK ..." or "ERROR ...". expectNotes = True: zero imported
' design notes is reported as an error (the importer can finish without importing anything).
Function BR_ImportDxl(db As NotesDatabase, dxl As String, replaceProps As Boolean, expectNotes As Boolean) As String
	On Error GoTo ErrH
	Dim sess As New NotesSession, dxlImp As NotesDXLImporter, n As Long, lg As String
	Set dxlImp = sess.CreateDXLImporter()
	dxlImp.DesignImportOption = DXLIMPORTOPTION_REPLACE_ELSE_CREATE
	dxlImp.ReplaceDBProperties = replaceProps
	dxlImp.ReplicaRequiredForReplaceOrUpdate = False
	Call dxlImp.Import(dxl, db)
	n = dxlImp.ImportedNoteCount
	If expectNotes And n = 0 Then
		lg = dxlImp.Log
		BR_ImportDxl = "ERROR nothing was imported. " & Left$(lg, 400)
	Else
		BR_ImportDxl = "OK (" & n & " design note(s) imported)"
	End If
	Exit Function
ErrH:
	lg = Error$ & " (err " & Err & ")"
	On Error Resume Next
	lg = lg & " " & Left$(dxlImp.Log, 400)
	BR_ImportDxl = "ERROR " & lg
	Exit Function
End Function

' Creates or replaces the About This Database document and sets the launch option
' "Show About Application document" (noteslaunch showaboutdocument).
'   which = 1: welcome screen of bulkreg.nsf     which = 2: welcome screen of the log database
' The content is NATIVE Notes rich text (tables, fonts, colours) - the Notes client does not render
' pass-through HTML in a document. If the rich layout is rejected on import, a plain layout (the same text
' without tables) is imported instead and the importer message is reported.
Function BR_InstallAbout(db As NotesDatabase, which As Integer) As String
	Dim r1 As String, r2 As String, r3 As String
	gRtPlain = False
	r1 = BR_ImportDxl(db, BR_AboutDxl(which), False, True)
	If Left$(r1, 5) = "ERROR" Then
		gRtPlain = True
		r3 = BR_ImportDxl(db, BR_AboutDxl(which), False, True)
		gRtPlain = False
		r1 = "rich layout rejected: " & Left$(r1, 350) & Chr$(10) & "plain layout: " & r3
	End If
	r2 = BR_ImportDxl(db, "<?xml version='1.0' encoding='utf-8'?>" & _
	"<database xmlns='http://www.lotus.com/dxl'>" & _
	"<launchsettings><noteslaunch showaboutdocument='firstopenandchanged'/></launchsettings></database>", True, False)
	BR_InstallAbout = "About document: " & r1 & Chr$(10) & "Launch option: " & r2
End Function

Function BR_AboutDxl(which As Integer) As String
	Dim body As String
	If which = 2 Then body = BR_LogWelcomeRich() Else body = BR_WelcomeRich()
	BR_AboutDxl = "<?xml version='1.0' encoding='utf-8'?>" & _
	"<database xmlns='http://www.lotus.com/dxl'>" & _
	"<helpaboutdocument bgcolor='#FFFFFF'><body><richtext><pardef id='1'/>" & body & "</richtext></body></helpaboutdocument></database>"
End Function

' Escapes text for use inside an XML element.
Function BR_XmlEsc(s As String) As String
	Dim t As String
	t = Replace(s, "&", "&amp;")
	t = Replace(t, "<", "&lt;")
	t = Replace(t, ">", "&gt;")
	BR_XmlEsc = t
End Function

'=====================================================================
' Rich text builders (DXL). gRtPlain = True drops tables and colours of cells (fallback layout).
'=====================================================================
Function BR_RtRun(t As String, sz As String, sty As String, col As String) As String
	BR_RtRun = "<run><font name='Arial' size='" & sz & "' style='" & sty & "' color='" & col & "'/>" & BR_XmlEsc(t) & "</run>"
End Function

Function BR_RtPar(inner As String) As String
	BR_RtPar = "<par def='1'>" & inner & "</par>"
End Function

Function BR_RtP(t As String, sz As String, sty As String, col As String) As String
	BR_RtP = BR_RtPar(BR_RtRun(t, sz, sty, col))
End Function

Function BR_RtGap() As String
	BR_RtGap = BR_RtP(" ", "5pt", "normal", "#FFFFFF")
End Function

Function BR_RtCell(bg As String, inner As String) As String
	If gRtPlain Then
		BR_RtCell = inner
	Else
		BR_RtCell = "<tablecell bgcolor='" & bg & "'>" & inner & "</tablecell>"
	End If
End Function

Function BR_RtRow(cells As String) As String
	If gRtPlain Then
		BR_RtRow = cells
	Else
		BR_RtRow = "<tablerow>" & cells & "</tablerow>"
	End If
End Function

' widths = column widths in percent, comma separated, e.g. "8,92"
Function BR_RtTable(widths As String, rows As String) As String
	Dim w As Variant, i As Integer, cols As String
	If gRtPlain Then
		BR_RtTable = rows & BR_RtGap()
		Exit Function
	End If
	w = Split(widths, ",")
	For i = 0 To UBound(w)
		cols = cols & "<tablecolumn width='" & CStr(w(i)) & "%'/>"
	Next
	BR_RtTable = "<table widthtype='fitmargins' leftmargin='0.05in' cellbordercolor='#FFFFFF'>" & cols & rows & "</table>" & BR_RtGap()
End Function

' One card (one table cell): bold coloured title + text
Function BR_RtCard(bg As String, ttl As String, ttlCol As String, txt As String) As String
	BR_RtCard = BR_RtCell(bg, BR_RtP(ttl, "11pt", "bold", ttlCol) & BR_RtP(txt, "9pt", "normal", "#14142B"))
End Function

' One box (full width): title + lines, coloured background
Function BR_RtBox(bg As String, ttl As String, ttlCol As String, linesText As String) As String
	Dim s As String, i As Integer, bu As String, lines As Variant
	bu = Uchr$(8226) & " "
	lines = Split(linesText, "~")                       ' items separated by ~
	s = BR_RtP(ttl, "12pt", "bold", ttlCol)
	For i = 0 To UBound(lines)
		s = s & BR_RtP(bu & CStr(lines(i)), "10pt", "normal", "#14142B")
	Next
	BR_RtBox = BR_RtTable("100", BR_RtRow(BR_RtCell(bg, s)))
End Function

' One row of the procedure table: number | title, command, text, "Done when"
Function BR_RtStep(num As String, ttl As String, cmd As String, txt As String, res As String) As String
	Dim c2 As String
	c2 = BR_RtP(ttl, "12pt", "bold", "#14142B")
	If cmd <> "" Then c2 = c2 & BR_RtP(cmd, "10pt", "bold", "#0F5FDC")
	c2 = c2 & BR_RtP(txt, "10pt", "normal", "#14142B")
	c2 = c2 & BR_RtPar(BR_RtRun("Done when: ", "9pt", "bold", "#17707F") & BR_RtRun(res, "9pt", "normal", "#17707F"))
	BR_RtStep = BR_RtRow(BR_RtCell("#17707F", BR_RtP(num, "18pt", "bold", "#FFFFFF")) & BR_RtCell("#F7F7FC", c2))
End Function

Function BR_RtHero(small As String, big As String, sub1 As String, info As String) As String
	Dim s As String
	s = BR_RtP(small, "9pt", "bold", "#AAFFFF") & BR_RtP(big, "30pt", "bold", "#FFFFFF") & _
	BR_RtP(sub1, "14pt", "normal", "#FFFFFF") & BR_RtP(info, "9pt", "normal", "#DCE6F0")
	BR_RtHero = BR_RtTable("100", BR_RtRow(BR_RtCell("#17707F", s))) & _
	BR_RtTable("100", BR_RtRow(BR_RtCell("#2EC0CB", BR_RtP(" ", "3pt", "normal", "#2EC0CB"))))
End Function

Function BR_RtH(t As String) As String
	BR_RtH = BR_RtP(t, "16pt", "bold", "#17707F")
End Function

' ---- welcome screen of bulkreg.nsf
Function BR_WelcomeRich() As String
	Dim h As String, a As String, dot As String, rw As String
	a = "Actions > BulkReg > "
	dot = " " & Uchr$(183) & " "
	h = BR_RtHero("HCL SOFTWARE" & dot & "DOMINO", "BulkReg", _
	"Bulk registration of DirSync users with Notes ID, mail file and ID Vault", _
	"Release " & BR_VERSION & dot & "Run from the HCL Domino Administrator client" & dot & "All agents: Actions > BulkReg")

	h = h & BR_RtH("What this tool does")
	h = h & BR_RtP("DirSync creates Person documents for Active Directory users, but those users have no Notes ID and no mail file. " & _
	"BulkReg turns them into full Domino users, in reviewed batches: it creates the Notes ID (deposited in the ID Vault through the policy), " & _
	"creates the mail file on the home server, requests replicas on the other mail cluster members, and writes every action to the audit log.", "10pt", "normal", "#14142B")
	h = h & BR_RtGap()
	h = h & BR_RtTable("25,25,25,25", BR_RtRow( _
	BR_RtCard("#ECF3F8", "1  Plan", "#17707F", "Preflight checks everything. Build Batch writes the batch files. Nothing is registered.") & _
	BR_RtCard("#ECF3F8", "2  Review", "#17707F", "You check the batch file in Excel and set Include to Y or N per user.") & _
	BR_RtCard("#ECF3F8", "3  Register", "#17707F", "Dry run first, then live on the same file. You type the batch ID to confirm.") & _
	BR_RtCard("#ECF3F8", "4  Verify", "#17707F", "Checks registration, vault, mail file and replicas for the batch.")))

	h = h & BR_RtBox("#F7F7FC", "Before the first batch (one time)", "#17707F",  _
	"bulkreg.ini and server_mapping.csv are filled in: no <placeholder> left, DryRun=1." & "~" & _
	"The numbered mail folders (mail1, mail2 ...) exist on every home server and mail cluster member." & "~" & _
	"The log database bulkreg_log.nsf exists and its owner has run " & a & "00 - Set Up Log Database once." & "~" & _
	"Start with a pilot batch of 2 users (BatchSize=2) and go through all steps below before the real batches.")

	h = h & BR_RtH("Procedure for every batch")
	h = h & BR_RtP("Always in this order. Repeat from step 1 or 2 for the next batch.", "10pt", "normal", "#14142B")
	h = h & BR_RtGap()
	rw = BR_RtStep("1", "Preflight Check", a & "01 - Preflight Check", _
	"Checks the environment, the configuration and every candidate user. It changes nothing in Domino. Fix every ERROR, then create the mail folders listed in _mailfolders.txt in the run folder under C:\BulkReg\audit.", _
	"0 environment errors; the batch plan (_batchplan.txt) looks right.")
	rw = rw & BR_RtStep("2", "Build the batches", a & "02 - Build Batch", _
	"Writes BATCH-<run>-01.csv, -02.csv ... (1000 users each) and _summary.txt to C:\BulkReg\batches. Nothing is registered.", _
	"The batch files and the summary exist.")
	rw = rw & BR_RtStep("3", "Review the batch file", "Excel, save as CSV UTF-8", _
	"Open BATCH-<id>.csv. Set Include=N for users to skip and check HomeServer, MailFile and NotesName. Do not change the objectGUID.", _
	"The file is reviewed and saved.")
	rw = rw & BR_RtStep("4", "Dry run", "DryRun=1   " & a & "03 - Register Batch", _
	"Simulates the registration of every approved row. Nobody is registered, the batch stays open and can be dry-run again.", _
	"Every row is WOULD_REGISTER in BATCH-<id>_dryrun_<run>.csv.")
	rw = rw & BR_RtStep("5", "Register for real", "DryRun=0   " & a & "03 - Register Batch", _
	"Set DryRun=0 in bulkreg.ini, run 03 on the same batch and type the batch ID to confirm. Each batch can be registered live only once.", _
	"BATCH-<id>_results.csv is written and the batch is DONE. Set DryRun=1 again.")
	rw = rw & BR_RtStep("6", "Verify", a & "04 - Verify Registration and Vault", _
	"Choose the batch. Checks the registration, the ID Vault, the mail file and the replicas. Run it again later until all replicas exist.", _
	"REGISTERED, IN_VAULT, MAILFILE_OK and REPLICAS_OK for every user.")
	rw = rw & BR_RtStep("7", "Hand over and clean up", "bulkreg.cmd PurgeSecrets", _
	"Hand the initial passwords to the users, then delete the password files. Keep the audit folders. Then start the next batch.", _
	"No secrets are left in C:\BulkReg\secure.")
	h = h & BR_RtTable("8,92", rw)

	h = h & BR_RtBox("#FFF8E6", "Safety rules", "#14142B",  _
	"DryRun=1 is the safe state. Only agent 03 uses it. Switch to 0 just for the live run, then back to 1." & "~" & _
	"03 cannot run without a batch file from 02, and it registers only the rows with Include=Y." & "~" & _
	"Agent 05 - Export to Registration Text File is not part of this procedure." & "~" & _
	"Batch files, ID files, passwords and audit logs contain personal data or secrets. Keep them in C:\BulkReg, never commit or e-mail them." & "~" & _
	"If an agent reports an error or a run stops, do not repeat it blindly: read the run folder and the log database first.")

	h = h & BR_RtTable("33,34,33", BR_RtRow( _
	BR_RtCard("#ECF3F8", "Settings", "#17707F", "C:\BulkReg\config\bulkreg.ini and C:\BulkReg\config\server_mapping.csv") & _
	BR_RtCard("#ECF3F8", "Results and audit", "#17707F", "Batch files: C:\BulkReg\batches. One folder per run: C:\BulkReg\audit. Central log: bulkreg_log.nsf") & _
	BR_RtCard("#ECF3F8", "Full guide", "#17707F", "BulkReg_Admin_Guide (.docx / .html) in the kit: every click, troubleshooting in chapter D.")))
	h = h & BR_RtP("HCL Software" & dot & "BulkReg " & BR_VERSION & dot & "Internal administration tool. Not for distribution to end users.", "8pt", "normal", "#6B7280")
	BR_WelcomeRich = h
End Function

' ---- welcome screen of the log database
Function BR_LogViewRow(num As String, ttl As String, txt As String) As String
	BR_LogViewRow = BR_RtRow(BR_RtCell("#17707F", BR_RtP(num, "14pt", "bold", "#FFFFFF")) & _
	BR_RtCell("#F7F7FC", BR_RtP(ttl, "11pt", "bold", "#14142B") & BR_RtP(txt, "9pt", "normal", "#14142B")))
End Function

Function BR_LogWelcomeRich() As String
	Dim h As String, dot As String, rw As String
	dot = " " & Uchr$(183) & " "
	h = BR_RtHero("HCL SOFTWARE" & dot & "DOMINO", "BulkReg Audit Log", "The shared, permanent record of every BulkReg run", _
	"Release " & BR_VERSION & dot & "Written by the BulkReg agents" & dot & "Read-only for auditors")

	h = h & BR_RtH("What is stored here")
	h = h & BR_RtP("Every run of every BulkReg agent writes structured documents to this database. The CSV and log files on the admin PC are local working copies; this database is the record for other administrators and auditors.", "10pt", "normal", "#14142B")
	h = h & BR_RtGap()
	h = h & BR_RtTable("33,34,33", BR_RtRow( _
	BR_RtCard("#ECF3F8", "Run", "#17707F", "One document per agent run: agent, operator, batch, DryRun, start, end, status and summary.") & _
	BR_RtCard("#ECF3F8", "Entry", "#17707F", "One document per log line of a run (INFO, WARN, ERROR), in order.") & _
	BR_RtCard("#ECF3F8", "Audit", "#17707F", "One document per user and action: result, home server, mail file, vault, replicas and batch.")))

	h = h & BR_RtH("Where to look")
	h = h & BR_RtP("Open the view folder BulkReg in the navigator. Click a twistie to open a group.", "10pt", "normal", "#14142B")
	h = h & BR_RtGap()
	rw = BR_LogViewRow("1", "Runs - by date", "Every agent run, newest first: who ran what, in which mode (DRYRUN or LIVE), status and summary. Start here.")
	rw = rw & BR_LogViewRow("2", "Batches - by batch, tool, result", "Everything that happened to one batch, per agent and result.")
	rw = rw & BR_LogViewRow("3", "Users - by name", "The history of one user across all agents and batches.")
	rw = rw & BR_LogViewRow("4", "Results - by result, batch", "All users grouped by result, for example every REGISTERED or every failure.")
	rw = rw & BR_LogViewRow("5", "Home servers - by server, batch", "Which users went to which home server, with mail file, vault and replica status.")
	rw = rw & BR_LogViewRow("6", "Problems - errors, failures, skipped", "All ERROR and WARN lines, failed or pending users, missing replicas and runs that did not finish. Check this after every run.")
	rw = rw & BR_LogViewRow("7", "Skipped - no Internet address", "Users left out of a batch because they have no Internet address yet. They are offered again once AD and DirSync provide it.")
	rw = rw & BR_LogViewRow("8", "Full log - by run", "Every log line of every run, for detailed troubleshooting.")
	h = h & BR_RtTable("8,92", rw)

	h = h & BR_RtBox("#F7F7FC", "Tips", "#17707F",  _
	"View > Expand All / Collapse All (Ctrl + / Ctrl -) opens or closes all groups." & "~" & _
	"Newest dates and batches are at the top. A run in mode DRYRUN never changed Domino; LIVE-PRODUCTION did." & "~" & _
	"For a user question open view 3 and expand the user. For a batch question open view 2." & "~" & _
	"After a release that changes the views, the owner runs Actions > BulkReg > 00 - Set Up Log Database again.")

	h = h & BR_RtBox("#FFF8E6", "Handle with care", "#14142B",  _
	"This is an audit record. Do not edit or delete documents. Operators have Author access with Create documents and no Delete; only the database owner manages the design." & "~" & _
	"The documents contain personal data (names, Internet addresses, servers). Share access only with people who need it, and back the database up like any other audit data.")
	h = h & BR_RtP("HCL Software" & dot & "BulkReg " & BR_VERSION & dot & "Central log database. Written by BulkReg agents 01 - 05; design set up by agent 00.", "8pt", "normal", "#6B7280")
	BR_LogWelcomeRich = h
End Function
