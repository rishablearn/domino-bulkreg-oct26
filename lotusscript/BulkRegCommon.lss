'=====================================================================
' Script Library : BulkRegCommon            Version 3.6.1
' Purpose        : Shared code for the BulkReg framework
'                  (config, multi-server mapping, logging, audit, helpers)
' Used by        : BulkRegAgents (the code of all five agents)
' Runs in        : HCL Domino Administrator client on WINDOWS only
'                  (agent trigger: Action menu selection, Target: None).
'                  BR_Init refuses to run on a server or a non-Windows client.
'
' HOW TO INSTALL : Designer > Code > Script Libraries > New LotusScript Library,
'                  name it exactly "BulkRegCommon". Click in the editor, Ctrl+A, Delete,
'                  paste this WHOLE file, Ctrl+S. Designer puts (Options), (Declarations)
'                  and every Sub/Function in its place automatically.
'=====================================================================
'#####################################################################
' --- part 1: (Options) ---
'#####################################################################
Option Public
Option Declare
'#####################################################################
' --- part 2: (Declarations) ---
'#####################################################################

Public Const BR_VERSION = "3.6.1"

' ---------- log levels ----------
Public Const LVL_DEBUG = 10
Public Const LVL_INFO = 20
Public Const LVL_WARN = 30
Public Const LVL_ERROR = 40

' ---------- one mapping rule (server_mapping.csv) ----------
Public Type BRMapRule
	MatchField As String
	MatchPattern As String
	HomeServer As String
	OrgUnit As String
	Policy As String
	Groups As String
	VaultServer As String
	ClusterReplicas As String   ' column 8: empty = automatic (MailClusterServers), "-" = none, or a list
End Type

' ---------- one candidate user ----------
Public Type BRUser
	NoteID As String
	UNID As String
	GUID As String
	FullNameBefore As String
	FullNameAfter As String
	FirstName As String
	LastName As String
	MiddleInitial As String
	ShortName As String
	InternetAddress As String
	MailSystemBefore As String
	MailFileBefore As String
	MailSystemAfter As String
	MailFile As String          ' Domino mail file to create, relative to the data dir (mail\jsmith.nsf)
	MailFileStatus As String    ' MAILFILE_OK / MAILFILE_MISSING / ...
	MailFileNote As String      ' how the name/folder was chosen (naming rule, collisions, folder fill)
	HomeServer As String
	OrgUnit As String
	Policy As String
	Groups As String
	MapRule As String
	IDFile As String
	VaultStatus As String
	VaultServer As String
	ClusterReplicas As String   ' servers that get a cluster replica of the mail file (comma separated)
	ReplicaStatus As String     ' WOULD_REQUEST / REQUESTED n/m / REPLICAS_OK n/n / REPLICAS_MISSING ...
	Issues As String
End Type

' ---------- globals ----------
Public gCfg List As String
Public gMap() As BRMapRule
Public gMapCount As Integer
Public gRunID As String
Public gTool As String
Public gOperator As String
Public gLogLevel As Integer
Public gDebugFile As String
Public gAuditFile As String
Public gRunDir As String          ' <AuditDir>\<yyyy-mm-dd_hhnnss>_<NN-Tool>_<MODE>\  - one folder per run
Public gRunMode As String         ' DRYRUN | LIVE-PRODUCTION | READ-ONLY | SETUP
Public gLogDb As NotesDatabase    ' central log database (structured documents, views by 00 - Set Up Log Database)
Public gRunDoc As NotesDocument   ' the Run document of this run
Public gRunTitle As String
Public gLogWriteErr As Integer
Public gSession As NotesSession
Public gPlatform As String       ' NotesSession.Platform, e.g. "Windows/64"
Public gBatchID As String        ' batch being built / registered (BATCH-yyyymmdd-hhnnss)
Public gResultsFile As String    ' <BatchDir>\<BatchID>_results.csv (LIVE) or _dryrun.csv
Public gAdminP As NotesAdministrationProcess   ' AdminP requests (cluster replicas), created on first use

Public Const gSep = "\"                         ' Windows path separator
Public Const BR_DEFAULT_BASE = "C:\BulkReg\"    ' default base folder
Public gBase As String
Public Const BR_ENV_CFG = "BulkRegConfigPath"   ' remembered in the client notes.ini
' columns of a batch file (BATCH-<id>.csv) written by Agent 02, read by Agents 03/04
Public Const BR_SKIP_NO_INET = "SKIP:InternetAddress missing - user skipped and flagged (add the address in AD; after DirSync the next Build Batch picks the user up); "
Public Const BR_RESULT_NO_INET = "SKIPPED_NO_INET"
Public Const BR_WARN_NO_INET = "WARN:InternetAddress missing - registered without an Internet address (add it in AD, DirSync syncs it); "
Public Const BR_BATCH_COLS = "Include,BatchID,Seq,NoteID,UNID,objectGUID,FullName,NotesName,FirstName,LastName,ShortName,InternetAddress,HomeServer,MailFile,MailFileNote,OrgUnit,Policy,Groups,VaultServer,ClusterReplicas,MapRule,Check,Issues"

'#####################################################################
' --- part 3: Subs and Functions (Designer gives each its own entry) ---
'#####################################################################
'=====================================================================
' INITIALISATION
'=====================================================================
' Checks it runs in the Windows Domino Administrator / Notes client,
' prompts for (and remembers) the config path, loads config + mapping,
' opens the debug log, audit CSV and optional Agent Log database.
Function BR_Init(toolName As String) As Boolean
	On Error GoTo ErrH
	Dim ws As NotesUIWorkspace
	Dim cfgPath As Variant
	Dim lastPath As String

	Set gSession = New NotesSession
	gTool = toolName
	gRunID = Format$(Now, "yyyymmdd-hhnnss")
	gOperator = gSession.UserName
	gLogLevel = LVL_INFO
	gBase = BR_DEFAULT_BASE
	gPlatform = gSession.Platform
	' globals of the libraries survive between agent runs in one client session - start clean
	gBatchID = ""
	gResultsFile = ""
	gDebugFile = ""
	gAuditFile = ""
	gRunDir = ""
	gRunMode = ""
	Set gAdminP = Nothing
	Set gLogDb = Nothing
	Set gRunDoc = Nothing
	gRunTitle = ""
	gLogWriteErr = 0
	Erase gCfg
	Randomize

	' ---- supported environment: Windows client only ----
	If gSession.IsOnServer Then
		Print "BulkReg: must be run from the Windows Domino Administrator client (Actions menu), not on a server. Run refused."
		Exit Function
	End If
	If InStr(1, gPlatform, "Windows", 5) = 0 Then
		Messagebox "BulkReg is supported only in the Domino Administrator client on Windows." & Chr$(10) & _
		"Detected platform: " & gPlatform, 16, "BulkReg"
		Exit Function
	End If

	Set ws = New NotesUIWorkspace
	lastPath = gSession.GetEnvironmentString(BR_ENV_CFG, True)
	If lastPath = "" Then lastPath = gBase & "config\bulkreg.ini"
	cfgPath = ws.Prompt(PROMPT_OKCANCELEDIT, "BulkReg " & BR_VERSION & " - " & toolName, _
	"Path to bulkreg.ini:", lastPath)
	If IsEmpty(cfgPath) Then Exit Function
	If Trim$(CStr(cfgPath)) = "" Then Exit Function
	Call gSession.SetEnvironmentVar(BR_ENV_CFG, CStr(cfgPath), True)

	If Not BR_LoadConfig(BR_Path(CStr(cfgPath))) Then Exit Function
	gLogLevel = BR_LevelFromName(CfgS("LogLevel", "INFO"))

	' mail folder settings must describe folders DIRECTLY under the Domino data directory
	Dim mfErr As String
	mfErr = BR_CheckMailFolderConfig()
	If mfErr <> "" Then
		BR_Msg "Mail folder setting error in " & CStr(cfgPath) & ":" & Chr$(10) & Chr$(10) & mfErr, 16
		Exit Function
	End If
	If CfgS("BaseDir", "") <> "" Then gBase = BR_Dir(CfgS("BaseDir", ""))

	' --- output files ---
	Dim auditDir As String
	auditDir = BR_CfgDir("AuditDir", "audit")
	If Not BR_DirWritable(auditDir) Then
		BR_Msg "Audit folder is missing or not writable:" & Chr$(10) & auditDir, 16
		Exit Function
	End If
	' one folder per run, named so that dry runs and production runs cannot be mixed up:
	'   <AuditDir>\2026-10-05_093015_03-RegisterBatch_DRYRUN\
	'   <AuditDir>\2026-10-05_101500_03-RegisterBatch_LIVE-PRODUCTION\
	'   <AuditDir>\2026-10-05_090000_01-Preflight_READ-ONLY\
	gRunMode = BR_RunModeLabel(toolName)
	gRunDir = auditDir & Format$(Now, "yyyy-mm-dd_hhnnss") & "_" & BR_ToolLabel(toolName) & "_" & gRunMode & gSep
	On Error Resume Next
	MkDir Left$(gRunDir, Len(gRunDir) - 1)
	Err = 0
	On Error GoTo ErrH
	If Not BR_DirWritable(gRunDir) Then
		BR_Msg "Cannot create the run folder:" & Chr$(10) & gRunDir, 16
		Exit Function
	End If
	gDebugFile = gRunDir & "BulkReg_" & toolName & "_" & gRunMode & "_" & gRunID & "_debug.log"
	gAuditFile = gRunDir & "BulkReg_" & toolName & "_" & gRunMode & "_" & gRunID & "_audit.csv"
	Call BR_AppendLine(gRunDir & "RUN_INFO.txt", "BulkReg " & BR_VERSION & " - run information" & Chr$(13) & Chr$(10) & _
	"Agent      : " & BR_ToolLabel(toolName) & Chr$(13) & Chr$(10) & _
	"Mode       : " & gRunMode & BR_IIfStr(gRunMode = "LIVE-PRODUCTION", "   (users ARE registered)", BR_IIfStr(gRunMode = "DRYRUN", "   (simulation - nothing changed in Domino)", "")) & Chr$(13) & Chr$(10) & _
	"Run ID     : " & gRunID & Chr$(13) & Chr$(10) & _
	"Operator   : " & gOperator & Chr$(13) & Chr$(10) & _
	"Started    : " & Format$(Now, "yyyy-mm-dd hh:nn:ss") & Chr$(13) & Chr$(10) & _
	"Config     : " & CStr(cfgPath))
	Call BR_AppendLine(gAuditFile, Uchr$(&HFEFF) & BR_AuditHeader())   ' BOM so Excel reads UTF-8

	' --- central BulkReg log database (REQUIRED, guide B15) ---
	'     Every run of every agent is recorded there for all administrators and auditors.
	'     If it cannot be opened, the run stops BEFORE anything is read or changed.
	Dim logSrv As String, logDb As String, logErr As String
	logSrv = Trim$(CfgS("LogServer", ""))
	logDb = Trim$(CfgS("LogDb", ""))
	If logSrv = "" Or logDb = "" Then
		BR_Msg "LogServer and LogDb are required in " & CStr(cfgPath) & "." & Chr$(10) & _
		"Create the BulkReg log database on a server (guide B15)" & Chr$(10) & _
		"and set e.g.  LogServer=DominoAdmin/Demo  and  LogDb=bulkreg_log.nsf", 16
		Exit Function
	End If
	logErr = BR_LogOpen(logSrv, logDb, CStr(cfgPath))
	If logErr <> "" Then
		BR_Msg "Cannot open the BulkReg log database " & logSrv & "!!" & logDb & ":" & Chr$(10) & logErr & Chr$(10) & Chr$(10) & _
		"Check that it exists (guide B15) and that your ID has at least Author access with 'Create documents'." & Chr$(10) & _
		"Nothing has been read or changed.", 16
		Exit Function
	End If

	BR_Log LVL_INFO, "==== BulkReg " & BR_VERSION & " | tool=" & toolName & " | run=" & gRunID & _
	" | operator=" & gOperator & " | platform=" & gPlatform & " | config=" & CStr(cfgPath) & " ===="
	BR_Log LVL_INFO, "Central log: " & logSrv & "!!" & logDb & " | DryRun=" & CfgS("DryRun", "1") & " | audit file " & gAuditFile
	BR_DumpConfig

	If Not BR_LoadMapping(BR_CfgFile("MappingFile", "config\server_mapping.csv")) Then Exit Function
	BR_Init = True
	Exit Function
ErrH:
	BR_Msg "BR_Init failed: " & Error$ & " (err " & Err & ", line " & Erl & ")", 16
	Exit Function
End Function

'=====================================================================
' PATH + MESSAGE HELPERS (Windows)
'=====================================================================
' Accepts / or \ in config values and returns a Windows path
Function BR_Path(p As String) As String
	BR_Path = Replace(p, "/", "\")
End Function

' Folder from config (or <BaseDir>\<defSub>\), with trailing backslash
Function BR_CfgDir(k As String, defSub As String) As String
	BR_CfgDir = BR_Dir(CfgS(k, gBase & defSub))
End Function

' File path from config (or <BaseDir>\<defRel>)
Function BR_CfgFile(k As String, defRel As String) As String
	BR_CfgFile = BR_Path(CfgS(k, gBase & defRel))
End Function

' Message box for the operator (also written to the debug log)
Sub BR_Msg(txt As String, mbType As Integer)
	If gDebugFile <> "" Then Call BR_AppendLine(gDebugFile, Format$(Now, "yyyy-mm-dd hh:nn:ss") & " [MSG  ] " & Replace(txt, Chr$(10), " | "))
	Messagebox txt, mbType, "BulkReg " & gTool
End Sub

Function BR_IIfStr(c As Boolean, a As String, b As String) As String
	If c Then BR_IIfStr = a Else BR_IIfStr = b
End Function

' Agent label used in run folder names: 01-Preflight, 03-RegisterBatch ...
Function BR_ToolLabel(toolName As String) As String
	Select Case LCase$(toolName)
	Case "setuplog": BR_ToolLabel = "00-SetUpLogDatabase"
	Case "preflight": BR_ToolLabel = "01-Preflight"
	Case "buildbatch": BR_ToolLabel = "02-BuildBatch"
	Case "register": BR_ToolLabel = "03-RegisterBatch"
	Case "verify": BR_ToolLabel = "04-Verify"
	Case "exportbatchreg": BR_ToolLabel = "05-Export"
	Case Else: BR_ToolLabel = toolName
	End Select
End Function

' Mode label: only 03 - Register Batch changes Domino, so only it is DRYRUN or LIVE-PRODUCTION
Function BR_RunModeLabel(toolName As String) As String
	Select Case LCase$(toolName)
	Case "register": BR_RunModeLabel = BR_IIfStr(CfgB("DryRun", True), "DRYRUN", "LIVE-PRODUCTION")
	Case "setuplog": BR_RunModeLabel = "SETUP"
	Case "verify": BR_RunModeLabel = "VERIFY"            ' read-only, except the optional title fix it asks for
	Case Else: BR_RunModeLabel = "READ-ONLY"
	End Select
End Function

Sub BR_Close(summary As String)
	On Error Resume Next
	' run folder: finish RUN_INFO.txt and keep a copy of the batch results / dry-run report
	If gRunDir <> "" Then
		If gResultsFile <> "" Then
			If Dir$(gResultsFile) <> "" Then FileCopy gResultsFile, gRunDir & StrRightBack(gResultsFile, gSep)
		End If
		Call BR_AppendLine(gRunDir & "RUN_INFO.txt", "Batch      : " & gBatchID & Chr$(13) & Chr$(10) & _
		"Finished   : " & Format$(Now, "yyyy-mm-dd hh:nn:ss") & Chr$(13) & Chr$(10) & _
		"Result     : " & summary)
	End If
	BR_Log LVL_INFO, "==== END run " & gRunID & " | " & summary & " ===="
	Call BR_LogClose(summary)
	Set gRunDoc = Nothing
	Set gLogDb = Nothing
End Sub

'=====================================================================
' CONFIG
'=====================================================================
Function BR_LoadConfig(path As String) As Boolean
	On Error GoTo ErrH
	Dim fh As Integer, txt As String, p As Integer, k As String, v As String
	Erase gCfg
	If Dir$(path) = "" Then
		BR_Msg "Config file not found: " & path, 16
		Exit Function
	End If
	fh = FreeFile()
	Open path For Input As #fh Charset = "UTF-8"
	Do Until EOF(fh)
		Line Input #fh, txt
		txt = Trim$(Replace(txt, Uchr$(&HFEFF), ""))   ' strip BOM if present
		If Len(txt) > 0 Then
			If Left$(txt, 1) <> "#" And Left$(txt, 1) <> ";" And Left$(txt, 1) <> "[" Then
				p = InStr(txt, "=")
				If p > 1 Then
					k = LCase$(Trim$(Left$(txt, p - 1)))
					v = Trim$(Mid$(txt, p + 1))
					gCfg(k) = v
				End If
			End If
		End If
	Loop
	Close #fh
	BR_LoadConfig = True
	Exit Function
ErrH:
	On Error Resume Next
	Close #fh
	BR_Msg "Cannot read config " & path & ": " & Error$, 16
End Function

Function CfgS(k As String, def As String) As String
	If IsElement(gCfg(LCase$(k))) Then CfgS = gCfg(LCase$(k)) Else CfgS = def
End Function

Function CfgL(k As String, def As Long) As Long
	Dim s As String
	s = CfgS(k, "")
	If s = "" Or Not IsNumeric(s) Then CfgL = def Else CfgL = CLng(s)
End Function

Function CfgB(k As String, def As Boolean) As Boolean
	Dim s As String
	s = LCase$(CfgS(k, ""))
	If s = "" Then
		CfgB = def
	Else
		CfgB = (s = "1" Or s = "true" Or s = "yes" Or s = "y")
	End If
End Function

Sub BR_DumpConfig()
	' Logs the effective configuration (no secrets are kept in config by design)
	ForAll v In gCfg
		BR_Log LVL_DEBUG, "cfg " & ListTag(v) & " = " & v
	End ForAll
End Sub

'=====================================================================
' MULTI-SERVER MAPPING  (server_mapping.csv, ';' separated)
'=====================================================================
Function BR_LoadMapping(path As String) As Boolean
	On Error GoTo ErrH
	Dim fh As Integer, txt As String, parts As Variant, n As Integer
	gMapCount = 0
	ReDim gMap(0) As BRMapRule
	If path = "" Then
		BR_Log LVL_WARN, "No MappingFile configured - all users get the defaults from bulkreg.ini"
		BR_LoadMapping = True
		Exit Function
	End If
	If Dir$(path) = "" Then
		BR_Msg "Mapping file not found: " & path, 16
		Exit Function
	End If
	fh = FreeFile()
	Open path For Input As #fh Charset = "UTF-8"
	Do Until EOF(fh)
		Line Input #fh, txt
		txt = Trim$(Replace(txt, Uchr$(&HFEFF), ""))
		If txt <> "" And Left$(txt, 1) <> "#" And LCase$(Left$(txt, 10)) <> "matchfield" Then
			' a rule that still contains a <placeholder> must never be used
			If InStr(txt, "<") > 0 And InStr(txt, ">") > 0 Then
				Close #fh
				BR_Msg "server_mapping.csv still contains a <placeholder> in this rule:" & Chr$(10) & Chr$(10) & txt & Chr$(10) & Chr$(10) & _
				"Replace it with your real value (remove the < and >) or delete the rule." & Chr$(10) & path, 16
				Exit Function
			End If
			parts = Split(txt, ";")
			If UBound(parts) >= 2 Then
				ReDim Preserve gMap(gMapCount) As BRMapRule
				gMap(gMapCount).MatchField = Trim$(parts(0))
				gMap(gMapCount).MatchPattern = LCase$(Trim$(parts(1)))
				gMap(gMapCount).HomeServer = BR_Part(parts, 2)
				gMap(gMapCount).OrgUnit = BR_Part(parts, 3)
				gMap(gMapCount).Policy = BR_Part(parts, 4)
				gMap(gMapCount).Groups = BR_Part(parts, 5)
				gMap(gMapCount).VaultServer = BR_Part(parts, 6)
				gMap(gMapCount).ClusterReplicas = BR_Part(parts, 7)
				If gMap(gMapCount).MatchPattern = "" Then gMap(gMapCount).MatchPattern = "*"
				BR_Log LVL_DEBUG, "Rule #" & (gMapCount + 1) & ": IF " & gMap(gMapCount).MatchField & " LIKE '" & gMap(gMapCount).MatchPattern & "' THEN home=" & _
				gMap(gMapCount).HomeServer & " ou=" & gMap(gMapCount).OrgUnit & " policy=" & gMap(gMapCount).Policy & " groups=" & gMap(gMapCount).Groups & " vault=" & gMap(gMapCount).VaultServer & " replicas=" & BR_IIfStr(gMap(gMapCount).ClusterReplicas = "", "(auto)", gMap(gMapCount).ClusterReplicas)
				gMapCount = gMapCount + 1
			Else
				BR_Log LVL_WARN, "Mapping line ignored (needs >= 3 columns): " & txt
			End If
		End If
	Loop
	Close #fh
	BR_Log LVL_INFO, "Loaded " & gMapCount & " mapping rule(s) from " & path
	Dim hasCatchAll As Boolean, ri As Integer
	For ri = 0 To gMapCount - 1
		If gMap(ri).MatchField = "*" Then hasCatchAll = True
	Next
	If Not hasCatchAll Then BR_Log LVL_WARN, "server_mapping.csv has no catch-all rule (*;*;...) - users that match no rule get the defaults from bulkreg.ini"
	BR_LoadMapping = True
	Exit Function
ErrH:
	On Error Resume Next
	Close #fh
	BR_Msg "Cannot read mapping " & path & ": " & Error$, 16
End Function

Function BR_Part(parts As Variant, i As Integer) As String
	If UBound(parts) >= i Then BR_Part = Trim$(parts(i)) Else BR_Part = ""
End Function

' Applies defaults, then the first matching mapping rule
Sub BR_ResolveMapping(doc As NotesDocument, u As BRUser)
	Dim i As Integer, fv As String
	u.HomeServer = CfgS("DefaultHomeServer", "")
	u.OrgUnit = CfgS("DefaultOrgUnit", "")
	u.Policy = CfgS("DefaultPolicy", "")
	u.Groups = CfgS("DefaultGroups", "")
	u.VaultServer = CfgS("VaultServer", "")
	u.ClusterReplicas = ""            ' "" = automatic from MailClusterServers
	u.MapRule = "defaults"
	For i = 0 To gMapCount - 1
		If gMap(i).MatchField = "*" Then
			fv = ""
		Else
			fv = LCase$(BR_Item(doc, gMap(i).MatchField))
		End If
		If gMap(i).MatchField = "*" Or fv Like gMap(i).MatchPattern Then
			If gMap(i).HomeServer <> "" Then u.HomeServer = gMap(i).HomeServer
			' empty = keep the default;  "-" = explicitly none (e.g. rely on an organizational policy)
			If gMap(i).OrgUnit <> "" Then u.OrgUnit = gMap(i).OrgUnit
			If gMap(i).Policy <> "" Then u.Policy = gMap(i).Policy
			If gMap(i).Groups <> "" Then u.Groups = gMap(i).Groups
			If u.OrgUnit = "-" Then u.OrgUnit = ""
			If u.Policy = "-" Then u.Policy = ""
			If u.Groups = "-" Then u.Groups = ""
			If gMap(i).VaultServer <> "" Then u.VaultServer = gMap(i).VaultServer
			If gMap(i).ClusterReplicas <> "" Then u.ClusterReplicas = gMap(i).ClusterReplicas
			u.MapRule = "rule#" & (i + 1) & " " & gMap(i).MatchField & "=" & gMap(i).MatchPattern
			Exit For
		End If
	Next
	' accept CN=DominoADMail/O=Demo or DominoADMail/Demo - store the abbreviated form
	u.HomeServer = BR_SrvAbbr(u.HomeServer)
	' cluster replicas of the mail file: every OTHER member of the mail cluster (or the rule's list)
	u.ClusterReplicas = BR_ReplicaServers(u.HomeServer, u.ClusterReplicas)
End Sub

'=====================================================================
' MAIL CLUSTER  (MailClusterServers in bulkreg.ini)
'   All members of the mail cluster, e.g. 2 servers in DC + 2 in DR:
'   MailClusterServers=DominoADMail/Demo,DominoADMail2/Demo,DominoADMailDR1/Demo,DominoADMailDR2/Demo
'   - a user whose home server is a member gets a replica of the mail file on
'     every OTHER member, at the same path (e.g. mail1\smith.nsf), requested
'     through the Administration Process (AdminP "Create Replica");
'   - mail file names and numbered folders are allocated ONCE for the whole
'     cluster: a name is unique on every member, and mail1, mail2 ... hold at
'     most MailFilesPerFolder mail files on every member.
'=====================================================================
' Normalised (abbreviated, de-duplicated) server list from "a,b,c", without <exclude>
Function BR_SrvList(s As String, exclude As String) As String
	Dim parts As Variant, i As Integer, a As String, out As String, seen List As String
	If Trim$(s) = "" Or Trim$(s) = "-" Then Exit Function
	parts = Split(s, ",")
	For i = 0 To UBound(parts)
		a = BR_SrvAbbr(CStr(parts(i)))
		If a <> "" Then
			If Not IsElement(seen(LCase$(a))) Then
				If exclude = "" Or Not BR_SameServer(a, exclude) Then
					seen(LCase$(a)) = "1"
					out = out & BR_IIfStr(out = "", "", ",") & a
				End If
			End If
		End If
	Next
	BR_SrvList = out
End Function

' Number of entries in a comma separated list ("a,b,c" -> 3, "" -> 0).
' UBound needs an array VARIABLE - UBound(Split(...)) does not compile (Type mismatch).
Function BR_ListCount(s As String) As Integer
	Dim v As Variant
	If Trim$(s) = "" Then Exit Function
	v = Split(s, ",")
	BR_ListCount = UBound(v) + 1
End Function

' True when <server> is listed in MailClusterServers
Function BR_InMailCluster(server As String) As Boolean
	Dim parts As Variant, i As Integer
	If Trim$(server) = "" Or Trim$(CfgS("MailClusterServers", "")) = "" Then Exit Function
	parts = Split(CfgS("MailClusterServers", ""), ",")
	For i = 0 To UBound(parts)
		If Trim$(CStr(parts(i))) <> "" Then
			If BR_SameServer(CStr(parts(i)), server) Then
				BR_InMailCluster = True
				Exit Function
			End If
		End If
	Next
End Function

' Replica servers for a user:  spec "-" = none;  "" = all OTHER members of the
' mail cluster (when the home server is a member);  otherwise the explicit list.
Function BR_ReplicaServers(home As String, spec As String) As String
	If Trim$(spec) = "-" Then Exit Function
	If Trim$(spec) = "" Then
		If BR_InMailCluster(home) Then BR_ReplicaServers = BR_SrvList(CfgS("MailClusterServers", ""), home)
	Else
		BR_ReplicaServers = BR_SrvList(spec, home)
	End If
End Function

' Key under which mail file names and folder fill are tracked:
'   all members of the mail cluster share ONE key; other servers have their own.
Function BR_MailKey(server As String) As String
	If BR_InMailCluster(server) Then BR_MailKey = "mail cluster" Else BR_MailKey = LCase$(BR_SrvAbbr(server))
End Function

' Requests (AdminP "Create Replica") a replica of u.MailFile from u.HomeServer on
' every server in u.ClusterReplicas, same path, ACL copied.
' Returns "REQUESTED n/m" (+ failures). The replicas appear once AdminP on the
' destination servers has processed the requests - check with Agent 04.
Function BR_RequestReplicas(u As BRUser) As String
	Dim lst As Variant, i As Integer, nOk As Integer, nAll As Integer, fails As String, rid As String, dest As String
	If u.ClusterReplicas = "" Then
		BR_RequestReplicas = "NONE"
		Exit Function
	End If
	On Error GoTo ErrInit
	If gAdminP Is Nothing Then Set gAdminP = gSession.CreateAdministrationProcess(CfgS("RegistrationServer", ""))
	On Error GoTo 0
	lst = Split(u.ClusterReplicas, ",")
	For i = 0 To UBound(lst)
		dest = Trim$(CStr(lst(i)))
		If dest <> "" Then
			nAll = nAll + 1
			On Error Resume Next
			rid = gAdminP.CreateReplica(BR_SrvCanon(u.HomeServer), u.MailFile, BR_SrvCanon(dest), u.MailFile, True, CfgB("MailCreateFTIndex", False))
			If Err <> 0 Then
				fails = fails & dest & ": " & Error$ & "; "
				BR_Log LVL_ERROR, "Replica request FAILED " & u.MailFile & " -> " & dest & " : " & Error$
				Err = 0
			Else
				nOk = nOk + 1
				BR_Log LVL_INFO, "Replica requested (AdminP request " & rid & "): " & u.HomeServer & "!!" & u.MailFile & " -> " & dest
			End If
			On Error GoTo 0
		End If
	Next
	BR_RequestReplicas = "REQUESTED " & nOk & "/" & nAll & BR_IIfStr(fails <> "", " FAILED: " & fails, "")
	Exit Function
ErrInit:
	BR_RequestReplicas = "REQUEST_FAILED (cannot create AdminP request: " & Error$ & ")"
	BR_Log LVL_ERROR, "Cannot create AdminP requests on " & CfgS("RegistrationServer", "") & ": " & Error$
	Exit Function
End Function

' Checks that every server in <replicas> holds a replica (same replica ID) of
' <path> on <home>. Returns REPLICAS_OK n/n, REPLICAS_MISSING k/n (missing: ...),
' NONE (no replicas configured) or CHECK_ERROR(...).
Function BR_CheckReplicas(home As String, path As String, replicas As String) As String
	Dim src As NotesDatabase, r As NotesDatabase, rid As String, lst As Variant, i As Integer
	Dim nOk As Integer, nAll As Integer, missing As String, dest As String, found As Boolean
	If Trim$(replicas) = "" Then
		BR_CheckReplicas = "NONE"
		Exit Function
	End If
	On Error GoTo ErrH
	Set src = gSession.GetDatabase(home, path, False)
	If Not src.IsOpen Then Call src.Open("", "")
	If Not src.IsOpen Then
		BR_CheckReplicas = "CHECK_ERROR(mail file not found on home server)"
		Exit Function
	End If
	rid = src.ReplicaID
	lst = Split(replicas, ",")
	For i = 0 To UBound(lst)
		dest = Trim$(CStr(lst(i)))
		If dest <> "" Then
			nAll = nAll + 1
			found = False
			Set r = New NotesDatabase("", "")
			On Error Resume Next
			found = r.OpenByReplicaID(dest, rid)
			Err = 0
			On Error GoTo ErrH
			If found Then
				nOk = nOk + 1
				If LCase$(BR_Path(r.FilePath)) <> LCase$(BR_Path(path)) Then BR_Log LVL_WARN, "Replica of " & path & " on " & dest & " is at a different path: " & r.FilePath
			Else
				missing = missing & BR_IIfStr(missing = "", "", ", ") & dest
			End If
		End If
	Next
	If nOk = nAll Then
		BR_CheckReplicas = "REPLICAS_OK " & nOk & "/" & nAll
	Else
		BR_CheckReplicas = "REPLICAS_MISSING " & nOk & "/" & nAll & " (missing: " & missing & ")"
	End If
	Exit Function
ErrH:
	BR_CheckReplicas = "CHECK_ERROR(" & Error$ & ")"
	Exit Function
End Function

' Server (home or replica) on which u.MailFile already exists, or ""
Function BR_MailFileExistsAny(u As BRUser) As String
	Dim lst As Variant, i As Integer
	If BR_MailFileExists(u.HomeServer, u.MailFile) Then
		BR_MailFileExistsAny = u.HomeServer
		Exit Function
	End If
	If u.ClusterReplicas = "" Then Exit Function
	lst = Split(u.ClusterReplicas, ",")
	For i = 0 To UBound(lst)
		If Trim$(CStr(lst(i))) <> "" Then
			If BR_MailFileExists(Trim$(CStr(lst(i))), u.MailFile) Then
				BR_MailFileExistsAny = Trim$(CStr(lst(i)))
				Exit Function
			End If
		End If
	Next
End Function

'=====================================================================
' SERVER NAMES  - canonical (CN=DominoADMail/O=Demo) or abbreviated
'                 (DominoADMail/Demo) are both accepted everywhere
'=====================================================================
Function BR_SrvAbbr(s As String) As String
	Dim nn As NotesName
	If Trim$(s) = "" Then Exit Function
	Set nn = New NotesName(Trim$(s))
	BR_SrvAbbr = nn.Abbreviated
End Function

Function BR_SrvCanon(s As String) As String
	Dim nn As NotesName
	If Trim$(s) = "" Then Exit Function
	Set nn = New NotesName(Trim$(s))
	BR_SrvCanon = nn.Canonical
End Function

Function BR_SameServer(a As String, b As String) As Boolean
	BR_SameServer = (LCase$(BR_SrvAbbr(a)) = LCase$(BR_SrvAbbr(b)))
End Function

'=====================================================================
' DIRECTORY / CANDIDATES
'=====================================================================
Function BR_OpenDirectory() As NotesDatabase
	Dim db As NotesDatabase
	Set db = gSession.GetDatabase(CfgS("DirectoryServer", ""), CfgS("DirectoryFile", "names.nsf"), False)
	If Not db.IsOpen Then Call db.Open("", "")
	If Not db.IsOpen Then Error 2001, "Cannot open directory " & CfgS("DirectoryServer", "") & "!!" & CfgS("DirectoryFile", "names.nsf")
	BR_Log LVL_INFO, "Directory opened: " & db.Server & "!!" & db.FilePath & " (" & db.Title & ")"
	Set BR_OpenDirectory = db
End Function

' Selection rule documented for NotesRegistration.ContactNoteID:
'   Person doc HAS item objectGUID and has NO (non-empty) Certificate
Function BR_SelectionFormula(onlyUnregistered As Boolean) As String
	Dim f As String
	f = |Form = "Person" & @IsAvailable(objectGUID)|
	' {braces} delimit this string because the formula itself contains the | (OR) operator
	If onlyUnregistered Then f = f & { & (!@IsAvailable(Certificate) | @Trim(@Text(Certificate)) = "")}
	If CfgS("ExtraSelection", "") <> "" Then f = "(" & f & ") & (" & CfgS("ExtraSelection", "") & ")"
	BR_SelectionFormula = f
End Function

Function BR_GetCandidates(db As NotesDatabase, onlyUnregistered As Boolean) As NotesDocumentCollection
	Dim f As String, maxScan As Long, col As NotesDocumentCollection
	f = BR_SelectionFormula(onlyUnregistered)
	maxScan = CfgL("MaxScan", 0)
	If maxScan < 0 Or maxScan > 32767 Then maxScan = 0   ' Search() maxDocs is an Integer; 0 = no limit
	BR_Log LVL_INFO, "Search formula: " & f & "  (MaxScan=" & maxScan & ")"
	Set col = db.Search(f, Nothing, CInt(maxScan))   ' maxDocs is an Integer
	BR_Log LVL_INFO, "Documents found: " & col.Count
	If maxScan > 0 And col.Count >= maxScan Then
		BR_Log LVL_WARN, "Result hit MaxScan limit (" & maxScan & ") - more users may exist. Run again after this batch or raise MaxScan."
	End If
	Set BR_GetCandidates = col
End Function

Function BR_IsRegistered(doc As NotesDocument) As Boolean
	If Not doc.HasItem("Certificate") Then Exit Function
	BR_IsRegistered = (Trim$(doc.GetFirstItem("Certificate").Text) <> "")
End Function

' Empties every field of a BRUser (LotusScript cannot reliably assign one Type variable to another)
Sub BR_ClearUser(u As BRUser)
	u.NoteID = "": u.UNID = "": u.GUID = "": u.FullNameBefore = "": u.FullNameAfter = ""
	u.FirstName = "": u.LastName = "": u.MiddleInitial = "": u.ShortName = "": u.InternetAddress = ""
	u.MailSystemBefore = "": u.MailFileBefore = "": u.MailSystemAfter = "": u.MailFile = ""
	u.MailFileStatus = "": u.MailFileNote = "": u.HomeServer = "": u.OrgUnit = "": u.Policy = ""
	u.Groups = "": u.MapRule = "": u.IDFile = "": u.VaultStatus = "": u.VaultServer = ""
	u.ClusterReplicas = "": u.ReplicaStatus = "": u.Issues = ""
End Sub

' Reads a Person document into a BRUser and applies mapping
Sub BR_ReadUser(doc As NotesDocument, u As BRUser)
	Call BR_ClearUser(u)
	u.NoteID = doc.NoteID
	u.UNID = doc.UniversalID
	u.GUID = BR_Item(doc, "objectGUID")
	u.FullNameBefore = BR_Item(doc, "FullName")
	u.FirstName = BR_Clean(BR_Item(doc, "FirstName"))
	u.LastName = BR_Clean(BR_Item(doc, "LastName"))
	u.MiddleInitial = BR_Clean(BR_Item(doc, "MiddleInitial"))
	u.ShortName = BR_Clean(BR_Item(doc, "ShortName"))
	u.InternetAddress = BR_Clean(BR_Item(doc, "InternetAddress"))
	u.MailSystemBefore = BR_Item(doc, "MailSystem")
	u.MailFileBefore = BR_Item(doc, "MailFile")
	Call BR_ResolveMapping(doc, u)
	u.IDFile = BR_CfgDir("IDFileDir", "ids") & BR_SafeFile(u) & ".id"
	u.MailFile = BR_MailFilePath(u)
End Sub

'=====================================================================
' MAIL FILES  - every registered user gets a Domino mail file on the
'               home server: <MailFileDir>\<name>.nsf  (e.g. mail\jsmith.nsf)
'=====================================================================
' Base file name (no folder, no extension) according to MailFileNaming:
'   LASTNAME (default)     Smith            -> smith
'   FIRSTINITIAL_LASTNAME  John Smith       -> jsmith
'   SHORTNAME              ShortName jsmith -> jsmith (falls back to LASTNAME)
' Accented letters are transliterated (Müller -> mueller); only a-z 0-9 _ - are kept.
Function BR_MailBase(u As BRUser) As String
	Dim src As String, i As Integer, c As String, out As String
	Select Case UCase$(CfgS("MailFileNaming", "LASTNAME"))
	Case "SHORTNAME"
		src = u.ShortName
		If src = "" Then src = u.LastName
	Case "FIRSTINITIAL_LASTNAME"
		src = Left$(u.FirstName, 1) & u.LastName
	Case Else
		src = u.LastName
	End Select
	src = BR_Translit(LCase$(src))
	For i = 1 To Len(src)
		c = Mid$(src, i, 1)
		If c Like "[a-z0-9_-]" Then out = out & c
	Next
	If out = "" Then out = "user" & LCase$(u.NoteID)
	BR_MailBase = out
End Function

' Common Latin accents -> ASCII (input must be lower case)
Function BR_Translit(s As String) As String
	Dim r As String, i As Integer, code As Long
	For i = 1 To Len(s)
		code = Uni(Mid$(s, i, 1))
		Select Case code
		Case 224 To 227, 229: r = r & "a"
		Case 228, 230: r = r & "ae"
		Case 231: r = r & "c"
		Case 232 To 235: r = r & "e"
		Case 236 To 239: r = r & "i"
		Case 241: r = r & "n"
		Case 242 To 245, 248: r = r & "o"
		Case 246, 339: r = r & "oe"
		Case 249 To 251: r = r & "u"
		Case 252: r = r & "ue"
		Case 253, 255: r = r & "y"
		Case 223: r = r & "ss"
		Case Else: r = r & Mid$(s, i, 1)
		End Select
	Next
	BR_Translit = r
End Function

' Simple default path (used before allocation, e.g. by Preflight and Export)
Function BR_MailFilePath(u As BRUser) As String
	Dim d As String
	If UCase$(CfgS("MailFolderMode", "NUMBERED")) = "NUMBERED" Then
		d = LCase$(CfgS("MailFolderPrefix", "mail")) & "1"
	Else
		d = BR_MailSingleDir()
	End If
	If d = "" Then BR_MailFilePath = BR_MailBase(u) & ".nsf" Else BR_MailFilePath = d & "\" & BR_MailBase(u) & ".nsf"
End Function

Function BR_MailSingleDir() As String
	Dim d As String
	d = Trim$(BR_Path(CfgS("MailFileDir", "mail")))
	Do While Right$(d, 1) = "\"
		d = Left$(d, Len(d) - 1)
	Loop
	BR_MailSingleDir = LCase$(d)
End Function

'---------------------------------------------------------------------
' MAIL FILE ALLOCATION (Agent 02)  - unique names + numbered folders
'   names  List: "<server>!!<basename>" -> where it is already used
'   counts List: "<server>!!<folder>"   -> number of mail files in folder
'   scanned List: "<server>"            -> server already scanned
'---------------------------------------------------------------------
' Reads every database on the home server once and records the names and
' folder fill of all files in the mail folders: the numbered folders directly
' under the data directory (mail1, mail2 ...) and the existing mail folders
' listed in MailExistingFolders (default: mail).
' For a member of the mail cluster ALL members are scanned into one shared key,
' so a name is unique cluster-wide; a replica (same path on several members) is
' counted once per folder.
Sub BR_ScanServerMail(server As String, names List As String, counts List As Long, scanned List As String)
	Dim key As String, lst As Variant, i As Integer
	key = BR_MailKey(server)
	If key = "mail cluster" Then
		lst = Split(CfgS("MailClusterServers", ""), ",")
		For i = 0 To UBound(lst)
			If Trim$(CStr(lst(i))) <> "" Then Call BR_ScanOneServer(Trim$(CStr(lst(i))), key, names, counts, scanned)
		Next
	Else
		Call BR_ScanOneServer(server, key, names, counts, scanned)
	End If
End Sub

Sub BR_ScanOneServer(server As String, key As String, names List As String, counts List As Long, scanned List As String)
	On Error GoTo ErrH
	Dim sk As String, dbdir As NotesDbDirectory, d As NotesDatabase, fp As String
	Dim folder As String, fbase As String, n As Long
	sk = LCase$(BR_SrvAbbr(server))
	If IsElement(scanned(sk)) Then Exit Sub
	scanned(sk) = "1"
	BR_Log LVL_INFO, "Scanning mail folders on " & server & BR_IIfStr(key = "mail cluster", " (mail cluster member)", "") & " ..."
	Set dbdir = gSession.GetDbDirectory(server)
	Set d = dbdir.GetFirstDatabase(DATABASE)
	Do While Not (d Is Nothing)
		fp = LCase$(BR_Path(d.FilePath))
		If InStr(fp, "\") > 0 Then
			folder = StrLeftBack(fp, "\")
			fbase = StrRightBack(fp, "\")
		Else
			folder = ""
			fbase = fp
		End If
		If Right$(fbase, 4) = ".nsf" Then fbase = Left$(fbase, Len(fbase) - 4)
		If BR_IsMailFolder(folder) Then
			If Not IsElement(names(key & "!!" & fbase)) Then names(key & "!!" & fbase) = "file " & fp & " on " & BR_SrvAbbr(server)
			' count each path once per key (a cluster replica has the same path on every member)
			If Not IsElement(names(key & "!!path:" & fp)) Then
				names(key & "!!path:" & fp) = "1"
				If IsElement(counts(key & "!!" & folder)) Then counts(key & "!!" & folder) = counts(key & "!!" & folder) + 1 Else counts(key & "!!" & folder) = 1
			End If
			n = n + 1
		End If
		Set d = dbdir.GetNextDatabase()
	Loop
	BR_Log LVL_INFO, "  " & n & " mail databases found on " & server
	Exit Sub
ErrH:
	BR_Log LVL_WARN, "Could not scan " & server & " (" & Error$ & ") - uniqueness then relies on the directory and on direct file checks"
	Exit Sub
End Sub

' Validates the mail folder settings. Returns "" or an error text.
'   Numbered folders are <data directory>\<MailFolderPrefix><n>, e.g. Data\mail1.
'   The prefix is the name WITHOUT the number and WITHOUT any path.
Function BR_CheckMailFolderConfig() As String
	Dim p As String, e As String
	p = Trim$(CfgS("MailFolderPrefix", "mail"))
	If UCase$(CfgS("MailFolderMode", "NUMBERED")) = "NUMBERED" Then
		If p = "" Then e = e & "MailFolderPrefix is empty. Use e.g. MailFolderPrefix=mail (folders become mail1, mail2 ...)." & Chr$(10)
		If InStr(p, "\") > 0 Or InStr(p, "/") > 0 Or InStr(p, ":") > 0 Then e = e & "MailFolderPrefix='" & p & "' contains a path. The numbered folders are created DIRECTLY under the Domino data directory; use only the name, e.g. MailFolderPrefix=mail." & Chr$(10)
		If Right$(p, 1) Like "#" Then e = e & "MailFolderPrefix='" & p & "' ends with a number. Write it WITHOUT the number: MailFolderPrefix=mail gives mail1, mail2 ..." & Chr$(10)
		If CfgL("MailFilesPerFolder", 1000) < 1 Then e = e & "MailFilesPerFolder must be 1 or more (e.g. 1000)." & Chr$(10)
	End If
	Dim cl As String, nCl As Integer
	cl = BR_SrvList(CfgS("MailClusterServers", ""), "")
	If cl <> "" Then
		nCl = BR_ListCount(cl)
		If nCl < 2 Then e = e & "MailClusterServers lists only one server. List ALL members of the mail cluster (e.g. 2 in DC + 2 in DR), comma separated, or leave it empty." & Chr$(10)
		If nCl > 6 Then e = e & "MailClusterServers lists " & nCl & " servers - a Domino cluster has at most 6 members." & Chr$(10)
	End If
	If InStr(CfgS("MailClusterServers", ""), "<") > 0 Then e = e & "MailClusterServers still contains a <placeholder>." & Chr$(10)
	If InStr(CfgS("MailExistingFolders", "mail"), ":") > 0 Then e = e & "MailExistingFolders must be folder names relative to the data directory, e.g. mail" & Chr$(10)
	BR_CheckMailFolderConfig = e
End Function

' True for folders whose mail file names count for uniqueness:
'   numbered folders <prefix><n> directly under the data directory (mail1, mail2 ...),
'   folders listed in MailExistingFolders (default: mail), and MailFileDir in SINGLE mode.
Function BR_IsMailFolder(folder As String) As Boolean
	Dim f As String, p As String, rest As String, lst As Variant, i As Integer
	f = LCase$(Trim$(folder))
	If f = "" Then Exit Function
	p = LCase$(Trim$(CfgS("MailFolderPrefix", "mail")))
	If p <> "" And Left$(f, Len(p)) = p Then
		rest = Mid$(f, Len(p) + 1)
		If rest <> "" And InStr(rest, "\") = 0 Then
			If IsNumeric(rest) Then
				BR_IsMailFolder = True
				Exit Function
			End If
		End If
	End If
	lst = Split(LCase$(BR_Path(CfgS("MailExistingFolders", "mail"))), ",")
	For i = 0 To UBound(lst)
		If Trim$(lst(i)) <> "" And f = Trim$(lst(i)) Then
			BR_IsMailFolder = True
			Exit Function
		End If
	Next
	If UCase$(CfgS("MailFolderMode", "NUMBERED")) <> "NUMBERED" And f = BR_MailSingleDir() Then BR_IsMailFolder = True
End Function

' Highest folder number (mail1..mailN) needed on a server to place <users> more
' mail files, filling existing folders first. Used by Preflight for prerequisite B4.
Function BR_MailFoldersNeeded(server As String, users As Long, names List As String, counts List As Long, scanned List As String) As Integer
	Dim sk As String, prefix As String, limit As Long, k As Integer, remaining As Long, used As Long
	Call BR_ScanServerMail(server, names, counts, scanned)
	sk = BR_MailKey(server)
	prefix = LCase$(CfgS("MailFolderPrefix", "mail"))
	limit = CfgL("MailFilesPerFolder", 1000)
	If limit < 1 Then limit = 1000
	remaining = users
	k = 0
	Do While remaining > 0 Or k = 0
		k = k + 1
		used = 0
		If IsElement(counts(sk & "!!" & prefix & CStr(k))) Then used = counts(sk & "!!" & prefix & CStr(k))
		If used < limit Then remaining = remaining - (limit - used)
		If k > 999 Then Exit Do
	Loop
	BR_MailFoldersNeeded = k
End Function

' Mail files already referenced by Person documents (MailServer + MailFile)
Sub BR_ScanDirectoryMail(db As NotesDatabase, names List As String)
	On Error GoTo ErrH
	Dim col As NotesDocumentCollection, doc As NotesDocument, sk As String, fp As String, fbase As String
	Set col = db.Search(|Form = "Person" & MailFile != ""|, Nothing, 0)
	Set doc = col.GetFirstDocument()
	Do While Not (doc Is Nothing)
		sk = ""
		If BR_Item(doc, "MailServer") <> "" Then sk = BR_MailKey(BR_Item(doc, "MailServer"))
		fp = LCase$(BR_Path(BR_Item(doc, "MailFile")))
		fbase = fp
		If InStr(fbase, "\") > 0 Then fbase = StrRightBack(fbase, "\")
		If Right$(fbase, 4) = ".nsf" Then fbase = Left$(fbase, Len(fbase) - 4)
		If sk <> "" And fbase <> "" Then
			If Not IsElement(names(sk & "!!" & fbase)) Then names(sk & "!!" & fbase) = "Person doc " & BR_Item(doc, "FullName")
		End If
		Set doc = col.GetNextDocument(doc)
	Loop
	BR_Log LVL_INFO, "Directory: " & col.Count & " Person documents with a mail file read for uniqueness"
	Exit Sub
ErrH:
	BR_Log LVL_WARN, "Could not read mail files from the directory: " & Error$
	Exit Sub
End Sub

' Chooses a unique name and a folder for u (u.HomeServer must be set), reserves
' them, sets u.MailFile and u.MailFileNote. Returns "" or an "ERROR:..." issue.
Function BR_AllocMailFile(u As BRUser, names List As String, counts List As Long) As String
	Dim sk As String, base0 As String, fbase As String, n As Integer, folder As String
	Dim prefix As String, limit As Long, k As Integer, fk As String, note As String
	sk = BR_MailKey(u.HomeServer)      ' one shared key for all members of the mail cluster
	base0 = BR_MailBase(u)
	fbase = base0
	n = 1
	Do While IsElement(names(sk & "!!" & fbase))
		If UCase$(CfgS("MailFileCollision", "SUFFIX")) = "ERROR" Then
			u.MailFileNote = "name " & base0 & ".nsf already used (" & names(sk & "!!" & base0) & ")"
			BR_AllocMailFile = "ERROR:Mail file name " & base0 & ".nsf already used on " & BR_IIfStr(sk = "mail cluster", "the mail cluster", u.HomeServer) & " (" & names(sk & "!!" & base0) & "); "
			Exit Function
		End If
		n = n + 1
		fbase = base0 & CStr(n)
		If n > 999 Then
			BR_AllocMailFile = "ERROR:No free mail file name for " & base0 & "; "
			Exit Function
		End If
	Loop
	If fbase <> base0 Then note = base0 & ".nsf already used (" & names(sk & "!!" & base0) & ") -> " & fbase & ".nsf; "

	If UCase$(CfgS("MailFolderMode", "NUMBERED")) = "NUMBERED" Then
		prefix = LCase$(CfgS("MailFolderPrefix", "mail"))
		limit = CfgL("MailFilesPerFolder", 1000)
		If limit < 1 Then limit = 1000
		k = 1
		Do While IsElement(counts(sk & "!!" & prefix & CStr(k)))
			If counts(sk & "!!" & prefix & CStr(k)) < limit Then Exit Do
			k = k + 1
		Loop
		' MailFolderMax = number of folders pre-created on the servers (prerequisite B4)
		If CfgL("MailFolderMax", 0) > 0 And k > CfgL("MailFolderMax", 0) Then
			u.MailFileNote = "folders " & prefix & "1.." & prefix & CfgL("MailFolderMax", 0) & " are full"
			BR_AllocMailFile = "ERROR:All pre-created mail folders (" & prefix & "1.." & prefix & CfgL("MailFolderMax", 0) & ") on " & BR_IIfStr(sk = "mail cluster", "the mail cluster", u.HomeServer) & " are full - create " & prefix & CStr(k) & " and raise MailFolderMax; "
			Exit Function
		End If
		folder = prefix & CStr(k)
	Else
		folder = BR_MailSingleDir()
		limit = 0
	End If
	fk = sk & "!!" & folder
	If IsElement(counts(fk)) Then counts(fk) = counts(fk) + 1 Else counts(fk) = 1
	names(sk & "!!" & fbase) = "batch " & gBatchID & " (" & u.FullNameBefore & ")"
	If folder = "" Then u.MailFile = fbase & ".nsf" Else u.MailFile = folder & "\" & fbase & ".nsf"
	If limit > 0 Then
		u.MailFileNote = note & "naming " & UCase$(CfgS("MailFileNaming", "LASTNAME")) & "; folder " & folder & " " & counts(fk) & "/" & limit
	Else
		u.MailFileNote = note & "naming " & UCase$(CfgS("MailFileNaming", "LASTNAME")) & "; folder " & BR_IIfStr(folder = "", "(data directory)", folder)
	End If
End Function

' True when a database already exists at <path> on <server> (and can be opened)
Function BR_MailFileExists(server As String, path As String) As Boolean
	Dim db As NotesDatabase
	On Error GoTo ErrH
	Set db = gSession.GetDatabase(server, path, False)
	If db Is Nothing Then Exit Function
	If Not db.IsOpen Then Call db.Open("", "")
	BR_MailFileExists = db.IsOpen
	Exit Function
ErrH:
	BR_MailFileExists = False
	Exit Function
End Function

' Basic data-quality validation; returns "" when OK, otherwise issues list
Function BR_Validate(u As BRUser) As String
	Dim s As String
	If u.LastName = "" Then s = s & "ERROR:LastName missing; "
	If u.FirstName = "" Then s = s & "WARN:FirstName missing; "
	' Missing Internet address is never an ERROR:
	'   SkipNoInternetAddress=1 (default) -> SKIP: the user is left out of batches and flagged
	'     (SKIPPED_NO_INET) until the address exists in AD and DirSync has written it;
	'   SkipNoInternetAddress=0           -> WARN: the user is registered without an address.
	If u.InternetAddress = "" Then
		If CfgB("SkipNoInternetAddress", True) Then s = s & BR_SKIP_NO_INET Else s = s & BR_WARN_NO_INET
	End If
	If u.HomeServer = "" Then s = s & "ERROR:No HomeServer (mapping/default); "
	' OrgUnit is ONE plain OU name (Sales). O=Demo, OU=Sales or Sales/Demo would create a wrong
	' Notes name such as Neha Arora/O=Demo/Demo.
	If InStr(u.OrgUnit, "=") > 0 Or InStr(u.OrgUnit, "/") > 0 Or InStr(u.OrgUnit, "\") > 0 Then s = s & "ERROR:OrgUnit '" & u.OrgUnit & "' must be one plain OU name such as Sales (no O=, OU= or /); "
	If u.MailFile = "" Then
		s = s & "ERROR:No MailFile; "
	ElseIf LCase$(Right$(u.MailFile, 4)) <> ".nsf" Or InStr(u.MailFile, ":") > 0 Or Left$(u.MailFile, 1) = "\" Then
		s = s & "ERROR:MailFile must be a relative .nsf path such as mail\jsmith.nsf; "
	End If
	' Policy: EXPLICIT policy name (stored as */Name) or empty when an
	' ORGANIZATIONAL policy (*/Demo, */Sales/Demo) assigns the vault automatically.
	If u.Policy = "" Then
		If Not CfgB("OrgPolicyAssignsVault", False) Then s = s & "WARN:No explicit policy - set OrgPolicyAssignsVault=1 if an organizational policy (*/Demo or */OU/Demo) assigns the ID Vault; "
	ElseIf InStr(u.Policy, "=") > 0 Then
		s = s & "ERROR:Policy '" & u.Policy & "' looks like a server/canonical name, not a policy; "
	ElseIf Trim$(u.Policy) = "*" Then
		s = s & "ERROR:Policy '*' is the organization-wide policy - it applies automatically, leave Policy empty; "
	End If
	If u.GUID = "" Then s = s & "ERROR:objectGUID empty; "
	BR_Validate = s
End Function

'=====================================================================
' LOGGING
'=====================================================================
Function BR_LevelFromName(n As String) As Integer
	Select Case UCase$(n)
	Case "DEBUG": BR_LevelFromName = LVL_DEBUG
	Case "WARN": BR_LevelFromName = LVL_WARN
	Case "ERROR": BR_LevelFromName = LVL_ERROR
	Case Else: BR_LevelFromName = LVL_INFO
	End Select
End Function

Function BR_LevelName(l As Integer) As String
	Select Case l
	Case LVL_DEBUG: BR_LevelName = "DEBUG"
	Case LVL_WARN: BR_LevelName = "WARN "
	Case LVL_ERROR: BR_LevelName = "ERROR"
	Case Else: BR_LevelName = "INFO "
	End Select
End Function

Sub BR_Log(lvl As Integer, msg As String)
	On Error Resume Next
	Dim txt As String
	If lvl < gLogLevel Then Exit Sub
	txt = Format$(Now, "yyyy-mm-dd hh:nn:ss") & " [" & BR_LevelName(lvl) & "] " & msg
	Print txt                                    ' status bar / client console
	If gDebugFile <> "" Then Call BR_AppendLine(gDebugFile, txt)
	If Not (gLogDb Is Nothing) Then Call BR_LogEntry(lvl, msg)
End Sub

' Open-append-close per line so the audit trail survives a crash
Sub BR_AppendLine(path As String, txt As String)
	Dim fh As Integer
	fh = FreeFile()
	Open path For Append As #fh Charset = "UTF-8"
	Print #fh, txt
	Close #fh
End Sub

'=====================================================================
' NOTES NAMES  - which hierarchical name a user gets, and the check after
'                registration. Correct:  Neha Arora/Demo  or  Neha Arora/Sales/Demo
'                Wrong (old CertifierName/OrgUnit format): Neha Arora/O=Demo/Demo
'=====================================================================
' CertifierName for NotesRegistration in the form the Domino registration uses: "/Demo",
' "/Sales/Demo". Accepts O=Demo, /O=Demo, Demo, /Demo, OU=Sales/O=Demo, Sales/Demo.
Function BR_CertifierForReg() As String
	Dim s As String, nn As NotesName
	s = Trim$(CfgS("CertifierName", ""))
	If s = "" Then Exit Function
	Do While Left$(s, 1) = "/"
		s = Mid$(s, 2)
	Loop
	If InStr(s, "=") > 0 Then
		Set nn = New NotesName(s)
		s = nn.Abbreviated                  ' O=Demo -> Demo ; OU=Sales/O=Demo -> Sales/Demo
	End If
	BR_CertifierForReg = "/" & s
End Function

' Common name the registration builds from the Person document: First [Middle] Last
Function BR_CommonName(u As BRUser) As String
	Dim s As String
	s = u.FirstName
	If u.MiddleInitial <> "" Then s = s & " " & u.MiddleInitial
	BR_CommonName = Trim$(s & " " & u.LastName)
End Function

' Expected hierarchy after the common name: "/Demo" or "/Sales/Demo"
Function BR_ExpectedSuffix(ou As String) As String
	BR_ExpectedSuffix = "/" & BR_IIfStr(Trim$(ou) <> "", Trim$(ou) & "/", "") & Mid$(BR_CertifierForReg(), 2)
End Function

' Expected Notes name, abbreviated: Neha Arora/Demo
Function BR_ExpectedName(u As BRUser) As String
	BR_ExpectedName = BR_CommonName(u) & BR_ExpectedSuffix(u.OrgUnit)
End Function

' "" when the registered name has the expected hierarchy, else a description of the problem
Function BR_NameProblem(actual As String, u As BRUser) As String
	Dim a As String, sfx As String
	If Not CfgB("UseCA", True) Then Exit Function     ' certifier ID file: hierarchy comes from the ID, not checked
	a = BR_Abbr(actual)
	sfx = BR_ExpectedSuffix(u.OrgUnit)
	If InStr(a, "=") > 0 Then
		BR_NameProblem = "Notes name '" & a & "' contains '=' - expected '" & BR_ExpectedName(u) & "'"
	ElseIf LCase$(Right$(a, Len(sfx))) <> LCase$(sfx) Then
		BR_NameProblem = "Notes name '" & a & "' does not end with '" & sfx & "' - expected '" & BR_ExpectedName(u) & "'"
	ElseIf InStr(Left$(a, Len(a) - Len(sfx)), "/") > 0 Then
		BR_NameProblem = "Notes name '" & a & "' has an extra level - expected '" & BR_ExpectedName(u) & "'"
	End If
End Function

'=====================================================================
' MAIL FILE TITLE  (MailFileTitle in bulkreg.ini, default {CN} -> "Neha Arora")
'=====================================================================
Function BR_MailTitle(u As BRUser) As String
	Dim t As String, cn As String, nn As NotesName
	If u.FullNameAfter <> "" Then
		Set nn = New NotesName(u.FullNameAfter)
		cn = nn.Common
	Else
		cn = BR_CommonName(u)
	End If
	t = CfgS("MailFileTitle", "{CN}")
	t = Replace(t, "{CN}", cn)
	t = Replace(t, "{FirstName}", u.FirstName)
	t = Replace(t, "{LastName}", u.LastName)
	t = Replace(t, "{ShortName}", u.ShortName)
	t = Replace(t, "{InternetAddress}", u.InternetAddress)
	BR_MailTitle = Trim$(t)
End Function

' Sets the title of the mail file when it is empty (or always with overwrite=True).
' Returns TITLE_SET, TITLE_OK, TITLE_EMPTY (check only) or TITLE_ERROR(...).
Function BR_MailTitleFix(server As String, path As String, title As String, doSet As Boolean, overwrite As Boolean) As String
	On Error GoTo ErrH
	Dim db As NotesDatabase
	Set db = gSession.GetDatabase(server, path, False)
	If Not db.IsOpen Then Call db.Open("", "")
	If Not db.IsOpen Then
		BR_MailTitleFix = "TITLE_ERROR(mail file not found)"
		Exit Function
	End If
	If Trim$(db.Title) <> "" And Not overwrite Then
		BR_MailTitleFix = "TITLE_OK"
	ElseIf Not doSet Then
		BR_MailTitleFix = "TITLE_EMPTY"
	Else
		db.Title = title
		BR_MailTitleFix = "TITLE_SET"
	End If
	Exit Function
ErrH:
	BR_MailTitleFix = "TITLE_ERROR(" & Error$ & ")"
	Exit Function
End Function

'=====================================================================
' CENTRAL LOG DATABASE  (LogServer!!LogDb, e.g. bulkreg_log.nsf)
'   BulkReg writes its own structured documents (Form "BRLogEntry"):
'     DocType "Run"    one per agent run: start, end, status, summary
'     DocType "Entry"  one per log line (INFO / WARN / ERROR ...)
'     DocType "Audit"  one per user per action, with every audit column
'   The categorized views are created by  Actions > BulkReg > 00 - Set Up Log Database.
'   Operators need Author + Create documents; the Run document carries an
'   Authors field so the operator can close it, all other documents cannot be
'   changed by Authors afterwards.
'=====================================================================
' Opens the log database and creates the Run document. Returns "" or an error text.
Function BR_LogOpen(logSrv As String, logDb As String, cfgPath As String) As String
	On Error GoTo ErrH
	Dim it As NotesItem
	Set gLogDb = gSession.GetDatabase(logSrv, logDb, False)
	If Not gLogDb.IsOpen Then Call gLogDb.Open("", "")
	If Not gLogDb.IsOpen Then
		BR_LogOpen = "database not found or no access"
		Set gLogDb = Nothing
		Exit Function
	End If
	gRunTitle = Format$(Now, "yyyy-mm-dd hh:nn") & "  " & BR_ToolLabel(gTool) & "  " & gRunMode & "  " & BR_Abbr(gOperator)
	Set gRunDoc = BR_LogNewDoc("Run")
	Call gRunDoc.ReplaceItemValue("Status", "RUNNING")
	Call gRunDoc.ReplaceItemValue("StartTime", Now)
	Call gRunDoc.ReplaceItemValue("Config", cfgPath)
	Call gRunDoc.ReplaceItemValue("Platform", gPlatform)
	Call gRunDoc.ReplaceItemValue("Summary", "")
	Set it = gRunDoc.ReplaceItemValue("DocAuthors", gOperator)   ' lets the operator (Author) close the run
	it.IsAuthors = True
	Call gRunDoc.Save(True, False)
	Exit Function
ErrH:
	BR_LogOpen = Error$ & " (err " & Err & ")"
	Set gRunDoc = Nothing
	Set gLogDb = Nothing
	Exit Function
End Function

' New log document with the fields every log document has
Function BR_LogNewDoc(docType As String) As NotesDocument
	Dim d As NotesDocument
	Set d = gLogDb.CreateDocument()
	Call d.ReplaceItemValue("Form", "BRLogEntry")
	Call d.ReplaceItemValue("DocType", docType)
	Call d.ReplaceItemValue("RunID", gRunID)
	Call d.ReplaceItemValue("RunTitle", gRunTitle)
	Call d.ReplaceItemValue("Tool", gTool)
	Call d.ReplaceItemValue("Operator", gOperator)
	Call d.ReplaceItemValue("DryRun", CfgS("DryRun", "1"))
	Call d.ReplaceItemValue("RunMode", gRunMode)
	Call d.ReplaceItemValue("RunFolder", gRunDir)
	Call d.ReplaceItemValue("BatchID", gBatchID)
	Call d.ReplaceItemValue("Version", BR_VERSION)
	Call d.ReplaceItemValue("LogTime", Now)
	Call d.ReplaceItemValue("Day", Format$(Now, "yyyy-mm-dd"))
	Call d.ReplaceItemValue("TimeText", Format$(Now, "hh:nn:ss"))
	Set BR_LogNewDoc = d
End Function

' One log line -> Entry document (failures never stop the run)
Sub BR_LogEntry(lvl As Integer, msg As String)
	On Error GoTo ErrH
	Dim d As NotesDocument
	If gLogDb Is Nothing Then Exit Sub
	Set d = BR_LogNewDoc("Entry")
	Call d.ReplaceItemValue("Level", Trim$(BR_LevelName(lvl)))
	Call d.ReplaceItemValue("Message", msg)
	Call d.Save(True, False)
	Exit Sub
ErrH:
	BR_LogWriteFailed Error$
	Exit Sub
End Sub

' One audit row -> Audit document with every audit column as a field
Sub BR_LogAudit(u As BRUser, mode As String, action As String, result As String, dur As Double, msg As String)
	On Error GoTo ErrH
	Dim d As NotesDocument
	If gLogDb Is Nothing Then Exit Sub
	Set d = BR_LogNewDoc("Audit")
	Call d.ReplaceItemValue("Mode", mode)
	Call d.ReplaceItemValue("Action", action)
	Call d.ReplaceItemValue("Result", result)
	Call d.ReplaceItemValue("Level", BR_IIfStr(InStr(result, "FAIL") > 0 Or result = "ERROR", "ERROR", BR_IIfStr(InStr(result, "SKIP") > 0 Or InStr(result, "PENDING") > 0 Or result = "WARN" Or result = "NOT_PROCESSED", "WARN", "INFO")))
	Call d.ReplaceItemValue("DurationSec", dur)
	Call d.ReplaceItemValue("FullName", BR_IIfStr(u.FullNameAfter <> "", u.FullNameAfter, u.FullNameBefore))
	Call d.ReplaceItemValue("FullNameBefore", u.FullNameBefore)
	Call d.ReplaceItemValue("FullNameAfter", u.FullNameAfter)
	Call d.ReplaceItemValue("InternetAddress", u.InternetAddress)
	Call d.ReplaceItemValue("ShortName", u.ShortName)
	Call d.ReplaceItemValue("NoteIDPerson", u.NoteID)
	Call d.ReplaceItemValue("UNIDPerson", u.UNID)
	Call d.ReplaceItemValue("objectGUID", u.GUID)
	Call d.ReplaceItemValue("HomeServer", u.HomeServer)
	Call d.ReplaceItemValue("OrgUnit", u.OrgUnit)
	Call d.ReplaceItemValue("Policy", u.Policy)
	Call d.ReplaceItemValue("MapRule", u.MapRule)
	Call d.ReplaceItemValue("MailFile", u.MailFile)
	Call d.ReplaceItemValue("MailFileStatus", u.MailFileStatus)
	Call d.ReplaceItemValue("MailFileNote", u.MailFileNote)
	Call d.ReplaceItemValue("VaultStatus", u.VaultStatus)
	Call d.ReplaceItemValue("ClusterReplicas", u.ClusterReplicas)
	Call d.ReplaceItemValue("ReplicaStatus", u.ReplicaStatus)
	Call d.ReplaceItemValue("Message", msg)
	Call d.Save(True, False)
	Exit Sub
ErrH:
	BR_LogWriteFailed Error$
	Exit Sub
End Sub

' Closes the Run document (end time, status, summary)
Sub BR_LogClose(summary As String)
	On Error GoTo ErrH
	If gRunDoc Is Nothing Then Exit Sub
	Call gRunDoc.ReplaceItemValue("EndTime", Now)
	Call gRunDoc.ReplaceItemValue("BatchID", gBatchID)
	Call gRunDoc.ReplaceItemValue("Summary", summary)
	If InStr(summary, "ABORTED") > 0 Then
		Call gRunDoc.ReplaceItemValue("Status", "ABORTED")
	ElseIf InStr(LCase$(summary), "cancel") > 0 Or InStr(summary, "Not approved") > 0 Then
		Call gRunDoc.ReplaceItemValue("Status", "CANCELLED")
	Else
		Call gRunDoc.ReplaceItemValue("Status", "FINISHED")
	End If
	Call gRunDoc.ReplaceItemValue("LogWriteErrors", gLogWriteErr)
	Call gRunDoc.Save(True, False)
	Exit Sub
ErrH:
	Print "BulkReg: could not close the run document in the log database: " & Error$
	Exit Sub
End Sub

' A failed write to the log database is reported in the debug log (max. 5 times)
Sub BR_LogWriteFailed(e As String)
	gLogWriteErr = gLogWriteErr + 1
	If gLogWriteErr <= 5 And gDebugFile <> "" Then
		Call BR_AppendLine(gDebugFile, Format$(Now, "yyyy-mm-dd hh:nn:ss") & " [WARN ] could not write to the log database: " & e)
	End If
End Sub

Function BR_Abbr(n As String) As String
	Dim nn As NotesName
	If Trim$(n) = "" Then Exit Function
	Set nn = New NotesName(n)
	BR_Abbr = nn.Abbreviated
End Function

'=====================================================================
' AUDIT CSV  (one row per user per action - never contains passwords)
'=====================================================================
Function BR_AuditHeader() As String
	BR_AuditHeader = "RunID,Timestamp,Tool,Operator,Mode,Action,Result,DurationSec,NoteID,UNID,objectGUID," & _
	"FullNameBefore,FullNameAfter,InternetAddress,ShortName,HomeServer,OrgUnit,Policy,MapRule," & _
	"MailSystemBefore,MailSystemAfter,VaultStatus,IDFile,Message,BatchID,MailFile,MailFileStatus,MailFileNote,ClusterReplicas,ReplicaStatus"
End Function

Sub BR_Audit(u As BRUser, mode As String, action As String, result As String, dur As Double, msg As String)
	On Error GoTo ErrH
	Dim r As String
	r = Q(gRunID) & "," & Q(Format$(Now, "yyyy-mm-dd hh:nn:ss")) & "," & Q(gTool) & "," & Q(gOperator) & "," & _
	Q(mode) & "," & Q(action) & "," & Q(result) & "," & Q(Format$(dur, "0.00")) & "," & _
	Q(u.NoteID) & "," & Q(u.UNID) & "," & Q(u.GUID) & "," & Q(u.FullNameBefore) & "," & Q(u.FullNameAfter) & "," & _
	Q(u.InternetAddress) & "," & Q(u.ShortName) & "," & Q(u.HomeServer) & "," & Q(u.OrgUnit) & "," & Q(u.Policy) & "," & _
	Q(u.MapRule) & "," & Q(u.MailSystemBefore) & "," & Q(u.MailSystemAfter) & "," & Q(u.VaultStatus) & "," & _
	Q(u.IDFile) & "," & Q(msg) & "," & Q(gBatchID) & "," & Q(u.MailFile) & "," & Q(u.MailFileStatus) & "," & Q(u.MailFileNote) & "," & Q(u.ClusterReplicas) & "," & Q(u.ReplicaStatus)
	Call BR_AppendLine(gAuditFile, r)
	If gResultsFile <> "" Then Call BR_AppendLine(gResultsFile, r)
	' same row as a structured Audit document in the central log database
	If Not (gLogDb Is Nothing) Then Call BR_LogAudit(u, mode, action, result, dur, msg)
	Exit Sub
ErrH:
	Print "BulkReg: audit write failed: " & Error$
	Exit Sub
End Sub

Function Q(v As String) As String
	Dim s As String
	s = Replace(Replace(v, Chr$(13), " "), Chr$(10), " ")
	Q = """" & Replace(s, """", """""") & """"
End Function

'=====================================================================
' ID VAULT
'=====================================================================
Function BR_VaultStatus(fullName As String, vaultServer As String) As String
	On Error GoTo ErrH
	Dim vault As NotesIDVault
	If vaultServer = "" Then
		BR_VaultStatus = "NOT_CHECKED(no VaultServer)"
		Exit Function
	End If
	Set vault = gSession.GetIDVault()
	' HCL syntax: IsIDInVault(username, servername)
	If vault.IsIDInVault(fullName, vaultServer) Then
		BR_VaultStatus = "IN_VAULT"
	Else
		BR_VaultStatus = "NOT_IN_VAULT"
	End If
	Exit Function
ErrH:
	BR_VaultStatus = "CHECK_ERROR(" & Err & ": " & Error$ & ")"
	Exit Function
End Function

'=====================================================================
' HELPERS
'=====================================================================
Function BR_Item(doc As NotesDocument, itemName As String) As String
	On Error GoTo ErrH
	Dim v As Variant
	If Not doc.HasItem(itemName) Then Exit Function
	v = doc.GetItemValue(itemName)
	If IsArray(v) Then BR_Item = Trim$(CStr(v(0))) Else BR_Item = Trim$(CStr(v))
	Exit Function
ErrH:
	BR_Item = ""
	Exit Function
End Function

' Removes characters that break the registration text file / names
Function BR_Clean(s As String) As String
	BR_Clean = Trim$(Replace(Replace(Replace(s, ";", " "), Chr$(13), ""), Chr$(10), ""))
End Function

' Normalises a folder for the current OS and guarantees a trailing separator
Function BR_Dir(p As String) As String
	Dim s As String
	If p = "" Then Exit Function
	s = BR_Path(p)
	If Right$(s, 1) = gSep Then BR_Dir = s Else BR_Dir = s & gSep
End Function

Function BR_DirWritable(p As String) As Boolean
	On Error GoTo ErrH
	Dim t As String, fh As Integer
	t = p & "bulkreg_write_test_" & gRunID & ".tmp"
	fh = FreeFile()
	Open t For Output As #fh
	Print #fh, "test"
	Close #fh
	Kill t                                  ' removes only our own temp test file
	BR_DirWritable = True
	Exit Function
ErrH:
	BR_DirWritable = False
	Exit Function
End Function

' Unique, file-system-safe ID file base name
Function BR_SafeFile(u As BRUser) As String
	Dim src As String, i As Integer, c As String, out As String
	If u.ShortName <> "" Then src = u.ShortName Else src = u.FirstName & "_" & u.LastName
	For i = 1 To Len(src)
		c = Mid$(src, i, 1)
		If c Like "[A-Za-z0-9_.-]" Then out = out & c
	Next
	If out = "" Then out = "user"
	BR_SafeFile = out & "_" & u.NoteID
End Function

' Random initial password (upper/lower/digit/symbol).
' NOTE: LotusScript Rnd is NOT a cryptographic RNG. Users must change the
' password at first use (enforce via Security policy password settings).
Function BR_GenPassword(n As Integer) As String
	Const UPP = "ABCDEFGHJKLMNPQRSTUVWXYZ"
	Const LOW = "abcdefghijkmnopqrstuvwxyz"
	Const DIG = "23456789"
	Const SYM = "!#%+-=?@"           ' no ';' (text-file separator) or quotes
	Dim all As String, pw As String, i As Integer, j As Integer, tmp As String
	If n < 12 Then n = 12
	all = UPP & LOW & DIG & SYM
	pw = BR_Pick(UPP) & BR_Pick(LOW) & BR_Pick(DIG) & BR_Pick(SYM)
	For i = 5 To n
		pw = pw & BR_Pick(all)
	Next
	For i = Len(pw) To 2 Step -1     ' Fisher-Yates shuffle
		j = Int(Rnd() * i) + 1
		tmp = Mid$(pw, i, 1)
		Mid$(pw, i, 1) = Mid$(pw, j, 1)
		Mid$(pw, j, 1) = tmp
	Next
	BR_GenPassword = pw
End Function

Function BR_Pick(s As String) As String
	BR_Pick = Mid$(s, Int(Rnd() * Len(s)) + 1, 1)
End Function

Function BR_Elapsed(t0 As Double) As Double
	Dim t As Double
	t = Timer - t0
	If t < 0 Then t = t + 86400#     ' midnight wrap
	BR_Elapsed = t
End Function

Function BR_ServerReachable(server As String) As Boolean
	On Error GoTo ErrH
	Dim db As NotesDatabase
	Set db = gSession.GetDatabase(server, "names.nsf", False)
	If Not db.IsOpen Then Call db.Open("", "")
	BR_ServerReachable = db.IsOpen
	Exit Function
ErrH:
	BR_ServerReachable = False
	Exit Function
End Function

'=====================================================================
' BATCH FILES  (reviewed batch workflow: 02 Build -> review -> 03 Register)
'=====================================================================
' A batch file  <BatchDir>\BATCH-<yyyymmdd-hhnnss>.csv  lists exactly the users
' Agent 03 may register. State of a batch is derived from files next to it:
'   OPEN    no _results.csv yet  (users in it are not offered to a new batch)
'   DONE    BATCH-<id>_results.csv exists (written by a LIVE run)
' A dry run writes BATCH-<id>_dryrun.csv and leaves the batch OPEN.


Function BR_BatchDir() As String
	BR_BatchDir = BR_CfgDir("BatchDir", "batches")
End Function

' Splits one CSV line; handles "quoted" fields, doubled quotes and the
' delimiter inside quotes. Returns a 0-based string array.
Function BR_CsvSplit(lineTxt As String, delim As String) As Variant
	Dim out() As String, n As Integer, i As Long, c As String, cur As String, inQ As Boolean
	ReDim out(0) As String
	For i = 1 To Len(lineTxt)
		c = Mid$(lineTxt, i, 1)
		If inQ Then
			If c = """" Then
				If Mid$(lineTxt, i + 1, 1) = """" Then
					cur = cur & """"
					i = i + 1
				Else
					inQ = False
				End If
			Else
				cur = cur & c
			End If
		ElseIf c = """" Then
			inQ = True
		ElseIf c = delim Then
			ReDim Preserve out(n) As String
			out(n) = cur
			n = n + 1
			cur = ""
		Else
			cur = cur & c
		End If
	Next
	ReDim Preserve out(n) As String
	out(n) = cur
	BR_CsvSplit = out
End Function

' Header -> column index list (lower-case names). Detects , or ; (Excel locales).
Function BR_CsvHeader(headerTxt As String, delim As String, cols List As Integer) As Integer
	Dim parts As Variant, i As Integer, h As String
	h = Replace(headerTxt, Uchr$(&HFEFF), "")
	If InStr(h, ",") = 0 And InStr(h, ";") > 0 Then delim = ";" Else delim = ","
	parts = BR_CsvSplit(h, delim)
	Erase cols
	For i = 0 To UBound(parts)
		cols(LCase$(Trim$(parts(i)))) = i
	Next
	BR_CsvHeader = UBound(parts) + 1
End Function

Function BR_CsvGet(parts As Variant, cols List As Integer, colName As String) As String
	Dim k As String
	k = LCase$(colName)
	If Not IsElement(cols(k)) Then Exit Function
	If cols(k) > UBound(parts) Then Exit Function
	BR_CsvGet = Trim$(CStr(parts(cols(k))))
End Function

' NoteIDs listed (Include=Y) in batch files that are still OPEN -> excluded
' from new batches so one user is never in two pending batches.
Sub BR_OpenBatchNoteIDs(ids List As String, names List As String, counts List As Long)
	On Error GoTo ErrH
	Dim d As String, f As String, files List As String, fh As Integer, txt As String
	Dim cols List As Integer, delim As String, parts As Variant, isFirst As Boolean
	Dim sk As String, mfp As String, fbase As String, folder As String
	d = BR_BatchDir()
	f = Dir$(d & "BATCH-*.csv")
	Do While f <> ""
		If InStr(f, "_") = 0 Then files(f) = f      ' only the batch file itself
		f = Dir$()
	Loop
	ForAll bf In files
		If Dir$(d & Left$(bf, Len(bf) - 4) & "_results.csv") = "" Then
			fh = FreeFile()
			Open d & bf For Input As #fh Charset = "UTF-8"
			isFirst = True
			Do Until EOF(fh)
				Line Input #fh, txt
				If isFirst Then
					Call BR_CsvHeader(txt, delim, cols)
					isFirst = False
				ElseIf Trim$(txt) <> "" Then
					parts = BR_CsvSplit(txt, delim)
					If UCase$(BR_CsvGet(parts, cols, "Include")) = "Y" Then
						ids(BR_CsvGet(parts, cols, "NoteID")) = CStr(bf)
						' reserve this open batch's mail file name and folder slot
						sk = ""
						If BR_CsvGet(parts, cols, "HomeServer") <> "" Then sk = BR_MailKey(BR_CsvGet(parts, cols, "HomeServer"))
						mfp = LCase$(BR_Path(BR_CsvGet(parts, cols, "MailFile")))
						If sk <> "" And mfp <> "" Then
							folder = ""
							fbase = mfp
							If InStr(mfp, "\") > 0 Then
								folder = StrLeftBack(mfp, "\")
								fbase = StrRightBack(mfp, "\")
							End If
							If Right$(fbase, 4) = ".nsf" Then fbase = Left$(fbase, Len(fbase) - 4)
							If Not IsElement(names(sk & "!!" & fbase)) Then names(sk & "!!" & fbase) = "open " & CStr(bf)
							If IsElement(counts(sk & "!!" & folder)) Then counts(sk & "!!" & folder) = counts(sk & "!!" & folder) + 1 Else counts(sk & "!!" & folder) = 1
						End If
					End If
				End If
			Loop
			Close #fh
		End If
	End ForAll
	Exit Sub
ErrH:
	BR_Log LVL_WARN, "Could not read open batch files in " & d & ": " & Error$
	On Error Resume Next
	Close #fh
	Exit Sub
End Sub

' Newest OPEN batch file (full path) or "" if none
Function BR_NewestOpenBatch() As String
	Dim d As String, f As String, best As String, files List As String
	d = BR_BatchDir()
	f = Dir$(d & "BATCH-*.csv")
	Do While f <> ""                       ' collect first: Dir$ cannot be nested
		If InStr(f, "_") = 0 Then files(f) = f
		f = Dir$()
	Loop
	ForAll bf In files
		If Dir$(d & Left$(bf, Len(bf) - 4) & "_results.csv") = "" Then
			If bf > best Then best = bf
		End If
	End ForAll
	If best <> "" Then BR_NewestOpenBatch = d & best
End Function

' Server reachability (home or replica server), checked once per server per run
Function BR_HomeServerOK(server As String, cache List As String) As Boolean
	Dim k As String
	k = LCase$(server)
	If Not IsElement(cache(k)) Then
		If BR_ServerReachable(server) Then cache(k) = "OK" Else cache(k) = "UNREACHABLE"
		BR_Log LVL_INFO, "Server " & server & ": " & cache(k)
	End If
	BR_HomeServerOK = (cache(k) = "OK")
End Function
