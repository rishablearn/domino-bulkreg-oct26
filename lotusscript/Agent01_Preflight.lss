'=====================================================================
' Agent name : BulkReg\01 - Preflight Check   (READ-ONLY - changes nothing)
'              (backslash = Actions > BulkReg submenu; do NOT use '|' - it is the alias separator)
' Version    : 3.2.7  (BulkReg release; library BulkRegCommon 3.2.7)
' Trigger    : Action menu selection, Target: None
'              (Windows Domino Administrator client only)
' Options    : Option Public / Option Declare / Use "BulkRegCommon"
'
' Checks environment + every DirSync candidate and writes
'   <AuditDir>\BulkReg_Preflight_<run>_audit.csv   (per-user status)
'   <AuditDir>\BulkReg_Preflight_<run>_debug.log
'   <AuditDir>\BulkReg_Preflight_<run>_mapping.txt      (users per mapping rule)
'   <AuditDir>\BulkReg_Preflight_<run>_mailfolders.txt  (folders to create, per server)
'=====================================================================
'#####################################################################
' ### STEP A: paste the 3 lines below into (Options)
'#####################################################################
Option Public
Option Declare
Use "BulkRegCommon"

'#####################################################################
' ### STEP C: select Initialize and REPLACE its content with the block below
' ###         (from 'Sub Initialize' to its 'End Sub').
'#####################################################################
Sub Initialize
	On Error GoTo ErrH
	Dim db As NotesDatabase, col As NotesDocumentCollection, doc As NotesDocument
	Dim u As BRUser, issues As String, res As String
	Dim nOK As Long, nWarn As Long, nErr As Long, envErr As Long, envWarn As Long
	Dim seenShort List As String, seenMail List As String
	Dim servers List As String, usersView As NotesView, dupCol As NotesDocumentCollection
	Dim t0 As Double, srvCount List As Long, hk As String, srvText As String
	Dim ruleCount List As Long, mapFile As String, ri As Integer, rk As String
	Dim rl As Variant, rj As Integer, repCount List As Long

	If Not BR_Init("Preflight") Then Exit Sub

	' ---------- 1. Environment checks ----------
	BR_Log LVL_INFO, "--- Environment checks ---"
	envErr = envErr + BR_Check(CfgS("RegistrationServer", "") <> "", "RegistrationServer configured")
	envErr = envErr + BR_Check(BR_ServerReachable(CfgS("RegistrationServer", "")), "Registration server reachable: " & CfgS("RegistrationServer", ""))
	envErr = envErr + BR_Check(BR_DirWritable(BR_CfgDir("IDFileDir", "ids")), "IDFileDir exists + writable: " & BR_CfgDir("IDFileDir", "ids"))
	If CfgB("WritePasswordFile", True) Then
		envErr = envErr + BR_Check(BR_DirWritable(BR_CfgDir("PasswordDir", "secure")), "PasswordDir exists + writable: " & BR_CfgDir("PasswordDir", "secure"))
	End If
	If CfgB("UseCA", True) Then
		envErr = envErr + BR_Check(CfgS("CertifierName", "") <> "", "CertifierName set (UseCA=1): " & CfgS("CertifierName", ""))
	Else
		envErr = envErr + BR_Check(Dir$(BR_CfgFile("CertifierIDFile", "cert" & gSep & "none.id")) <> "", "Certifier ID file exists: " & BR_CfgFile("CertifierIDFile", ""))
	End If
	If CfgS("VaultServer", "") <> "" Then
		envWarn = envWarn + BR_Check(BR_ServerReachable(CfgS("VaultServer", "")), "Vault server reachable: " & CfgS("VaultServer", ""))
	Else
		BR_Log LVL_WARN, "VaultServer not set - vault verification will be skipped"
		envWarn = envWarn + 1
	End If
	If CfgS("DefaultPolicy", "") = "" Then
		BR_Log LVL_WARN, "DefaultPolicy empty - make sure an explicit/organizational policy assigns the ID Vault"
		envWarn = envWarn + 1
	End If
	' mail cluster: every member must be reachable (replicas are created there by AdminP)
	If BR_SrvList(CfgS("MailClusterServers", ""), "") <> "" Then
		BR_Log LVL_INFO, "Mail cluster: " & BR_SrvList(CfgS("MailClusterServers", ""), "") & " | CreateClusterReplicas=" & CfgS("CreateClusterReplicas", "1")
		rl = Split(BR_SrvList(CfgS("MailClusterServers", ""), ""), ",")
		For rj = 0 To UBound(rl)
			envWarn = envWarn + BR_Check(BR_ServerReachable(CStr(rl(rj))), "Mail cluster member reachable: " & rl(rj))
		Next
		' AdminP "Check access": the requester (your admin ID) needs at least Reader access to each new mail file
		If CfgB("CreateClusterReplicas", True) And Trim$(CfgS("MailACLManager", "")) = "" Then
			BR_Log LVL_WARN, "CreateClusterReplicas=1 but MailACLManager is empty - set it to a group that contains your admin ID (e.g. LocalDomainAdmins), otherwise AdminP may refuse the Create Replica requests (guide B4)"
			envWarn = envWarn + 1
		End If
	Else
		BR_Log LVL_INFO, "MailClusterServers empty - no mail cluster: mail files get no replicas unless a mapping rule lists ClusterReplicas"
	End If
	' tool database bulkreg.nsf: meant to be LOCAL on the admin workstation (guide B13)
	Dim toolDb As NotesDatabase
	Set toolDb = gSession.CurrentDatabase
	If Not (toolDb Is Nothing) Then
		If toolDb.Server = "" Then
			BR_Log LVL_INFO, "PASS  Tool database is local: " & toolDb.FilePath
		Else
			BR_Log LVL_WARN, "Tool database runs from server " & toolDb.Server & "!!" & toolDb.FilePath & " - BulkReg is designed for a LOCAL bulkreg.nsf (guide B13)"
			envWarn = envWarn + 1
		End If
	End If
	' central log database on the server: Author + Create documents; Editor/Delete weaken the audit trail (guide B15)
	Dim logDbObj As NotesDatabase, accLvl As Integer, accPriv As Long
	On Error Resume Next
	Set logDbObj = gSession.GetDatabase(CfgS("LogServer", ""), CfgS("LogDb", ""), False)
	If Not logDbObj.IsOpen Then Call logDbObj.Open("", "")     ' CurrentAccessLevel needs an open database
	accLvl = logDbObj.CurrentAccessLevel
	accPriv = logDbObj.QueryAccessPrivileges(gOperator)
	If Err <> 0 Then
		BR_Log LVL_WARN, "Could not read your access to the log database: " & Error$
		envWarn = envWarn + 1
		Err = 0
	Else
		BR_Log LVL_INFO, "Log database " & CfgS("LogServer", "") & "!!" & CfgS("LogDb", "") & ": your access level " & accLvl & " (3 = Author, 4 = Editor), privileges " & accPriv
		envErr = envErr + BR_Check(accLvl >= ACLLEVEL_AUTHOR And (accLvl > ACLLEVEL_AUTHOR Or (accPriv And DBACL_CREATE_DOCUMENTS) <> 0), "Log database: Author with Create documents (or higher)")
		If accLvl > ACLLEVEL_AUTHOR Or (accPriv And DBACL_DELETE_DOCUMENTS) <> 0 Then
			BR_Log LVL_WARN, "Log database: you have " & BR_IIf(accLvl > ACLLEVEL_AUTHOR, "Editor or higher", "Delete documents") & " access - for a tamper-resistant audit trail use Author, Create documents, without Delete documents (guide B15)"
			envWarn = envWarn + 1
		End If
	End If
	On Error GoTo ErrH
	If CfgB("DryRun", True) Then BR_Log LVL_INFO, "DryRun=1 (safe mode) is set"
	BR_Log LVL_INFO, "Client platform " & gPlatform & " | operator " & gOperator

	Set db = BR_OpenDirectory()
	Set usersView = db.GetView("($Users)")

	' ---------- 2. Candidate checks ----------
	BR_Log LVL_INFO, "--- Candidate checks (objectGUID present, not yet registered) ---"
	Set col = BR_GetCandidates(db, True)
	Set doc = col.GetFirstDocument()
	Do While Not (doc Is Nothing)
		t0 = Timer
		Call BR_ReadUser(doc, u)
		issues = BR_Validate(u)

		' duplicates inside this batch
		If u.ShortName <> "" Then
			If IsElement(seenShort(LCase$(u.ShortName))) Then issues = issues & "ERROR:Duplicate ShortName in batch (" & seenShort(LCase$(u.ShortName)) & "); " Else seenShort(LCase$(u.ShortName)) = u.NoteID
		End If
		If u.InternetAddress <> "" Then
			If IsElement(seenMail(LCase$(u.InternetAddress))) Then issues = issues & "ERROR:Duplicate InternetAddress in batch; " Else seenMail(LCase$(u.InternetAddress)) = u.NoteID
			' duplicates against the whole directory
			If Not (usersView Is Nothing) Then
				Set dupCol = usersView.GetAllDocumentsByKey(u.InternetAddress, True)
				If dupCol.Count > 1 Then issues = issues & "WARN:InternetAddress used by " & dupCol.Count & " directory entries; "
			End If
		End If

		' home server reachability (checked once per server)
		If u.HomeServer <> "" Then
			If Not IsElement(servers(LCase$(u.HomeServer))) Then
				If BR_ServerReachable(u.HomeServer) Then servers(LCase$(u.HomeServer)) = "OK" Else servers(LCase$(u.HomeServer)) = "UNREACHABLE"
				BR_Log LVL_INFO, "Home server " & u.HomeServer & ": " & servers(LCase$(u.HomeServer))
			End If
			If servers(LCase$(u.HomeServer)) <> "OK" Then issues = issues & "ERROR:HomeServer unreachable; "
		End If
		' replica servers (other mail cluster members or the rule's list)
		If u.ClusterReplicas <> "" Then
			rl = Split(u.ClusterReplicas, ",")
			For rj = 0 To UBound(rl)
				If Not IsElement(servers(LCase$(CStr(rl(rj))))) Then
					If BR_ServerReachable(CStr(rl(rj))) Then servers(LCase$(CStr(rl(rj)))) = "OK" Else servers(LCase$(CStr(rl(rj)))) = "UNREACHABLE"
					BR_Log LVL_INFO, "Replica server " & rl(rj) & ": " & servers(LCase$(CStr(rl(rj))))
				End If
				If servers(LCase$(CStr(rl(rj)))) <> "OK" Then issues = issues & "WARN:Replica server " & rl(rj) & " unreachable; "
			Next
		End If
		hk = BR_IIf(u.HomeServer = "", "(none)", u.HomeServer) & " -> replicas: " & BR_IIf(u.ClusterReplicas = "", "none", u.ClusterReplicas)
		If IsElement(repCount(hk)) Then repCount(hk) = repCount(hk) + 1 Else repCount(hk) = 1

		' how many users each mapping rule catches (mapping test, written to _mapping.txt)
		If IsElement(ruleCount(u.MapRule)) Then ruleCount(u.MapRule) = ruleCount(u.MapRule) + 1 Else ruleCount(u.MapRule) = 1
		hk = u.HomeServer
		If hk = "" Then hk = "(none)"
		If IsElement(srvCount(hk)) Then srvCount(hk) = srvCount(hk) + 1 Else srvCount(hk) = 1
		If InStr(issues, "ERROR:") > 0 Then
			res = "ERROR": nErr = nErr + 1
		ElseIf InStr(issues, "WARN:") > 0 Then
			res = "WARN": nWarn = nWarn + 1
		Else
			res = "OK": nOK = nOK + 1
		End If
		BR_Log LVL_DEBUG, res & " " & u.FullNameBefore & " -> " & u.HomeServer & " / OU=" & u.OrgUnit & " / " & u.Policy & " | " & issues
		Call BR_Audit(u, "PREFLIGHT", "CHECK", res, BR_Elapsed(t0), issues)
		Set doc = col.GetNextDocument(doc)
	Loop

	' ---------- mapping test: users per rule ----------
	mapFile = BR_CfgDir("AuditDir", "audit") & "BulkReg_Preflight_" & gRunID & "_mapping.txt"
	Call BR_AppendLine(mapFile, "BulkReg " & BR_VERSION & " - mapping test (which rule each candidate matched)")
	Call BR_AppendLine(mapFile, "Mapping file: " & BR_CfgFile("MappingFile", "config\server_mapping.csv"))
	Call BR_AppendLine(mapFile, "Rules are checked top-down; the first match wins. Per-user detail: MapRule column of " & gAuditFile)
	Call BR_AppendLine(mapFile, "")
	For ri = 0 To gMapCount - 1
		rk = "rule#" & (ri + 1) & " " & gMap(ri).MatchField & "=" & gMap(ri).MatchPattern
		If IsElement(ruleCount(rk)) Then
			Call BR_AppendLine(mapFile, "Rule " & (ri + 1) & " : " & ruleCount(rk) & " users  | IF " & gMap(ri).MatchField & " matches '" & gMap(ri).MatchPattern & "'")
		Else
			Call BR_AppendLine(mapFile, "Rule " & (ri + 1) & " : 0 users  | IF " & gMap(ri).MatchField & " matches '" & gMap(ri).MatchPattern & "'   <-- matched nobody: check field name and pattern")
		End If
		Call BR_AppendLine(mapFile, "          THEN HomeServer=" & BR_IIf(gMap(ri).HomeServer = "", "(default " & CfgS("DefaultHomeServer", "") & ")", gMap(ri).HomeServer) & _
		"  OrgUnit=" & BR_IIf(gMap(ri).OrgUnit = "", "(default)", gMap(ri).OrgUnit) & "  Policy=" & BR_IIf(gMap(ri).Policy = "", "(default)", gMap(ri).Policy) & _
		"  Groups=" & BR_IIf(gMap(ri).Groups = "", "(default)", gMap(ri).Groups) & "  VaultServer=" & BR_IIf(gMap(ri).VaultServer = "", "(default)", gMap(ri).VaultServer) & _
		"  ClusterReplicas=" & BR_IIf(gMap(ri).ClusterReplicas = "", "(auto: other mail cluster members)", BR_IIf(gMap(ri).ClusterReplicas = "-", "(none)", gMap(ri).ClusterReplicas)))
	Next
	If IsElement(ruleCount("defaults")) Then Call BR_AppendLine(mapFile, "No rule matched: " & ruleCount("defaults") & " users -> all defaults from bulkreg.ini")
	Call BR_AppendLine(mapFile, "")
	Call BR_AppendLine(mapFile, "Result per home server (users -> where the mail file replicas will be created):")
	ForAll rc In repCount
		Call BR_AppendLine(mapFile, "  " & ListTag(rc) & " : " & rc & " users")
	End ForAll

	' ---------- mail folders to pre-create (prerequisite B4) ----------
	' Members of the mail cluster share ONE set of folders (every member holds every
	' mail file: the primary on the home server, replicas on the others), so the
	' users of all home servers in the cluster are added up.
	Dim mfNames List As String, mfCounts List As Long, mfScanned List As String
	Dim need As Integer, fldFile As String, prefix As String, fmax As Long
	Dim keyUsers List As Long, keyRep List As String, keyHomes List As String, mk As String, onSrv As String
	prefix = LCase$(CfgS("MailFolderPrefix", "mail"))
	fmax = CfgL("MailFolderMax", 0)
	fldFile = BR_CfgDir("AuditDir", "audit") & "BulkReg_Preflight_" & gRunID & "_mailfolders.txt"
	ForAll c In srvCount
		srvText = srvText & "   " & ListTag(c) & " : " & c & Chr$(10)
		BR_Log LVL_INFO, "Candidates for home server " & ListTag(c) & " : " & c
		If ListTag(c) <> "(none)" Then
			mk = BR_MailKey(ListTag(c))
			If IsElement(keyUsers(mk)) Then keyUsers(mk) = keyUsers(mk) + c Else keyUsers(mk) = c
			keyRep(mk) = ListTag(c)
			If IsElement(keyHomes(mk)) Then keyHomes(mk) = keyHomes(mk) & ", " & ListTag(c) & " (" & c & ")" Else keyHomes(mk) = ListTag(c) & " (" & c & ")"
		End If
	End ForAll
	If UCase$(CfgS("MailFolderMode", "NUMBERED")) = "NUMBERED" Then
		Call BR_AppendLine(fldFile, "BulkReg " & BR_VERSION & " - mail folders to create (" & CfgL("MailFilesPerFolder", 1000) & " mail files per folder)")
		Call BR_AppendLine(fldFile, "Create them directly under the Domino DATA directory of EVERY server listed, BEFORE the first batch (guide B4).")
		Call BR_AppendLine(fldFile, "")
		srvText = srvText & Chr$(10) & "Mail folders to create:" & Chr$(10)
		ForAll ku In keyUsers
			mk = ListTag(ku)
			need = BR_MailFoldersNeeded(keyRep(mk), CLng(ku), mfNames, mfCounts, mfScanned)
			If mk = "mail cluster" Then onSrv = BR_SrvList(CfgS("MailClusterServers", ""), "") Else onSrv = keyRep(mk)
			Call BR_AppendLine(fldFile, BR_IIf(mk = "mail cluster", "MAIL CLUSTER", "SERVER " & keyRep(mk)) & " : " & ku & " new users (home servers: " & keyHomes(mk) & ")")
			Call BR_AppendLine(fldFile, "  folders " & prefix & "1 .. " & prefix & need & "   on: " & onSrv)
			Call BR_AppendLine(fldFile, "  Windows server (PowerShell):  1.." & need & " | % { New-Item -ItemType Directory -Force ""<DataDir>\" & prefix & "$_"" }")
			Call BR_AppendLine(fldFile, "  Linux server (as root):       for i in $(seq 1 " & need & "); do mkdir -p <DataDir>/" & prefix & "$i; done; chown <notes>:<notes> <DataDir>/" & prefix & "*")
			Call BR_AppendLine(fldFile, "")
			srvText = srvText & "   " & prefix & "1.." & prefix & need & " on " & onSrv & Chr$(10)
			BR_Log LVL_INFO, "Mail folders needed: " & prefix & "1.." & prefix & need & " on " & onSrv & " (" & ku & " users)"
			If fmax > 0 And need > fmax Then
				BR_Log LVL_WARN, "MailFolderMax=" & fmax & " but " & need & " folders are needed on " & onSrv & " - create them and raise MailFolderMax"
				srvText = srvText & "   (MailFolderMax=" & fmax & " too low!)" & Chr$(10)
				envWarn = envWarn + 1
			End If
		End ForAll
	End If
	Dim summary As String
	summary = "Environment errors=" & envErr & " warnings=" & envWarn & _
	" | Candidates=" & col.Count & " OK=" & nOK & " WARN=" & nWarn & " ERROR=" & nErr
	BR_Close summary
	BR_Msg summary & Chr$(10) & Chr$(10) & "Candidates per home server:" & Chr$(10) & srvText & Chr$(10) & "Mapping test: " & mapFile & Chr$(10) & BR_IIf(UCase$(CfgS("MailFolderMode", "NUMBERED")) = "NUMBERED", "Mail folders to create: " & fldFile & Chr$(10), "") & "Audit: " & gAuditFile & Chr$(10) & "Log: " & gDebugFile, _
	CInt(BR_IIf(envErr + nErr > 0, 48, 64))
	Exit Sub
ErrH:
	BR_Log LVL_ERROR, "Preflight aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	BR_Close "ABORTED"
	BR_Msg "Preflight aborted: " & Error$, 16
	Exit Sub
End Sub
'#####################################################################
' ### STEP D: paste everything from here to the END of the file directly
' ###         below 'End Sub' of Initialize. Designer creates one entry per
' ###         Function / Sub automatically.
'#####################################################################

' Logs PASS/FAIL, returns 1 on failure
Function BR_Check(ok As Boolean, what As String) As Integer
	If ok Then
		BR_Log LVL_INFO, "PASS  " & what
	Else
		BR_Log LVL_ERROR, "FAIL  " & what
		BR_Check = 1
	End If
End Function

Function BR_IIf(c As Boolean, a As Variant, b As Variant) As Variant
	If c Then BR_IIf = a Else BR_IIf = b
End Function
