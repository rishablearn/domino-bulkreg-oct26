'=====================================================================
' Agent      : 03 | Bulk Register DirSync Users (ID -> ID Vault)
' Trigger    : Action menu selection, Target: None
'              (Windows Domino Administrator client only)
' Options    : Option Public / Option Declare / Use "BulkRegCommon"
'
' Method     : NotesRegistration.ContactNoteID  (HCL Domino Designer 14.5)
'              "Used to register users who have existing Person documents
'               created by syncing Active Directory users into the Domino
'               directory." Doc must have item objectGUID and NO Certificate.
'              The existing DirSync Person document is upgraded in place.
'
' ID Vault   : The ID is deposited by the explicit policy (PolicyName) whose
'              Security Settings assign the ID Vault. Verified afterwards with
'              NotesIDVault.IsIDInVault.
'
' Safety     : DryRun (default ON), typed REGISTER confirmation, BatchSize,
'              MaxConsecutiveErrors circuit-breaker, idempotent
'              (re-checks Certificate before every registration), per-user
'              error isolation, audit row for every user/action.
'=====================================================================
Option Public
Option Declare
Use "BulkRegCommon"

Dim gCertPwd As String
Dim gPwFile As String
Dim gMode As String

Sub Initialize
	On Error GoTo ErrH
	Dim db As NotesDatabase, col As NotesDocumentCollection, doc As NotesDocument
	Dim ids() As String, nIds As Long, i As Long
	Dim batch As Long, pauseMs As Long, maxConsec As Long
	Dim nDone As Long, nOK As Long, nFail As Long, nSkip As Long, nConsec As Long
	Dim res As String, stopReason As String

	If Not BR_Init("Register") Then Exit Sub
	If CfgB("DryRun", True) Then gMode = "DRYRUN" Else gMode = "LIVE"
	batch = CfgL("BatchSize", 25)
	pauseMs = CfgL("PauseMs", 500)
	maxConsec = CfgL("MaxConsecutiveErrors", 5)

	' ---------- collect candidate NoteIDs first (stable list) ----------
	Set db = BR_OpenDirectory()
	Set col = BR_GetCandidates(db, True)
	If col.Count = 0 Then
		BR_Close "No candidates"
		BR_Msg "No unregistered DirSync users match the selection.", 64
		Exit Sub
	End If
	ReDim ids(col.Count - 1) As String
	Set doc = col.GetFirstDocument()
	Do While Not (doc Is Nothing)
		ids(nIds) = doc.NoteID
		nIds = nIds + 1
		Set doc = col.GetNextDocument(doc)
	Loop
	Set col = Nothing

	' ---------- confirmations (Yes/No, typed REGISTER, certifier password) ----------
	If Not ConfirmRun(nIds, batch) Then Exit Sub

	If gMode = "LIVE" And CfgB("WritePasswordFile", True) Then
		gPwFile = BR_CfgDir("PasswordDir", "secure") & "BulkReg_InitialPasswords_" & gRunID & ".csv"
		Call BR_AppendLine(gPwFile, Uchr$(&HFEFF) & "RunID,FullName,InternetAddress,IDFile,InitialPassword")
		BR_Log LVL_INFO, "Initial passwords will be written to the restricted file: " & gPwFile
	End If

	' ---------- main loop ----------
	For i = 0 To nIds - 1
		If nDone >= batch Then
			stopReason = "BatchSize reached (" & batch & ")"
			Exit For
		End If
		res = RegisterOne(db, ids(i))
		Select Case Left$(res, 2)
		Case "OK"
			nOK = nOK + 1: nConsec = 0: nDone = nDone + 1
		Case "SK"
			nSkip = nSkip + 1
		Case Else
			nFail = nFail + 1: nConsec = nConsec + 1: nDone = nDone + 1
		End Select
		Print "BulkReg " & gMode & ": " & (i + 1) & "/" & nIds & "  ok=" & nOK & " fail=" & nFail & " skip=" & nSkip
		If nConsec >= maxConsec Then
			stopReason = "Circuit breaker: " & nConsec & " consecutive failures - check debug log"
			BR_Log LVL_ERROR, stopReason
			Exit For
		End If
		If pauseMs > 0 Then Sleep pauseMs / 1000
	Next
	If stopReason = "" Then stopReason = "All candidates processed"

	gCertPwd = ""      ' clear secret from memory
	Dim summary As String
	summary = gMode & " | candidates=" & nIds & " processed=" & nDone & " ok=" & nOK & _
	" failed=" & nFail & " skipped=" & nSkip & " | " & stopReason
	BR_Close summary
	BR_Msg summary & Chr$(10) & Chr$(10) & "Audit: " & gAuditFile & Chr$(10) & "Log: " & gDebugFile & _
	BR_IIfS(gPwFile <> "", Chr$(10) & "Passwords (restricted): " & gPwFile, ""), _
	CInt(BR_IIfS(nFail > 0, 48, 64))
	Exit Sub
ErrH:
	gCertPwd = ""
	BR_Log LVL_ERROR, "Run aborted: " & Error$ & " (err " & Err & ", line " & Erl & ")"
	BR_Close "ABORTED"
	BR_Msg "Run aborted: " & Error$ & Chr$(10) & "See " & gDebugFile, 16
	Exit Sub
End Sub

'---------------------------------------------------------------------
' Operator confirmation.
'  Yes/No summary, typed REGISTER for LIVE, masked certifier password
'  when UseCA=0. Windows Domino Administrator client only.
'---------------------------------------------------------------------
Function ConfirmRun(nIds As Long, batch As Long) As Boolean
	Dim ws As NotesUIWorkspace, ans As Variant
	Set ws = New NotesUIWorkspace
	ans = ws.Prompt(PROMPT_YESNO, "BulkReg - " & gMode, _
	"Mode: " & gMode & Chr$(10) & _
	"Candidates found: " & nIds & Chr$(10) & _
	"This run will process up to: " & batch & Chr$(10) & _
	"Registration server: " & CfgS("RegistrationServer", "") & Chr$(10) & _
	"Certification: " & BR_CertText() & Chr$(10) & _
	"Default policy: " & CfgS("DefaultPolicy", "") & Chr$(10) & _
	"Vault check server: " & CfgS("VaultServer", "") & Chr$(10) & Chr$(10) & "Continue?")
	If ans <> 1 Then
		BR_Close "Cancelled by operator"
		Exit Function
	End If
	If gMode = "LIVE" Then
		ans = ws.Prompt(PROMPT_OKCANCELEDIT, "BulkReg - LIVE confirmation", _
		"LIVE mode will create Notes IDs for up to " & batch & " users." & Chr$(10) & _
		"Type REGISTER to continue:", "")
		If IsEmpty(ans) Then ans = ""
		If CStr(ans) <> "REGISTER" Then
			BR_Log LVL_WARN, "LIVE run not confirmed - aborted by operator"
			BR_Close "Not confirmed"
			Exit Function
		End If
		If Not CfgB("UseCA", True) Then
			ans = ws.Prompt(PROMPT_PASSWORD, "BulkReg", "Certifier ID password for " & BR_CfgFile("CertifierIDFile", "") & ":")
			If IsEmpty(ans) Then ans = ""
			gCertPwd = CStr(ans)
			If gCertPwd = "" Then
				BR_Close "No certifier password"
				Exit Function
			End If
		End If
	End If
	ConfirmRun = True
End Function

'---------------------------------------------------------------------
' Registers ONE user. Returns "OK...", "SKIP..." or "FAIL...".
' Every outcome writes an audit row. Errors never stop the batch.
'---------------------------------------------------------------------
Function RegisterOne(db As NotesDatabase, noteID As String) As String
	Dim doc As NotesDocument, reg As NotesRegistration, u As BRUser
	Dim t0 As Double, issues As String, userPwd As String, mailFile As String
	Dim stage As String, emsg As String
	t0 = Timer
	On Error GoTo ErrH

	stage = "load"
	Set doc = db.GetDocumentByID(noteID)
	If doc Is Nothing Then
		u.NoteID = noteID
		Call BR_Audit(u, gMode, "REGISTER", "SKIPPED", BR_Elapsed(t0), "Document no longer exists")
		RegisterOne = "SKIP:gone"
		Exit Function
	End If
	Call BR_ReadUser(doc, u)

	' idempotency: fresh re-check (someone may have registered it meanwhile)
	If BR_IsRegistered(doc) Then
		Call BR_Audit(u, gMode, "REGISTER", "SKIPPED", BR_Elapsed(t0), "Already has Certificate (registered)")
		BR_Log LVL_INFO, "SKIP already registered: " & u.FullNameBefore
		RegisterOne = "SKIP:registered"
		Exit Function
	End If

	stage = "validate"
	issues = BR_Validate(u)
	If InStr(issues, "ERROR:") > 0 Then
		Call BR_Audit(u, gMode, "REGISTER", "FAILED_VALIDATION", BR_Elapsed(t0), issues)
		BR_Log LVL_ERROR, "VALIDATION " & u.FullNameBefore & " : " & issues
		RegisterOne = "FAIL:validation"
		Exit Function
	End If

	BR_Log LVL_DEBUG, "Prepared " & u.FullNameBefore & " noteid=" & u.NoteID & " guid=" & u.GUID & _
	" home=" & u.HomeServer & " ou=" & u.OrgUnit & " policy=" & u.Policy & " groups=" & u.Groups & _
	" map=" & u.MapRule & " mailsys=" & u.MailSystemBefore & " idfile=" & u.IDFile

	If gMode = "DRYRUN" Then
		Call BR_Audit(u, gMode, "REGISTER", "WOULD_REGISTER", BR_Elapsed(t0), issues)
		BR_Log LVL_INFO, "DRYRUN would register " & u.FullNameBefore & " -> " & u.HomeServer & " (" & u.Policy & ")"
		RegisterOne = "OK:dryrun"
		Exit Function
	End If

	' ---------- build registration ----------
	stage = "configure"
	Set reg = New NotesRegistration
	reg.ContactNoteID = u.NoteID                       ' register the existing DirSync Person doc
	reg.RegistrationServer = CfgS("RegistrationServer", "")
	If CfgB("UseCA", True) Then
		reg.UseCertificateAuthority = True
		reg.CertifierName = CfgS("CertifierName", "")
	Else
		reg.CertifierIDFile = BR_CfgFile("CertifierIDFile", "")
	End If
	reg.CreateMailDb = CfgB("CreateMailDb", False)
	reg.Expiration = Today + CfgL("ExpirationDays", 730)
	reg.IDType = ID_HIERARCHICAL
	reg.MinPasswordLength = CInt(CfgL("MinPasswordLength", 8))
	reg.IsNorthAmerican = CfgB("IsNorthAmerican", True)
	reg.OrgUnit = u.OrgUnit
	reg.RegistrationLog = CfgS("RegistrationLog", "log.nsf")
	reg.UpdateAddressBook = True
	reg.StoreIDInAddressBook = CfgB("StoreIDInAddressBook", False)
	reg.EnforceUniqueShortName = CfgB("EnforceUniqueShortName", True)
	reg.SynchInternetPassword = CfgB("SyncInternetPassword", False)
	If u.Policy <> "" Then reg.PolicyName = u.Policy
	If u.ShortName <> "" Then reg.ShortName = u.ShortName
	If u.InternetAddress <> "" Then reg.MailInternetAddress = u.InternetAddress
	If u.Groups <> "" Then reg.GroupList = Split(u.Groups, ",")

	' never overwrite an ID file left by an earlier (failed) attempt
	If Dir$(u.IDFile) <> "" Then
		BR_Log LVL_WARN, "ID file exists from a previous attempt, using new name: " & u.IDFile
		u.IDFile = Left$(u.IDFile, Len(u.IDFile) - 3) & "_" & gRunID & ".id"
	End If

	If reg.CreateMailDb Then mailFile = "mail" & gSep & BR_SafeFile(u) & ".nsf" Else mailFile = ""
	userPwd = BR_GenPassword(CInt(CfgL("InitialPasswordLength", 16)))

	' ---------- register ----------
	stage = "RegisterNewUser"
	BR_Log LVL_INFO, "REGISTER " & u.FullNameBefore & " -> " & u.HomeServer
	Call reg.RegisterNewUser(u.LastName, u.IDFile, u.HomeServer, u.FirstName, u.MiddleInitial, _
	gCertPwd, "", "BulkReg " & gRunID & " objectGUID=" & u.GUID, mailFile, "", userPwd, NOTES_DESKTOP_CLIENT)

	' ---------- verify ----------
	stage = "verify"
	Delete doc
	Set doc = db.GetDocumentByID(noteID)
	If doc Is Nothing Then Error 4001, "Person document not found after registration"
	u.FullNameAfter = BR_Item(doc, "FullName")
	u.MailSystemAfter = BR_Item(doc, "MailSystem")
	If Not BR_IsRegistered(doc) Then Error 4002, "RegisterNewUser returned but Person doc has no Certificate"

	' keep the account as 'Other Internet Mail' / no mail file if requested
	stage = "preserveMail"
	If CfgB("PreserveMailSystem", True) And Not reg.CreateMailDb Then
		If u.MailSystemAfter <> u.MailSystemBefore Or (u.MailFileBefore = "" And BR_Item(doc, "MailFile") <> "") Then
			Call doc.ReplaceItemValue("MailSystem", u.MailSystemBefore)
			If u.MailFileBefore = "" Then Call doc.ReplaceItemValue("MailFile", "")
			Call doc.Save(True, False)
			BR_Log LVL_INFO, "Restored MailSystem '" & u.MailSystemAfter & "' -> '" & u.MailSystemBefore & "' for " & u.FullNameAfter
			u.MailSystemAfter = u.MailSystemBefore
		End If
	End If

	stage = "vault"
	If CfgB("VaultCheckAfterReg", True) Then u.VaultStatus = BR_VaultStatus(u.FullNameAfter) Else u.VaultStatus = "NOT_CHECKED"

	If gPwFile <> "" Then
		Call BR_AppendLine(gPwFile, Q(gRunID) & "," & Q(u.FullNameAfter) & "," & Q(u.InternetAddress) & "," & Q(u.IDFile) & "," & Q(userPwd))
	End If
	userPwd = ""

	If u.VaultStatus = "IN_VAULT" Or u.VaultStatus = "NOT_CHECKED" Then
		Call BR_Audit(u, gMode, "REGISTER", "REGISTERED", BR_Elapsed(t0), issues)
		BR_Log LVL_INFO, "OK " & u.FullNameAfter & " vault=" & u.VaultStatus & " (" & Format$(BR_Elapsed(t0), "0.0") & "s)"
	Else
		Call BR_Audit(u, gMode, "REGISTER", "REGISTERED_VAULT_PENDING", BR_Elapsed(t0), issues & " Vault: " & u.VaultStatus & " - re-check with Agent 04")
		BR_Log LVL_WARN, "REGISTERED but vault=" & u.VaultStatus & " : " & u.FullNameAfter & " (check policy/ID Vault; re-run Agent 04)"
	End If
	RegisterOne = "OK"
	Exit Function

ErrH:
	userPwd = ""
	emsg = "stage=" & stage & " err=" & Err & " " & Error$ & " (line " & Erl & ")"
	BR_Log LVL_ERROR, "FAIL " & u.FullNameBefore & " : " & emsg
	Call BR_Audit(u, gMode, "REGISTER", "FAILED", BR_Elapsed(t0), emsg)
	RegisterOne = "FAIL:" & stage
	Exit Function
End Function

Function BR_CertText() As String
	If CfgB("UseCA", True) Then
		BR_CertText = "Domino CA - " & CfgS("CertifierName", "")
	Else
		BR_CertText = "Certifier ID - " & CfgS("CertifierIDFile", "")
	End If
End Function

Function BR_IIfS(c As Boolean, a As Variant, b As Variant) As Variant
	If c Then BR_IIfS = a Else BR_IIfS = b
End Function
